   <title>Pagination</title>
   <shortdesc>This section describes the process of accessing paginated results.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>continuation</keyword>
        <keyword>paginated</keyword>
        <keyword>results</keyword>
        <keyword>Pagination</keyword>
