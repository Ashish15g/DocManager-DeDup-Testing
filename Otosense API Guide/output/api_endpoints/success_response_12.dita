<concept id="success_response_12" xml:lang="en-us">
   <title>Success Response</title>
   <shortdesc>"sensorId": "VA000343Y",</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>sensor</keyword>
        <keyword>motor</keyword>
        <keyword>attached</keyword>
        <keyword>string</keyword>
        <keyword>window</keyword>
        <keyword>provisioned</keyword>
        <indexterm>sensor</indexterm>
        <indexterm>motor</indexterm>
        <indexterm>attached</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody>
      <ul id="ul_104927111">
         <li>
            <b>Code:</b> 200 OK</li>
         <li>Headers:</li>
      </ul>
      <table frame="all" colsep="1" rowsep="1">
         <tgroup cols="3">
            <colspec colname="c1"/>
            <colspec colname="c2"/>
            <colspec colname="c3"/>
            <tbody>
               <row>
                  <entry>
                     <b>Header</b>
                  </entry>
                  <entry>
                     <b>Type</b>
                  </entry>
                  <entry>
                     <b>Description</b>
                  </entry>
               </row>
               <row>
                  <entry>X-RateLimit-Limit</entry>
                  <entry>string</entry>
                  <entry>Request limit details in the following form: {quota};window={time-window}. quota: the request quota. time-window: the quota time window in seconds.</entry>
               </row>
               <row>
                  <entry>X-RateLimit-Remaining</entry>
                  <entry>integer</entry>
                  <entry>The number of requests left for the time window.</entry>
               </row>
               <row>
                  <entry>X-RateLimit-Reset</entry>
                  <entry>integer</entry>
                  <entry>The time in seconds from now at which point the current rate limit window resets.</entry>
               </row>
            </tbody>
         </tgroup>
      </table>
      <ul id="ul_104927112">
         <li>
            <b>Content-Type:</b> application/json</li>
         <li>Schema:</li>
      </ul>
      <table frame="all" colsep="1" rowsep="1">
         <tgroup cols="4">
            <colspec colname="c1"/>
            <colspec colname="c2"/>
            <colspec colname="c3"/>
            <colspec colname="c4"/>
            <tbody>
               <row>
                  <entry>
                     <b>Schema</b>
                  </entry>
                  <entry>
                     <b>Key</b>
                  </entry>
                  <entry>
                     <b>Type</b>
                  </entry>
                  <entry>
                     <b>Description</b>
                  </entry>
               </row>
               <row>
                  <entry>sensorId</entry>
                  <entry>N/A</entry>
                  <entry>string</entry>
                  <entry>Unique identifier for this sensor. The unique ID assigned to a sensor can be found in the get all motor sensors response.</entry>
               </row>
               <row>
                  <entry>attached</entry>
                  <entry>N/A</entry>
                  <entry>string &lt;date-time&gt;</entry>
                  <entry>undefined if sensor is not attached to a motor otherwise, the date and time this sensor was attached to this motor.</entry>
               </row>
               <row>
                  <entry>attachedBy</entry>
                  <entry>N/A</entry>
                  <entry>string</entry>
                  <entry>undefined if sensor is not attached to a motor otherwise, the principal (i.e. email) that attached this sensor to this motor.</entry>
               </row>
               <row>
                  <entry namest="c1" nameend="c4">
                     <b>attributes</b>
                     <b>(Object configuration)</b>
                  </entry>
               </row>
               <row>
                  <entry/>
                  <entry>motorId</entry>
                  <entry>string</entry>
                  <entry>undefined if sensor is not attached to a motor otherwise, the motor ID this sensor is attached to.</entry>
               </row>
               <row>
                  <entry/>
                  <entry>motorName</entry>
                  <entry>string</entry>
                  <entry>undefined if sensor is not attached to a motor otherwise, the motor tag or friendly name of the motor to which this sensor is attached.</entry>
               </row>
               <row>
                  <entry>provisioned</entry>
                  <entry>N/A</entry>
                  <entry>string &lt;date-time&gt;</entry>
                  <entry>Date and time this sensor was provisioned.</entry>
               </row>
               <row>
                  <entry>provisionedBy</entry>
                  <entry>N/A</entry>
                  <entry>string</entry>
                  <entry>Principal (i.e. email) who provisioned this sensor.</entry>
               </row>
               <row>
                  <entry>lastConnected</entry>
                  <entry>N/A</entry>
                  <entry>string &lt;date-time&gt;</entry>
                  <entry>null if sensor has never been connected otherwise, the date and time this sensor last connected to the ADI OtoSense™ SMS Service.</entry>
               </row>
               <row>
                  <entry>hardwareVersion</entry>
                  <entry>N/A</entry>
                  <entry>string</entry>
                  <entry>Version of the hardware.</entry>
               </row>
               <row>
                  <entry>firmwareVersion</entry>
                  <entry>N/A</entry>
                  <entry>string</entry>
                  <entry>Current version of the firmware.</entry>
               </row>
            </tbody>
         </tgroup>
      </table>
      <ul id="ul_104927113">
         <li>Sample Success Code:</li>
         <li>Sample Request: https://your-api-endpoint.otosensesms.com/motors/{motorId}/sensors/{sensorId}</li>
