                  <entry>
                     <b>Type</b>
                  </entry>
                  <entry>
                     <b>Description</b>
                  </entry>
               </row>
               <row>
                  <entry>X-RateLimit-Limit</entry>
                  <entry>string</entry>
                  <entry>Request limit details in the following form: {quota};window={time-window}. quota: the request quota. time-window: the quota time window in seconds.</entry>
               </row>
               <row>
                  <entry>X-RateLimit-Remaining</entry>
                  <entry>integer</entry>
                  <entry>The number of requests left for the time window.</entry>
               </row>
               <row>
                  <entry>X-RateLimit-Reset</entry>
                  <entry>integer</entry>
                  <entry>The time in seconds from now at which point the current rate limit window resets.</entry>
               </row>
            </tbody>
         </tgroup>
      </table>
      <ul id="ul_104927138">
