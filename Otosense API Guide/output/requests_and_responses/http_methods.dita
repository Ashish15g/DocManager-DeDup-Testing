      <section id="sec_d995e7">
         <p>This section describes the HTTP methods.</p>
         <table frame="all" colsep="1" rowsep="1">
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <tbody>
                  <row>
                     <entry>
                        <b>Method Name</b>
                     </entry>
                     <entry>
                        <b>Description</b>
                     </entry>
                  </row>
                  <row>
                     <entry>GET</entry>
                     <entry>Gets a list of resources or an individual resource</entry>
                  </row>
                  <row>
                     <entry>POST</entry>
                     <entry>Creates a resource or operates on a resource</entry>
                  </row>
                  <row>
                     <entry>PUT</entry>
                     <entry>Updates an individual resource</entry>
                  </row>
                  <row>
                     <entry>DEL</entry>
                     <entry>Removes a list of resources or an individual resource</entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
