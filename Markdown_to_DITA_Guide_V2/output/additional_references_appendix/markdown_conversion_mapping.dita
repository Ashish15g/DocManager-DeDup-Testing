   <title>Markdown conversion mapping</title>
   <shortdesc>The markdown folder structure converts to the DITA map or book map in the following</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>folder</keyword>
        <keyword>DITA</keyword>
        <keyword>Markdown</keyword>
        <keyword>conversion</keyword>
        <keyword>mapping</keyword>
        <keyword>index</keyword>
        <indexterm>folder</indexterm>
        <indexterm>DITA</indexterm>
        <indexterm>Markdown</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
