<reference id="_Toc238560412" xml:lang="en-us">
   <title>Scenario 1: Inline code phrase</title>
   <shortdesc>Consider a paragraph containing a command name.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>phrase</keyword>
        <keyword>Inline</keyword>
        <keyword>Scenario</keyword>
        <keyword>paragraph</keyword>
        <keyword>DITA</keyword>
        <keyword>Create</keyword>
        <indexterm>phrase</indexterm>
        <indexterm>Inline</indexterm>
        <indexterm>Scenario</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>  <section>
    <p>Consider a paragraph containing a command name.</p><table frame="all" colsep="1" rowsep="1">
            <title>Inline code phrase</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
              <thead>
                <row>
                  <entry> .md input </entry>
                  <entry> DITA output </entry>
                </row>                
              </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>&gt; **Tip**
  &gt;
  &gt; Create notification templates to reduce configuration time.</codeblock>
                     </entry>
                     <entry>
                        <codeblock>&lt;note type="tip"&gt;
  Create notification templates to reduce configuration time.
  &lt;/note&gt;</codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table><p>
            <b>Result:</b> The converter converts the inline code phrase into a DITA <codeph>&lt;codeph&gt;</codeph> element while preserving the surrounding paragraph text.</p>
  </section></refbody>
</reference>
