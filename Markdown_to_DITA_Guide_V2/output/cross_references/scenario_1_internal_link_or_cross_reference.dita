<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="_Toc238560404" xml:lang="en-us">
   <title>Scenario 1: Internal link or cross reference</title>
   <shortdesc>Consider a .md file that links to another topic within the same documentation set.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Internal</keyword>
        <keyword>cross</keyword>
        <keyword>reference</keyword>
        <keyword>DITA</keyword>
        <keyword>Scenario</keyword>
        <keyword>topic</keyword>
        <indexterm>Internal</indexterm>
        <indexterm>cross</indexterm>
        <indexterm>reference</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>  <section>
    <p>Consider a .md file that links to another topic within the same documentation set.</p><table frame="all" colsep="1" rowsep="1">
            <title>Internal link or cross reference</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
              <thead>
                <row>
                  <entry> .md input </entry>
                  <entry> DITA output </entry>
                </row>                
              </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>For information about notification configuration, see
  [Alarm Notifier](alarm-notifier.md).</codeblock>
                     </entry>
                     <entry>
                        <codeblock>&lt;p&gt;
  For information about notification configuration, see &lt;xref href="alarm-notifier.dita"&gt;Alarm Notifier&lt;/xref&gt;.
  &lt;/p&gt;</codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table><p>
            <b>Result:</b> The converter recognizes the target as an internal Markdown file and converts the link into a DITA <codeph>&lt;xref&gt;</codeph> element that references the corresponding DITA topic.</p>
  </section></refbody>
</reference>
