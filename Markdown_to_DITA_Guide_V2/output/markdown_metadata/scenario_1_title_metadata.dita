<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="scenario_1_title_metadata" xml:lang="en-us">
   <title>Scenario 1: Title metadata</title>
   <shortdesc>Consider an index.md file with front matter where the input for the title field is</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>title</keyword>
        <keyword>Title</keyword>
        <keyword>metadata</keyword>
        <keyword>Alarm</keyword>
        <keyword>Notifier</keyword>
        <keyword>Scenario</keyword>
        <indexterm>title</indexterm>
        <indexterm>Title</indexterm>
        <indexterm>metadata</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section id="sec_d797e7">
         <p>Consider an index.md file with front matter where the input for the title field is “Alarm Notifier”.</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Title metadata</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>.md input</entry>
                     <entry>DITA output</entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>+++ title = "Alarm Notifier" +++</codeblock>
                     </entry>
                     <entry>
                        <codeblock>
                           Alarm Notifier
                        </codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
         <p>
            <b>Result:</b>The value of the title field becomes the DITA topic title.</p>
      </section>
   </refbody>
</reference>
