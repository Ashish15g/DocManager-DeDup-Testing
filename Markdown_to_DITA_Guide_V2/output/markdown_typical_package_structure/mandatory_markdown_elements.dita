   <refbody>
      <section id="sec_d935e7">
         <table frame="all" colsep="1" rowsep="1">
            <title>Mandatory markdown elements</title>
            <tgroup cols="3">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <colspec colname="c3"/>
               <thead>
                  <row>
                     <entry> # </entry>
                     <entry> Mandatory Markdown construct </entry>
                     <entry> Role in conversion </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>1</entry>
                     <entry>Heading One (<codeph>#</codeph>)</entry>
                     <entry>Becomes the root DITA map <codeph>&lt;title&gt;</codeph> element or top-level topic title.</entry>
                  </row>
                  <row>
                     <entry>2</entry>
                     <entry>Headings Two to Six (<codeph>##</codeph> – <codeph>######</codeph>)</entry>
                     <entry>Drive the DITA map hierarchy and DITA topic boundaries.</entry>
                  </row>
                  <row>
                     <entry>3</entry>
                     <entry>Paragraphs (plain text blocks)</entry>
                     <entry>Map to <codeph>&lt;p&gt;</codeph> elements inside topic body elements (<codeph>&lt;conbody&gt;</codeph>,<codeph>&lt;taskbody&gt;</codeph>,<codeph>&lt;refbody&gt;</codeph>,<codeph>&lt;troublebody&gt;</codeph>).</entry>
                  </row>
                  <row>
                     <entry>4</entry>
                     <entry>Markdown Tables (pipe syntax)</entry>
                     <entry>Converted to DITA <codeph>&lt;simpletable&gt;</codeph> or <codeph>&lt;table&gt;</codeph> structures.</entry>
                  </row>
                  <row>
                     <entry>5</entry>
                     <entry>Images / Graphics (![alt](path "title"))</entry>
                     <entry>Converted to DITA <codeph>&lt;image&gt;</codeph> elements with <codeph>&lt;alt&gt;</codeph> and optional <codeph>&lt;title&gt;</codeph>/<codeph>&lt;fig&gt;</codeph> wrappers.</entry>
                  </row>
                  <row>
                     <entry>6</entry>
                     <entry>Ordered Lists (1., 2., etc.)</entry>
                     <entry>Map to DITA <codeph>&lt;ol&gt;&lt;li&gt;</codeph> or <codeph>&lt;steps&gt;&lt;step&gt;&lt;cmd&gt;</codeph> structures, depending on topic type.</entry>
                  </row>
                  <row>
                     <entry>7</entry>
                     <entry>Unordered Lists (-, *, +)</entry>
                     <entry>Map to DITA <codeph>&lt;ul&gt;&lt;li&gt;</codeph> structures.</entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </section>
   </refbody>
</reference>
