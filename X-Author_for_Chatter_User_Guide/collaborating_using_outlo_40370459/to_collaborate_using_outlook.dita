<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="CollaboratingUsingOutlook_ToCollaborateUsingOutlook" xml:lang="en">
   <title>To Collaborate Using Outlook</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Create a new email or open an existing email.</cmd>
         </step>
         <step>
            <cmd>Load the X-Author Chatter Online add-in by doing one of the following:</cmd>
            <substeps>
               <substep>
                  <cmd>If you are creating a new email message, click the <uicontrol>Add-ins</uicontrol> icon at the top of the message window and choose <uicontrol>Ink Outlook Online</uicontrol> from the task pane to the right. X-Author opens inside the task pane.</cmd>
                  <info>
                     <p>/screenshot/</p>
                  </info>
               </substep>
               <substep>
                  <cmd>If you are opening an existing email, click the <uicontrol>Ink Outlook
                        Online</uicontrol> app link just below the recipient line of the email
                     message. </cmd>
                  <stepresult>
                     <p>X-Author opens in a separate pane below the link.</p>
                     <p>/screenshot/</p>
                  </stepresult>
               </substep>
            </substeps>
         </step>
         <step>
            <cmd>Connect to X-Author Chatter Online as described in <xref href="../connecting_to_x_author_ch_40370449/40370449.dita" format="dita">Connecting to X-Author Chatter Online</xref>.</cmd>
         </step>
         <step>
            <cmd>Select who you want to collaborate with in your Chatter feed by clicking one of the icons:</cmd>
            <info>
               <p>
                  <table>
                     <tgroup cols="2">
                        <thead><row>
                              <entry>
                                 <p>/Chatter icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be everyone in your organization with a Chatter account.</p>
                              </entry>
                           </row></thead>
                        <tbody>
                           
                           <row>
                              <entry>
                                 <p>/Group icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be all the members of the group you select.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>/Individual icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be the single individual you select.</p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd>Choose how you want to share content to Chatter.</cmd>
            <info>
               <p>/screenshot of chatter window and drop-down/</p>
               <p>
                  <table>
                     <tgroup cols="2">
                        <thead><row>
                           <entry>
                              <p>Post</p>
                           </entry>
                           <entry>
                              <p>Enter a comment to solicit feedback, while not copying any content from the body of the email or email attachments.</p>
                           </entry>
                        </row></thead><tbody>                          
                           <row>
                              <entry>
                                 <p>Selected Content</p>
                              </entry>
                              <entry>
                                 <p>
                                    <b>Not supported.</b>
                                 </p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Selected Slides</p>
                              </entry>
                              <entry>
                                 <p>
                                    <b>Not supported.</b>
                                 </p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Entire Presentation</p>
                              </entry>
                              <entry>
                                 <p>
                                    <b>Not supported.</b>
                                 </p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>Share</uicontrol> to add your comments to the Chatter feed.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
