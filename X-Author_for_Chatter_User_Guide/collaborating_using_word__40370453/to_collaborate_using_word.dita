<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="CollaboratingUsingWord_ToCollaborateUsingWord" xml:lang="en">
   <title>To Collaborate Using Word</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Create a new document or open an existing document in Word.</cmd>
         </step>
         <step>
            <cmd>Connect to X-Author Chatter as described in <xref href="../connecting_to_x_author_ch_40370449/40370449.dita" format="dita">Connecting to X-Author Chatter Online</xref>.</cmd>
         </step>
         <step>
            <cmd>Select who you want to collaborate with in your Chatter feed by clicking one of the icons:</cmd>
            <info>
               <p>
                  <table>
                     <tgroup cols="2">
                        <thead><row>
                              <entry>
                                 <p>/Chatter icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be everyone in your organization with a Chatter account.</p>
                              </entry>
                           </row></thead>
                        <tbody>
                           
                           <row>
                              <entry>
                                 <p>/Group icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be all the members of the group you select.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>/Individual icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be the single individual you select.</p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd> Make changes to the document using Word and then choose what content to share.</cmd>
            <info>
               <p>/screenshot of chatter window and drop-down/</p>
               <p>
                  <table>
                     <tgroup cols="2">
                        <thead><row>
                              <entry>
                                 <p>Post</p>
                              </entry>
                              <entry>
                                 <p>Comments you provide in Chatter are included, but no part of the document is included.</p>
                              </entry>
                           </row></thead>
                        <tbody>
                           
                           <row>
                              <entry>
                                 <p>Selected Content</p>
                              </entry>
                              <entry>
                                 <p>The content highlighted in your document is inserted into the Chatter feed, as unformatted text. There is a maximum of 1000 characters.</p>
                                 <p>(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire document is attached to the Chatter feed.</b>)</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Entire Document</p>
                              </entry>
                              <entry>
                                 <p>The document is attached to the feed.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Selected Content + Entire Document</p>
                              </entry>
                              <entry>
                                 <p>Highlighted content (up to 1000 characters) and the document (as an attachment) are included in the feed.</p>
                                 <p>(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire document is attached to the Chatter feed.</b>)</p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>Share</uicontrol> to share your content to the Chatter feed.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
