<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="CollaboratingUsingExcel_ToCollaborateUsingExcel" xml:lang="en">
   <title>To Collaborate Using Excel</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Create a new workbook or open an existing workbook in Word.</cmd>
         </step>
         <step>
            <cmd>Connect to X-Author Chatter as described in <xref href="../connecting_to_x_author_ch_40370449/40370449.dita" format="dita">Connecting to X-Author Chatter Online</xref>.</cmd>
         </step>
         <step>
            <cmd>Select who you want to collaborate with in your Chatter feed by clicking one of the icons:</cmd>
            <info>
               <p>
                  <table>
                     <tgroup cols="2">
                        <tbody>
                           <row>
                              <entry>
                                 <p>/Chatter icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be everyone in your organization with a Chatter account.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>/Group icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be all the members of the group you select.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>/Individual icon/</p>
                              </entry>
                              <entry>
                                 <p>Your audience will be the single individual you select.</p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd> Make changes to the workbook using Excel and then choose what content to share.</cmd>
            <info>
               <p>/screenshot of chatter window and drop-down/</p>
               <p>
                  <table>
                     <tgroup cols="2">
                        <tbody>
                           <row>
                              <entry>
                                 <p>Post</p>
                              </entry>
                              <entry>
                                 <p>Comments you provide in Chatter are included, but no part of the workbook is included.</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Selected Content</p>
                              </entry>
                              <entry>
                                 <p>The selected content is exported and attached to the Chatter feed as a new xls file. All selected content must be in adjoining cells. The minimum content that can be selected is a whole cell. Selected text within a cell cannot be shared.</p>
                                 <p>(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire workbook is attached to the Chatter feed.</b>)</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Active Worksheet</p>
                              </entry>
                              <entry>
                                 <p>The entire worksheet is copied and attached to the feed as a new xls file.</p>
                                 <p>(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire workbook is attached to the Chatter feed.</b>)</p>
                              </entry>
                           </row>
                           <row>
                              <entry>
                                 <p>Entire Workbook</p>
                              </entry>
                              <entry>
                                 <p>The whole workbook is attached to the feed.</p>
                              </entry>
                           </row>
                        </tbody>
                     </tgroup>
                  </table>
               </p>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>Share</uicontrol> to share your content to the Chatter feed.</cmd>
         </step>
      </steps>
   </taskbody>
</task>