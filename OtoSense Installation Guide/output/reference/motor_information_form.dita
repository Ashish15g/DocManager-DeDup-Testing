                     <entry>60</entry>
                     <entry/>
                  </row>
                  <row>
                     <entry/>
                     <entry>G</entry>
                     <entry>Connection</entry>
                     <entry>Star, Delta, Double Star, etc.</entry>
                     <entry/>
                  </row>
                  <row>
                     <entry/>
                     <entry>H</entry>
                     <entry>Drive</entry>
                     <entry>VFD or DOL, etc.</entry>
                     <entry/>
                  </row>
                  <row>
                     <entry/>
                     <entry>I</entry>
                     <entry>Efficiency level</entry>
                     <entry>IE1, IE2 or IE3</entry>
                     <entry/>
                  </row>
                  <row>
                     <entry>•</entry>
                     <entry>J</entry>
                     <entry>Model</entry>
                     <entry>1AA46</entry>
                     <entry/>
                  </row>
                  <row>
                     <entry>•</entry>
                     <entry/>
