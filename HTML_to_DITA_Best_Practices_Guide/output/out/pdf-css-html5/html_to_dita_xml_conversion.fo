                                                </fo:block></fo:table-cell>
                                            </fo:table-row>
                                        </fo:table-body></fo:table></fo:table-and-caption>
                                </fo:block>
                                <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/important.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Important:</fo:block> Author mathematical expressions using
                                    native MathML. Image-based equations and client-side rendering
                                    libraries do not produce structured content during
                                    conversion.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_94" xml:lang="en-us" chfox:nd-id="_Toc235450429">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title94"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e15317"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e15321"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e15325"/><fo:inline>Scenario 1 — Block equation</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Consider a
