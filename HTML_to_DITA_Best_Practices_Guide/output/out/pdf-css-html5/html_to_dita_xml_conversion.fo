                                                  <fo:block-container background-color="rgb(238 , 238 , 238)" font-family="monospace" font-size="0.8em" space-after="0.5em" margin-left="0.5em" margin-right="0" space-before="0.5em" max-height="600px" chfox:overflow-wrap="break-word" hyphenate="false" break-line-at-hyphens="avoid" role="Code" space-after.conditionality="retain" space-before.conditionality="retain" padding-bottom="2px" padding-left="4px" padding-right="4px" padding-top="2px" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="wrap" id="unique_73_Connect_42_codeblock_yr5_td4_lkc" chfox:nd-id="codeblock_yr5_td4_lkc"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0"/></fo:block-container> </fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;image href="media/print_head_diagram.png"&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;alt&gt;Diagram showing the print head path inside the printer&lt;/alt&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;/image&gt;</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
