                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;troublebody&gt;</fo:inline>
                                                  </fo:block></fo:table-cell>
                                                </fo:table-row>
                                                <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>No dominant classification signal</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Generic</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline>
