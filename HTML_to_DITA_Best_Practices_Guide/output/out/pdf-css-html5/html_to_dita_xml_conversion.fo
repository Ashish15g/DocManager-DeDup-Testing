<fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        &lt;keyword&gt;network&lt;/keyword&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        &lt;keyword&gt;configuration&lt;/keyword&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        &lt;keyword&gt;setup&lt;/keyword&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">      &lt;/keywords&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">      &lt;othermeta name="company" content="XYZ Corp"/&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;/metadata&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;/prolog&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;shortdesc&gt;Steps to configure the device network settings.&lt;/shortdesc&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;conbody&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    ...</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;/conbody&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;/concept&gt;</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
