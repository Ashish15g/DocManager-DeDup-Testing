ent" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_8" xml:lang="en-us" chfox:nd-id="_Toc235450328"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title8"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>HTML Typical Package Structure</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 3 - <!--content(text)--><fo:inline>HTML Typical Package Structure</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 3 - <!--content(text)--><fo:inline>HTML Typical Package Structure</fo:inline></fo:marker><fo:inline>Chapter 3. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2919"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2923"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2927"/><fo:inline>HTML Typical Package Structure</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block>This
                                    section describes the typical structure of an HTML package
                                    submitted for conversion to DITA-XML, including folder
                                    organization, file naming, and the placement of media assets. It
                                    covers the standard HTML page structure the converter expects,
                                    focusing on how both <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;head&gt;</fo:inline> metadata and <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline> content is read and mapped. The
                                    converter uses these structures to identify the entry point,
                                    build the root and child Ditamap hierarchy, determine topic
                                    boundaries from heading levels, and generate accurate DITA maps
                                    and topic files.</fo:block>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_9" xml:lang="en-us" chfox:nd-id="_Toc235450330">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title9"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2980"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2984"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2988"/><fo:inline>HTML Typical Folder
                                    Structure</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">A typical HTML
                                        package contains the following:</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">A typical HTML
                                        package contains the following:</fo:block></fo:block-container>
                                    <fo:block-container background-color="rgb(238 , 238 , 238)" font-family="monospace" font-size="0.8em" space-after="0.5em" margin-left="0.5em" margin-right="0" space-before="0.5em" max-height="600px" chfox:overflow-wrap="break-word" break-line-at-hyphens="avoid" role="Code" padding-bottom="2px" padding-left="4px" padding-right="4px" padding-top="2px" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="wrap" id="unique_9_Connect_42_codeblock_uhs_xrg_lkc" chfox:nd-id="codeblock_uhs_xrg_lkc"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0"/></fo:block-container> </fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">HTML Package (ZIP)</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">├── index.html          → creates the root Ditamap hierarchy (if present)</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">├── topic1.html         → creates a child Ditamap and DITA topic</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">├-- topic2.html         → creates a child Ditamap and DITA topic</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">├── media/</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">│   ├── image1.png</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">│   └── image2.svg</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">├── css/</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">│   └── styles.css      → ignored</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">└── scripts/</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">└── script.js           → ignored</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter
                                        reads the HTML constructs given in the following bullet
                                        list:</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_9_Connect_42_ul_09045103" chfox:nd-id="ul_09045103">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline font-weight="bold">Index
                                                file (</fo:inline>
                                            <fo:inline font-weight="bold">index.html</fo:inline>
                                            <fo:inline font-weight="bold">,
                                                optional).</fo:inline> Creates the root Ditamap
                                            hierarchy and serves as the entry point for the
                                            converted documentation.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline font-weight="bold">HTML
                                                files (</fo:inline>
                                            <fo:inline font-weight="bold">.html</fo:inline>
                                            <fo:inline font-weight="bold">or</fo:inline>
                                            <fo:inline font-weight="bold">.htm</fo:inline>
                                            <fo:inline font-weight="bold">).</fo:inline> The converter creates a child Ditamap
                                            and a primary DITA topic from each file.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline font-weight="bold">Images
                                                and media.</fo:inline> The converter maps referenced
                                            assets to DITA <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;image&gt;</fo:inline> elements.</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter
                                        reads the package structure to create the root Ditamap
                                        folder hierarchy, identifies the main entry point, preserves
                                        relative paths for images and media, and generates child
                                        Ditamaps based on individual HTML files. Submit HTML content
                                        as a ZIP file.</fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/tip.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Tip:</fo:block> Organize HTML files
                                        in a logical folder structure before conversion. The
                                        converter preserves the folder hierarchy in the DITA
                                        output.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_10" xml:lang="en-us" chfox:nd-id="_Toc235450331">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title10"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3097"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3101"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3105"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3109"/><fo:inline>HTML Typical Page Structure</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Each HTML file
                                        follows standard HTML5 document structure:</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Each HTML file
                                        follows standard HTML5 document structure:</fo:block></fo:block-container>
                                    <fo:block-container background-color="rgb(238 , 238 , 238)" font-family="monospace" font-size="0.8em" space-after="0.5em" margin-left="0.5em" margin-right="0" space-before="0.5em" max-height="600px" chfox:overflow-wrap="break-word" break-line-at-hyphens="avoid" role="Code" padding-bottom="2px" padding-left="4px" padding-right="4px" padding-top="2px" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="wrap" id="unique_10_Connect_42_codeblock_qdt_ltg_lkc" chfox:nd-id="codeblock_qdt_ltg_lkc"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0"/></fo:block-container> </fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;html&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;head&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;title&gt;Page Title&lt;/title&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;meta name="author" content="Documentation Team"&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;meta name="created" content="2026-01-15"&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;/head&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;body&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    [Content appears here]</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;footer&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">      [Footer content]</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;/footer&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;/body&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;/html&gt;</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter
                                        focuses on two key areas:</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;head&gt;</fo:inline>
                                            <fo:inline font-weight="bold">metadata</fo:inline>. The converter maps this content
                                            to DITA <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;prolog&gt;</fo:inline> elements such as author,
                                            created date, and revised date</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline>
                                            <fo:inline font-weight="bold">content.</fo:inline> The converter maps this content
                                            to DITA topic body elements, including paragraphs,
                                            lists, tables, and images.</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block> The converter
                                        ignores footer content by default, as well as CSS,
                                        JavaScript, navigation menus, cookie banners,
                                        advertisements, and hidden elements. If your HTML file
                                        contains important content in the footer, move it to the
                                            <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline> section before conversion.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect" id="unique_11" xml:lang="en-us" chfox:nd-id="_Toc235450332">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title11"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3197"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3201"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3205"/><fo:inline>HTML Body Content</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline> element contains semantic
                                            content that maps to DITA topics and topic body
                                            elements. The converter processes elements in document
                                            order and uses the heading hierarchy to determine topic
                                            boundaries and nesting levels.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter
                                            extracts the HTML package, analyzes metadata and content
                                            structure, applies heading-based hierarchy rules, and
                                            generates the corresponding Ditamaps and topics.</fo:block></fo:block-container>
                                        <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block> If the HTML
                                            uses visual formatting instead of semantic structure,
                                            the converter may append content to the wrong topic,
                                            create an incorrect hierarchy, or generate DITA that
                                            requires manual cleanup.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block>
                            </fo:block>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_12" xml:lang="en-us" chfox:nd-id="_headinghvvgksf8to6pe"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title12"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>HTML Index</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>HTML Index</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>HTML Index</fo:inline></fo:marker><fo:inline>Chapter 4. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3270"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3274"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e3278"/><fo:inline>HTML Index</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block> This
                                    section covers the Table of Contents and Root Index — the
                                    navigation structure that maps the publication hierarchy and
                                    serves as the converter's primary entry point for building the
                                    root DITA map — and two scenarios: a root index file present in
                                    the package, and a missing root index file. The converter reads
                                    the root index to construct the DITA map hierarchy and topic
                                    references; when no root index is present, it falls back to the
                                    package folder name or filename as the root map title.</fo:block>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">A
                                    table of contents or root index is the navigation structure of a
                                    publication. It declares the document's complete hierarchy in
                                    one place — the titles, sequence, and parent-child relationships
                                    of all sections, chapters, and topics — and provides the entry
                                    point from which readers and systems navigate the entire
                                    deliverable.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For the publishing system, the table of contents or root index
                                    is the structural anchor of the entire output — every generated
                                    navigation artifact, including the PDF bookmark panel, the HTML5
                                    navigation tree, the WebHelp TOC panel, and the DITA map
                                    hierarchy, derives from this structure.</fo:block></fo:block-container>
                                <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                    The converter reads it to build the DITA map hierarchy and then
                                    discards it — the publishing transform regenerates the
                                    navigation structure at build time from the assembled DITA map,
                                    ensuring it always reflects the actual content rather than a
                                    manually maintained list that can fall out of sync.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In
                                    a well-structured HTML package, the table of contents is
                                    provided by the navigation structure in the index.html or
                                    index.htm file. Each navigation link references an HTML document
                                    within the publication, and the order and nesting of these links
                                    establish the hierarchy of the generated documentation.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter reads the navigation structure in the index file
                                    to generate the root Ditamap hierarchy. The table of contents
                                    itself is not converted into a standalone DITA topic. Instead,
                                    each navigation link becomes a corresponding <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;mapref&gt;</fo:inline> or <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;topicref&gt;</fo:inline> in the generated root Ditamap,
                                    preserving the organization of the original HTML
                                    publication.</fo:block></fo:block-container>
