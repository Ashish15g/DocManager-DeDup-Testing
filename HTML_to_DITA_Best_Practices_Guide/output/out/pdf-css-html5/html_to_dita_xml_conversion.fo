                                                  <fo:block-container background-color="rgb(238 , 238 , 238)" font-family="monospace" font-size="0.8em" space-after="0.5em" margin-left="0.5em" margin-right="0" space-before="0.5em" max-height="600px" chfox:overflow-wrap="break-word" hyphenate="false" break-line-at-hyphens="avoid" role="Code" space-after.conditionality="retain" space-before.conditionality="retain" padding-bottom="2px" padding-left="4px" padding-right="4px" padding-top="2px" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="wrap"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0"/></fo:block-container> </fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;h2&gt;The Printer Does Not Power On&lt;/h2&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;p&gt;&lt;b&gt;Cause:&lt;/b&gt; The power cable is disconnected.&lt;/p&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;p&gt;&lt;b&gt;Remedy:&lt;/b&gt;&lt;/p&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;ol&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;li&gt;Connect the power cable securely.&lt;/li&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;li&gt;Press the power button.&lt;/li&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;/ol&gt;</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
