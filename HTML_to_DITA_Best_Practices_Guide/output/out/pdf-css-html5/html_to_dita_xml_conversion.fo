                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title2"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Getting Started</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 2 - <!--content(text)--><fo:inline>Getting Started</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 2 - <!--content(text)--><fo:inline>Getting Started</fo:inline></fo:marker><fo:inline>Chapter 2. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e1974"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e1978"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e1982"/><fo:inline>Getting Started</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block>This
                                    section describes the purpose and audience of this guide as well
                                    as the prerequisites for HTML conversion to DITA-XML. It covers
                                    the mandatory and optional HTML constructs, document preparation
                                    requirements, and the scenarios that affect conversion
                                    readiness. The converter and AI Agent use these structures to
                                    detect document hierarchy, classify topic types, infer metadata,
                                    and generate accurate DITA maps and topic files.</fo:block>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_3" xml:lang="en-us" chfox:nd-id="_Toc235450323">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title3"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2035"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2039"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2043"/><fo:inline>Purpose</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This guide
                                        provides mandatory best practices for anyone who creates or
                                        prepares HTML source content</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This guide
                                        provides mandatory best practices for anyone who creates or
                                        prepares HTML source content for conversion to DITA-XML
                                        using the metR DocMigration HTML to DITA converter. The
                                        converter is a modular microservice with an embedded AI
                                        Agent that reasons and enriches DITA elements in document
                                        structure before transforming them into standards-compliant
                                        DITA-XML.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Following these
                                        guidelines ensures that:</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_3_Connect_42_ul_090451" chfox:nd-id="ul_090451">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The
                                            converter correctly identifies topic boundaries, heading
                                            hierarchies, and content types.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The AI
                                            Conversion Agent classifies topics accurately as
                                            concept, task, reference, or troubleshooting.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The
                                            generated DITA-XML output is clean and complete,
                                            requiring minimal post-conversion cleanup.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Metadata
                                            and Ditamap hierarchies are detected reliably.</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_4" xml:lang="en-us" chfox:nd-id="_Toc235450324">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title4"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2118"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2122"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e2126"/><fo:inline>Intended Audience</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This guide is
                                        intended for the following audiences:</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This guide is
                                        intended for the following audiences:</fo:block></fo:block-container>
                                    <fo:block>
                                        <fo:table-and-caption border-collapse="collapse" id="d689e2140" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" margin-top="0.5em" text-align="left"><fo:block end-indent="0" start-indent="0"><fo:inline>Table<fo:inline> 1</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Intended audience and guide
                                                  applicability</fo:inline></fo:inline></fo:block></fo:block-container></fo:table-caption><fo:table-caption-for-next-page start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" margin-top="0.5em" text-align="left"><fo:block end-indent="0" start-indent="0"><fo:inline>Table<fo:inline> 1</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Intended audience and guide
                                                  applicability</fo:inline></fo:inline><fo:inline> (continued)</fo:inline></fo:block></fo:block-container></fo:table-caption-for-next-page><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="black" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column/><fo:table-column/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_4__d689e2140__entry__1"><fo:block>
                                                  <fo:inline>Audience</fo:inline>
                                                  </fo:block></fo:table-cell>
