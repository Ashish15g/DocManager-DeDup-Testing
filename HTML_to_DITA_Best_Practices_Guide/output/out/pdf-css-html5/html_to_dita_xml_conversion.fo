"0" start-indent="0">      &lt;cmd&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        Go to</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        &lt;menucascade&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">          &lt;uicontrol&gt;File&lt;/uicontrol&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">          &lt;uicontrol&gt;Save As&lt;/uicontrol&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">        &lt;/menucascade&gt;.</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">      &lt;/cmd&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">    &lt;/step&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">  &lt;/steps&gt;</fo:block></fo:block-container></fo:block><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0">&lt;/taskbody&gt;</fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-body></fo:table></fo:table-and-caption>
                                        </fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Result:</fo:inline> The
                                            converter detects the menu navigation pattern — multiple
                                                <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;strong&gt;</fo:inline> elements separated by a <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&gt;</fo:inline> character within a <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;span&gt;</fo:inline> — and maps the sequence to a
                                                <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;menucascade&gt;</fo:inline> structure containing
                                            nested <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;uicontrol&gt;</fo:inline> elements.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_31" xml:lang="en-us" chfox:nd-id="_Toc235450357"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title31"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Lists</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 9 - <!--content(text)--><fo:inline>Lists</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 9 - <!--content(text)--><fo:inline>Lists</fo:inline></fo:marker><fo:inline>Chapter 9. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6387"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6391"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6395"/><fo:inline>Lists</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block>This
                                    section covers Lists in HTML — the primary structure for
                                    presenting discrete, parallel items in a defined or co-equal
                                    sequence — and introduces two subsections: Ordered Lists and
                                    Unordered Lists. The converter reads the list type, nesting
                                    level, and topic context to determine whether to map each list
                                    to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ul&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;steps&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;substeps&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;choices&gt;</fo:inline>, or <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;dl&gt;</fo:inline> in the DITA output.</fo:block>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                    <fo:inline font-weight="bold">Lists</fo:inline>communicate sequences,
                                    collections, and term-definition pairs that prose paragraphs
                                    cannot organize with equal clarity. They are the primary
                                    structure for presenting discrete, parallel items — steps in a
                                    procedure, items in a requirements checklist, and options in a
                                    configuration section.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">A
                                    list communicates to the reader that its items share a
                                    structural relationship: either sequence matters and the order
                                    is meaningful, or the items are co-equal and interchangeable in
                                    position.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter evaluates the HTML list type together with its
                                    surrounding context — topic classification, position relative to
                                    other content, and nesting — to generate the appropriate DITA
                                    list structure. Ordered lists, unordered lists, and term lists
                                    are each governed by their own mapping rules, described in the
                                    sections that follow.</fo:block></fo:block-container>
                                <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/important.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Important:</fo:block> Always use native HTML list elements (ol
                                    and ul) to represent structured information. Do not simulate
                                    lists using manually typed numbers, bullet characters, hyphens,
                                    or spacing within paragraphs, as these patterns are treated as
                                    plain text during conversion.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_32" xml:lang="en-us" chfox:nd-id="_Toc235450359">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title32"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6470"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6474"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6478"/><fo:inline>Ordered Lists (Numbered)</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block>This
                                        section covers Ordered Lists in HTML — items presented in a
                                        defined sequence where position is significant — and
                                        twenty-one scenarios grouped across six categories:
                                        consecutive and discontinuous numbered lists as procedures
                                        and workflows, single-item numbered lists, two-level and
                                        three-level nested numbered lists, and interrupted numbered
                                        lists where an admonition, paragraph, image, table, or
                                        bullet list appears between items. The converter maps each
                                        ordered list to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;&lt;li&gt;</fo:inline> in concept and reference
                                        topics, or to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;steps&gt;&lt;step&gt;&lt;cmd&gt;</fo:inline> in task
                                        topics, based on the heading classification and content
                                        context.</fo:block>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">An <fo:inline font-weight="bold">ordered list</fo:inline> presents
                                        items in a defined sequence where the position of each item
                                        is significant. The ordered lists are universally used for
                                        step-by-step procedures, installation instructions, and
                                        ranked items.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For the reader, a
                                        numbered list communicates that sequence is contractual —
                                        item 2 depends on item 1 being completed, and performing the
                                        items out of order produces an incorrect or unsafe result.
                                        It is also a navigational reference that lets a reader say
                                        "I am on step 4" and return to the correct position after an
                                        interruption.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The list level is
                                        controlled by the Increase and Decrease Indent buttons,
                                        determines nesting depth: level 1 is the top level, level 2
                                        is the first nested level, level 3 is the second, and so on.
                                        Sometimes they are also defined by their tab indentation.
                                        The list level assigned by list controls is what drives the
                                        nesting structure in the DITA output.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In well-structured
                                        HTML, ordered lists are created using native <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline> and <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;li&gt;</fo:inline> elements. Nested ordered lists
                                        represent subordinate sequences, while introductory
                                        paragraphs, images, tables, and notes provide supporting
                                        information without changing the sequential relationship
                                        between list items. A new <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline> element beginning after an existing
                                        list — rather than continuing it — signals a restarted or
                                        independent sequence rather than a continuation of the prior
                                        list.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The converter
                                        evaluates both the HTML list structure and the classified
                                        DITA topic type when processing an ordered list. Within
                                        Concept, Reference, and Generic topics, an HTML <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline> is converted to a DITA <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline>. Within a Task topic, the same <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;ol&gt;</fo:inline> is converted into <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;steps&gt;</fo:inline>, with each <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;li&gt;</fo:inline> mapped to a <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;step&gt;</fo:inline> containing a <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;cmd&gt;</fo:inline>. The surrounding context determines
                                        how supporting content associated with each list item is
                                        represented in the generated DITA structure.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The following
                                        scenarios demonstrate how different HTML ordered list
                                        patterns are interpreted during HTML-to-DITA conversion:</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect" id="unique_33" xml:lang="en-us" chfox:nd-id="_Toc235450361">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title33"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6585"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6589"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e6593"/><fo:inline>Scenario 1 — Consecutive Numbered
                                            list as a Procedure</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Consider an
                                            &lt;h2&gt; called "Install on Linux", the body contains
