                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:inline font-weight="bold">Result:</fo:inline> The 2-column HTML <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;table&gt;</fo:inline> maps to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;properties&gt;</fo:inline> because the topic is
                                                  classified as API reference. The same table in a
                                                  concept topic would produce <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;simpletable&gt;</fo:inline>.</fo:block></fo:block-container>
                                                <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Note:</fo:block> A 2-column table maps to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;properties&gt;</fo:inline>only when the topic is
                                                  classified as reference with an API keyword
                                                  context. Outside of that context, a 2-column HTML
                                                  <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;table&gt;</fo:inline> always maps to <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;simpletable&gt;</fo:inline>.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For a
                                                  complete summary of how HTML table structures map
                                                  to DITA output elements, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_74" fox:alt-text="Tables — Overview">Tables —
                                                  Overview</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_74" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_74"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_74"><fo:page-number-citation ref-id="unique_74"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_74">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
