                                                <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;math&gt;</fo:inline> element placed between two
                                                <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;p&gt;</fo:inline> elements as a standalone block
                                            equation.</fo:block></fo:block-container>
