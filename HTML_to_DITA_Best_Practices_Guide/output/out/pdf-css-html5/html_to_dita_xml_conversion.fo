                                                  <fo:inline>HTML
                                                  Input</fo:inline>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_115__d689e18016__entry__2"><fo:block>
                                                  <fo:inline>DITA
