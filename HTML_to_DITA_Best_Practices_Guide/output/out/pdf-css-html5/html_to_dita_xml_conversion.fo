ent" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_99" xml:lang="en-us" chfox:nd-id="_Toc235450434"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title99"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Additional Reference/Appendix</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 15 - <!--content(text)--><fo:inline>Additional Reference/Appendix</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 15 - <!--content(text)--><fo:inline>Additional Reference/Appendix</fo:inline></fo:marker><fo:inline>Chapter 15. </fo:inline><fo:inline>Additional Reference/Appendix</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"/></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_100" xml:lang="en-us" chfox:nd-id="_Toc235450435">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title100"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e15994"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e15998"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d689e16002"/><fo:inline>Topic Type Classification</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">is the process
                                        of assigning a heading-delimited section of HTML content to
                                        a specific DITA</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Topic type
                                        classification is the process of assigning a
                                        heading-delimited section of HTML content to a specific DITA
                                        topic type. Unlike DITA, HTML does not explicitly identify a
                                        section as conceptual, procedural, reference, or
                                        troubleshooting content. Instead, the structure and purpose
                                        of a section are inferred from the heading and the HTML
                                        elements that follow it until the next heading of the same
                                        or higher level.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Accurate
                                        classification matters because every DITA topic type
                                        generates a distinct body element — <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;conbody&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;taskbody&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;refbody&gt;</fo:inline>, <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;troublebody&gt;</fo:inline>, or <fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;body&gt;</fo:inline> — and each body element supports a
                                        specific content structure required for that topic type. A
                                        help system that filters search results by topic type, a
                                        content management system that applies different review
                                        workflows to tasks versus references, or a PDF generator
                                        that styles procedures with numbered callouts, all depend on
                                        the topic type being assigned correctly at conversion
                                        time.</fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/important.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Important:</fo:block> The
                                        HTML-to-DITA converter evaluates two complementary signals
                                        when determining the topic type. The converter first
                                        evaluates the wording of the heading. It then analyzes the
                                        dominant HTML structure beneath that heading. This structure
                                        could include paragraphs, ordered lists, tables, or other
                                        recurring content patterns. When both signals indicate the
                                        same type of content, the converter generates the
                                        corresponding DITA topic and body element. It then
                                        restructures the HTML content into the child elements
                                        required by that topic type.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The following
                                        table summarizes the primary content patterns that the
                                        converter uses when determining the generated DITA topic
                                        type:</fo:block></fo:block-container>
                                    <fo:block>
                                        <fo:table-and-caption border-collapse="collapse" id="d689e16040" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" margin-top="0.5em" text-align="left"><fo:block end-indent="0" start-indent="0"><fo:inline>Table<fo:inline> 88</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Content patterns mapped to
                                                  topic
                                                type</fo:inline></fo:inline></fo:block></fo:block-container></fo:table-caption><fo:table-caption-for-next-page start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" margin-top="0.5em" text-align="left"><fo:block end-indent="0" start-indent="0"><fo:inline>Table<fo:inline> 88</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Content patterns mapped to
                                                  topic
                                                type</fo:inline></fo:inline><fo:inline> (continued)</fo:inline></fo:block></fo:block-container></fo:table-caption-for-next-page><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="black" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column/><fo:table-column/><fo:table-column/><fo:table-header font-weight="bold" text-align="center" display-align="center">
