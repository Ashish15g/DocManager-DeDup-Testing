<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="_headinghj9t4rfp25393" xml:lang="en-us">
   <title>Scenario 2 — Multiple causes for one problem</title>
   <shortdesc>Consider an HTML document containing one condition followed by multiple causes and corresponding remedies.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>cause</keyword>
        <keyword>remedy</keyword>
        <keyword>causes</keyword>
        <keyword>problem</keyword>
        <keyword>Cause</keyword>
        <keyword>Remedy</keyword>
        <indexterm>cause</indexterm>
        <indexterm>remedy</indexterm>
        <indexterm>causes</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
      <p>Consider an HTML document containing one condition followed by multiple causes and corresponding remedies.</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Troubleshooting: multiple causes, one problem</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>
                        <b>HTML Input</b>
                     </entry>
                     <entry>
                        <b>DITA output</b>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>
&lt;h2>The Printer Does Not Print&lt;/h2>
&lt;p>&lt;strong>Cause 1:&lt;/strong> Paper tray is empty.&lt;/p>
&lt;p>&lt;strong>Remedy:&lt;/strong>&lt;/p>
&lt;ol>
  &lt;li>Load paper into the paper tray.&lt;/li>
&lt;/ol>
&lt;p>&lt;strong>Cause 2:&lt;/strong> Printer is offline.&lt;/p>
&lt;p>&lt;strong>Remedy:&lt;/strong>&lt;/p>
&lt;ol>
  &lt;li>Reconnect the printer to the network.&lt;/li>
&lt;/ol></codeblock>
                     </entry>
                     <entry>
                        <codeblock>
&lt;troubleshooting id="trouble_rzn_xrj_rjc">
  &lt;title>The printer does not print&lt;/title>
  &lt;troublebody>
    &lt;condition>
      &lt;title>Condition&lt;/title>
      &lt;p>The printer does not print&lt;/p>
    &lt;/condition>
    &lt;troubleSolution>
      &lt;cause id="cause_jb3_nwj_rjc">
        &lt;title>Cause 1&lt;/title>
        &lt;p>Paper tray is empty.&lt;/p>
      &lt;/cause>
      &lt;remedy id="remedy_kb3_nwj_rjc">
        &lt;title>Remedy&lt;/title>
        &lt;steps id="steps_lb3_nwj_rjc">
          &lt;step>
            &lt;cmd>Load paper.&lt;/cmd>
          &lt;/step>
        &lt;/steps>
      &lt;/remedy>
    &lt;/troubleSolution>
    &lt;troubleSolution>
      &lt;cause id="cause_qb3_nwj_rjc">
        &lt;title>Cause 2&lt;/title>
        &lt;p>Printer is offline.&lt;/p>
      &lt;/cause>
      &lt;remedy id="remedy_vhq_dwj_rjc">
        &lt;title>Remedy&lt;/title>
        &lt;steps id="steps_usn_2wj_rjc">
          &lt;step>
            &lt;cmd>Reconnect printer.&lt;/cmd>
          &lt;/step>
        &lt;/steps>
      &lt;/remedy>
    &lt;/troubleSolution>
  &lt;/troublebody>
&lt;/troubleshooting></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
<p><b>Result:</b> Each cause-and-remedy pair produces its own <codeph>&lt;troubleSolution&gt;</codeph>, while the shared problem heading maps to a single <codeph>&lt;condition&gt;</codeph> at the top of <codeph>&lt;troublebody&gt;</codeph>.</p>
   </section>
   </refbody>
</reference>
