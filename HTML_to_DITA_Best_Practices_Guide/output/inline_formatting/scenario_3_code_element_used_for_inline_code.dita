<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="_Toc235450354" xml:lang="en-us">
   <title>Scenario 3 — Code element used for inline code</title>
   <prolog>
    <metadata>
      <keywords>
        <keyword>element</keyword>
        <keyword>inline</keyword>
        <keyword>Code</keyword>
        <keyword>Scenario</keyword>
        <keyword>HTML</keyword>
        <keyword>script</keyword>
        <indexterm>element</indexterm>
        <indexterm>inline</indexterm>
        <indexterm>Code</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
    <p>Consider an HTML paragraph that contains a shell script name wrapped in a <codeph>&lt;code&gt;</codeph> element.</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Code element used for inline code</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>
                        <b>HTML Input</b>
                     </entry>
                     <entry>
                        <b>DITA Output</b>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>
&lt;ol>
    &lt;li>
        Run &lt;code>deploy.sh&lt;/code> using elevated privileges.
    &lt;/li>
&lt;/ol></codeblock>
                     </entry>
                     <entry>
                        <codeblock>
&lt;taskbody>
    &lt;steps>
        &lt;step>
            &lt;cmd>
                Run &lt;codeph>deploy.sh&lt;/codeph> using elevated privileges.
            &lt;/cmd>
        &lt;/step>
    &lt;/steps>
&lt;/taskbody></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
         <p><b>Result:</b> The <codeph>&lt;code&gt;</codeph> element representing an inline code term or script name is mapped to <codeph>&lt;codeph&gt;</codeph>.</p>
  </section>
   </refbody>
</reference>
