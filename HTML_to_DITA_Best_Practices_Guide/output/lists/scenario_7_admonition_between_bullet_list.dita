<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="_headinghtoqiutb7ap6r" xml:lang="en-us">
   <title>Scenario 7 — Admonition between Bullet List</title>
   <shortdesc>Consider a bulleted list where the author has inserted an admonition between two bullet items</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>deployment</keyword>
        <keyword>between</keyword>
        <keyword>Admonition</keyword>
        <keyword>Scenario</keyword>
        <keyword>Bullet</keyword>
        <keyword>List</keyword>
        <indexterm>deployment</indexterm>
        <indexterm>between</indexterm>
        <indexterm>Admonition</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
      <p>Consider a bulleted list where the author has inserted an admonition between two bullet items to call out a precaution or clarification relevant to the item just listed.</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Admonition between bullet items</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>
                        <b>HTML Input</b>
                     </entry>
                     <entry>
                        <b>DITA Output</b>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>
&lt;h2 id="deployment-models">Supported Deployment Models&lt;/h2>
&lt;ul>
  &lt;li>
    On-premises deployment
    &lt;div class="warning">
      Requires dedicated IT staff to maintain hardware.
    &lt;/div>
  &lt;/li>
  &lt;li>Cloud deployment&lt;/li>
  &lt;li>Hybrid deployment&lt;/li>
&lt;/ul></codeblock>
                     </entry>
                     <entry>
                        <codeblock>
&lt;concept id="supported_deployment_models">
  &lt;title>Supported Deployment Models&lt;/title>
  &lt;conbody>
    &lt;ul>
      &lt;li>
        On-premises deployment
        &lt;note type="warning">
          &lt;p>Requires dedicated IT staff to maintain hardware.&lt;/p>
        &lt;/note>
      &lt;/li>
      &lt;li>Cloud deployment&lt;/li>
      &lt;li>Hybrid deployment&lt;/li>
    &lt;/ul>
  &lt;/conbody>
&lt;/concept></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
<p><b>Result:</b> The admonition is nested inside the preceding <codeph>&lt;li&gt;</codeph> as a <codeph>&lt;note&gt;</codeph> element, and the <codeph>&lt;ul&gt;</codeph> remains a single continuous list.</p>
         </section>
   </refbody>
</reference>
