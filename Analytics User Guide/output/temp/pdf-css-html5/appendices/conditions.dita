                     <codeblock xml:space="preserve" class="+ topic/pre pr-d/codeblock " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="codeblock:1;53:54">powerSystem</codeblock>
                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:5;55:26">Power System</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:6;56:26">Problems in the three phases of the power supply, which could lead to a motor current imbalance.</entry>
               </row>
               <row class="- topic/row " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="row:3;58:21">
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:7;59:26">
                     <codeblock xml:space="preserve" class="+ topic/pre pr-d/codeblock " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="codeblock:2;60:54">statorWinding</codeblock>
                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:8;62:26">Stator Winding</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:9;63:26">Problems in one of the phases of the motor, which could cause an imbalance of the motor currents.</entry>
               </row>
               <row class="- topic/row " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="row:4;65:21">
