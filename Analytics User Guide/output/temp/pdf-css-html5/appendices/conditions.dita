                     <codeblock xml:space="preserve" class="+ topic/pre pr-d/codeblock " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="codeblock:8;102:54">cooling</codeblock>
                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:26;104:26">Cooling System</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:27;105:26">Problems with fans attached to the shaft or externally attached to the motor.</entry>
               </row>
