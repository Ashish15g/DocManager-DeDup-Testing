                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:14;76:26">Motor Shaft/ Balance</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:15;77:26">Unequal distribution of mass, causing the center of gravity to shift from the center of rotation.</entry>
               </row>
               <row class="- topic/row " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="row:6;79:21">
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:16;80:26">
                     <codeblock xml:space="preserve" class="+ topic/pre pr-d/codeblock " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="codeblock:5;81:54">eccentricity</codeblock>
                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:17;83:26">Eccentricity</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:18;84:26">Asymmetric air gap between the rotor and stator.</entry>
               </row>
               <row class="- topic/row " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="row:7;86:21">
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:19;87:26">
                     <codeblock xml:space="preserve" class="+ topic/pre pr-d/codeblock " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="codeblock:6;88:54">bearing</codeblock>
                  </entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:20;90:26">Bearing</entry>
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:21;91:26">Mechanical stress or contamination leading to small cracks or defects that occur in the bearing, creating vibration problems.</entry>
               </row>
               <row class="- topic/row " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="row:8;93:21">
                  <entry class="- topic/entry " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/appendices/conditions.dita" xtrc="entry:22;94:26">
