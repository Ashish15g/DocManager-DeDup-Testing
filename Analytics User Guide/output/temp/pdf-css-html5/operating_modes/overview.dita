            <title class="- topic/title " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/operating_modes/overview.dita" xtrc="title:2;29:20">The SMS Communicating with the Cloud</title>
            <image href="../media/image4.png" placement="break" height="239" width="602" class="- topic/image " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/operating_modes/overview.dita" xtrc="image:1;30:90">
               <alt class="- topic/alt " xtrf="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/operating_modes/overview.dita" xtrc="alt:1;31:21">placeholder</alt>
