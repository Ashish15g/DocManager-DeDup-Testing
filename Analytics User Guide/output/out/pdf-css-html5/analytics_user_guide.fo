                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                magnetic field FFT graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the magnetic field FFT
                                                  graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can
                                                  hover on a section of the magnetic field FFT graph
                                                  to view the magnetic field FFT dB in decibels
                                                  (dB), the frequency in Hertz (Hz), and the time
                                                  frame.</fo:block></fo:block-container>
                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e9130"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 52</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Image63</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="303px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image63.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="303px"/></fo:inline></fo:block></fo:block-container>
