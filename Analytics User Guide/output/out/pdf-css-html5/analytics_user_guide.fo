                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_57_Connect_42_ul_10211523" chfox:nd-id="ul_10211523">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The graph’s X-axis shows the time in
                                                  seconds.</fo:block></fo:list-item-body></fo:list-item>
