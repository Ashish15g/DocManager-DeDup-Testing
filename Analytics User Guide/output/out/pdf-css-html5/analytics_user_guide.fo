                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_1" xml:lang="en-us" chfox:nd-id="audience"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title1"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Audience</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 1 - <!--content(text)--><fo:inline>Audience</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 1 - <!--content(text)--><fo:inline>Audience</fo:inline></fo:marker><fo:inline>Chapter 1. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1728"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1732"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1736"/><fo:inline>Audience</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The analytics user
                                    guide is intended for users interested in predictive maintenance
                                    analytics.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The analytics user guide is intended for users interested in
                                    predictive maintenance analytics.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en-us"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en-us"><fo:block-container space-before="1em" role="Sect" id="unique_2" xml:lang="en-us" chfox:nd-id="introduction"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title2"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 2 - <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 2 - <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:inline>Chapter 2. </fo:inline><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1793"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1797"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1801"/><fo:inline>Introduction</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The ADI OtoSense™
                                    Smart Motor Sensor (SMS) performs predictive maintenance on
                                    low-voltage 3-phase induction motors.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The ADI OtoSense™ Smart Motor Sensor (SMS) performs predictive
                                    maintenance on low-voltage 3-phase induction motors. It is a
                                    complete, easy-to-setup hardware and software solution that uses
                                    advanced sensors and AI-based data analysis to:</fo:block></fo:block-container>
                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_2_Connect_42_ul_102114" chfox:nd-id="ul_102114">
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>provide
                                        round-the-clock condition-based monitoring of motor’s
                                        health. For example, power system, motor shaft balance, and
                                        overall performance issues.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>provide fault
                                        notifications.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>deliver
                                        electrical, mechanical, and thermal health diagnostics with
                                        severity levels</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>recommend
                                        solutions for identified motor and performance issues.</fo:block></fo:list-item-body></fo:list-item>
                                </fo:list-block>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_3" xml:lang="en-us" chfox:nd-id="benefits">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title3"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1873"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1877"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1881"/><fo:inline>Benefits</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                        describes the benefits provided by the SMS.</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                section describes the benefits provided by the
                                                SMS.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The SMS
                                                translates the collected data into actionable
                                                insights. Here are some of the benefits of using the
                                                SMS:</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:inline font-weight="bold">Non-intrusive Installation</fo:inline>: The SMS can
                                                be attached to active motors, ensuring continuous
                                                operation.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:inline font-weight="bold">Enhanced Plant Efficiency</fo:inline>: The SMS
                                                monitors the health of a motor’s components and
                                                sends alerts about anomalies and degradation that
                                                can lead to faults, enabling efficient maintenance
                                                planning and reducing unexpected breakdowns.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:inline font-weight="bold">Secure
                                                  Motor Data</fo:inline>: The SMS safely stores the
                                                motor data on the ADI OtoSense™ Server.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:inline font-weight="bold">Better
                                                  Inventory Management</fo:inline>: The SMS assists in
                                                identifying the required spare components, thereby
                                                assisting in minimizing surplus inventory and
                                                expenditure.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:inline font-weight="bold">Reduced Maintenance Costs</fo:inline>: The SMS helps
                                                extend motor life by providing maintenance insights
                                                that reduce repair costs and downtime.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_4" xml:lang="en-us" chfox:nd-id="how_does_otosense_work">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title4"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1989"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1993"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e1997"/><fo:inline>How does OtoSense ™ work?</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                        describes how the OtoSense ™ system works.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This section
                                        describes how the OtoSense ™ system works.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The hardware and
                                        software system consists of the following components:</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_4_Connect_42_ul_10211401" chfox:nd-id="ul_10211401">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The
                                            SMS</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Expert
                                            health monitoring software hosted on the ADI OtoSense™
                                            Server</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Mobile and
                                            web applications that allow customers to monitor the
                                            status of motors fitted with an SMS</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">After an SMS is
                                        configured and installed on a motor, it begins sending data
                                        to the ADI OtoSense™ server, which then begins a learning
                                        process where a unique, customized model is created for that
                                        particular motor. It measures the multi-axis vibration,
                                        magnetic field, ambient temperature, and temperature
                                        condition of the motor. With the help of this data, motor
                                        health degradation can be detected that could lead to motor
                                        faults in the power system, stator winding, rotor, motor
                                        shaft/balance, eccentricity, bearing, alignment, cooling
                                        system, attachment (i.e. loose foot), and overall motor
                                        performance.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_5" xml:lang="en-us" chfox:nd-id="access_sms_mobile_application">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title5"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e2073"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e2077"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e2081"/><fo:inline>Access SMS mobile
                                    application</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">To access the
                                        SMS mobile application, you can use a smartphone or a tablet
                                        with</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To access the
                                            SMS mobile application, you can use a smartphone or a
                                            tablet with an Android or iOS operating system.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Note<fo:inline font-weight="bold">:</fo:inline> You cannot use a
                                            Windows tablet.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The following
                                            OS versions are compatible with the SMS mobile app:</fo:block></fo:block-container>
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_5_Connect_42_ul_10211402" chfox:nd-id="ul_10211402">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Android: OS6.0 or later</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>iOS13
                                                or later</fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To download
                                            the SMS mobile app:</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_5_Connect_42_steps_10211403" chfox:nd-id="steps_10211403">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>Scan the respective QR code
                                                  from your mobile phone’s camera.</fo:inline>
                                                <fo:block>
                                                  <fo:block>
                                                  <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="black" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column/><fo:table-column/><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container height="97px" space-after="1em" max-width="100%" space-after.conditionality="retain" width="100px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image1.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="100px" content-height="97px"/></fo:inline></fo:block></fo:block-container>
                                                  Figure a: QR code for iOS devices</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container height="98px" space-after="1em" max-width="100%" space-after.conditionality="retain" width="100px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image2.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="100px" content-height="98px"/></fo:inline></fo:block></fo:block-container>
                                                  Figure b: QR code for Android devices</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                                  </fo:block>
                                                </fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Install the ADI OtoSense™ SMS
                                                  app from the App Store or from Google Play.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Follow the on-screen
                                                  instructions to complete the installation and open
                                                  the app.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Author%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Note:</fo:block> If you have
                                            previously signed up on the web application, you can use
                                            the same login credentials to sign in to the mobile
                                            app.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If this is
