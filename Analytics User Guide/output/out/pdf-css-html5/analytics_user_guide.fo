                                                  <fo:block-container height="190px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image59.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="190px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Figure 17 and shows the 2.4
                                                  second sample of the waveform data from the
                                                  magnetic field sensor at 5 minutes 20 seconds
                                                  (<fo:block-container height="11px" space-after="1em" max-width="100%" width="38px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image60.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="38px" content-height="11px"/></fo:inline></fo:block></fo:block-container>).</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  </fo:list-block>
                                                  <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_78_Connect_42_ul_10211536" chfox:nd-id="ul_10211536">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The graph’s X-axis shows the time in
                                                  seconds.</fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The graph’s Y-Axis shows the magnetic field
                                                  waveform in millivolt (mV) at 6.25 kHz sample
                                                  frequency.</fo:block></fo:list-item-body></fo:list-item>
                                                  </fo:list-block>
                                                  <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
