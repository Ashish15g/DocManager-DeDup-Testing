                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title29"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5266"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5270"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5274"/><fo:inline>vibx</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The Vibration X (vibx) is
                                                  the vibration acceleration measured in the
                                                  tangential direction of the</fo:block></fo:block-container>
                                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Vibration X (vibx) is the vibration acceleration
                                                  measured in the tangential direction of the motor.
                                                  This recorded data shows the vibration X waveform
                                                  data, in the unit of metre per second squared
                                                  (m/s2).</fo:block></fo:block-container>
                                                  <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Each
                                                  record contains an array of 15,000 samples
                                                  captured on the specified timestamp.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  X-axis data is a vector of 15,000 data points with
                                                  a step of 0.00016s.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For
                                                  example:</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">[0,
                                                  0.00016, 0.00032, 0.00048, .... 2.39984]</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  following two datasets, vibration Z (vibz) and
                                                  magnetic field (flux), also use the same time
                                                  stamp to generate the waveform graphic. All 3
                                                  datasets, vibx, vibz</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For more
                                                  information on API refer to the ADI OtoSense ™ SMS
                                                  REST API.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  </fo:list-block>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block>
                                    </fo:block>
                                </fo:block>
                                <fo:block role="Sect" id="unique_41" xml:lang="en-us" chfox:nd-id="vibration_x_axis_fft_db">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title30"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5369"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5373"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5377"/><fo:inline>Vibration X-axis FFT dB</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration X-axis FFT. It is generated from
                                            data received by the</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration X-axis FFT. It is generated from
                                            data received by the ADI OtoSense™ Server from the
                                            vibration X-axis sensor on the SMS.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect" id="unique_42" xml:lang="en-us" chfox:nd-id="access_the_vibration_x_axis_fft_db">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title31"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5434"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5438"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5442"/><fo:inline>Access the Vibration X-axis FFT
                                                dB</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                process of accessing the Vibration X-axis FFT
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the process of accessing the
                                                  Vibration X-axis FFT graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To
                                                  access the Vibration X-axis FFT dB through the
                                                  application:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                            <fo:block role="Sect">
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_42_Connect_42_steps_10211511" chfox:nd-id="steps_10211511">
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Motors</fo:inline>.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Locations list is displayed.</fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select the location
                                                  associated with the motor.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>From the subsequent screens,
                                                  select the corresponding process, plant, and motor
                                                  name.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select <fo:inline font-weight="bold">History Plot</fo:inline> and <fo:inline font-weight="bold">Parameters</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Vibration</fo:inline> to select <fo:inline font-weight="bold">Vibration X FFT</fo:inline>
                                                  <fo:inline font-weight="bold">dB</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Date</fo:inline> and <fo:inline font-weight="bold">Select
                                                  Time</fo:inline> to select the date and time
                                                  corresponding to the moment of the
                                                  installation.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You
                                                  should see the corresponding waveform as shown in
                                                  <fo:inline>Figure
                                                  15<fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_43"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_43"><fo:page-number-citation ref-id="unique_43"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_43">)</fo:basic-link></fo:inline></fo:inline>.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e5540"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 29</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen showing the
                                                  Vibration X FFT
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="298px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image35.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="298px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Click <fo:inline font-weight="bold">DATA
                                                  DOWNLOAD</fo:inline>to download the generated
                                                  data.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block>
                                        </fo:block></fo:block-container>
                                    </fo:block>
                                    <fo:block role="Sect" id="unique_44" xml:lang="en-us" chfox:nd-id="data_visualization_2">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title32"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5606"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5610"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5614"/><fo:inline>Data Visualization</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                Vibration X-axis FFT graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                section describes the Vibration X-axis FFT
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can
                                                hover on a section of the Vibration X FFT dB graph
