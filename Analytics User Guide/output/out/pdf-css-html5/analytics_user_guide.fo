                                <fo:block role="Sect" id="unique_53" xml:lang="en-us" chfox:nd-id="vibration_z_axis_time_waveform">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title40"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6359"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6363"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6367"/><fo:inline>Vibration Z-axis Time
                                            Waveform</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration Z-axis time waveform. It is
                                            generated from data received by</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration Z-axis time waveform. It is
                                            generated from data received by the ADI OtoSense™ Server
                                            from the vibration Z-axis sensor on the SMS.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect" id="unique_54" xml:lang="en-us" chfox:nd-id="access_the_vibration_z_axis_time_waveform">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title41"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6424"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6428"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6432"/><fo:inline>Access the Vibration Z-axis
                                                Time Waveform</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                process of accessing the Vibration Z-axis time
                                                waveform graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the process of accessing the
                                                  Vibration Z-axis time waveform graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To
                                                  access the Vibration Z-axis Time Waveform through
                                                  the application:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                            <fo:block role="Sect">
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_54_Connect_42_steps_10211519" chfox:nd-id="steps_10211519">
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Motors</fo:inline>.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Locations list is displayed.</fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select the location
                                                  associated with the motor.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>From the subsequent screens,
                                                  select the corresponding process, plant, and motor
                                                  name.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select <fo:inline font-weight="bold">History Plot</fo:inline> and <fo:inline font-weight="bold">Parameters</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Vibration</fo:inline> to select <fo:inline font-weight="bold">Vibration</fo:inline>
                                                  <fo:inline font-weight="bold">Z time
                                                  waveform</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Date</fo:inline> and <fo:inline font-weight="bold">Select
                                                  Time</fo:inline> to select the date and time
                                                  corresponding to the moment of the
                                                  installation.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You
                                                  should see the corresponding waveform as shown in
                                                  <fo:inline>Figure
                                                  21<fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_55"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_55"><fo:page-number-citation ref-id="unique_55"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_55">)</fo:basic-link></fo:inline></fo:inline>.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e6530"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 35</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen showing the
                                                  Vibration Z time
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="298px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image41.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="298px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Click <fo:inline font-weight="bold">DATA
                                                  DOWNLOAD</fo:inline>to download the generated
                                                  data.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block>
                                        </fo:block></fo:block-container>
                                    </fo:block>
                                    <fo:block role="Sect" id="unique_56" xml:lang="en-us" chfox:nd-id="data_visualization_4">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title42"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6596"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6600"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6604"/><fo:inline>Data Visualization</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                Vibration Z-axis time waveform graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                section describes the Vibration Z-axis time waveform
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can
                                                hover on a section of the Vibration Z time waveform
                                                graph to view the Vibration Z waveform value in
                                                metre per second squared (m/s2), the time in
                                                seconds, and the time frame.</fo:block></fo:block-container>
                                            <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e6624"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 36</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen highlighting
                                                  one data point of the Vibration Z time
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="299px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image42.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="299px"/></fo:inline></fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
