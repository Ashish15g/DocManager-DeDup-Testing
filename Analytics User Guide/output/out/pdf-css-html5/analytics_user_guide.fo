                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                API dataset used for the environment temperature
                                                scatter plot.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the API dataset used for the
                                                  environment temperature scatter plot.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The REST
                                                  APIs have access to the following dataset:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_100" xml:lang="en-us" chfox:nd-id="tempe">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title79"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10451"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10455"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10459"/><fo:inline>tempe</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The Environmental
                                                  Temperature (tempe) is the temperature of the
                                                  motor’s surrounding area. There are two</fo:block></fo:block-container>
                                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Environmental Temperature (tempe) is the
                                                  temperature of the motor’s surrounding area. There
                                                  are two temperature sensors on both sides of the
                                                  SMS: the temperature sensor on the outside side
                                                  (not towards the motor) measures the environment
                                                  temperature.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  recorded data shows the environmental temperature
                                                  scatter plot data, in the unit of Celsius (°C).
                                                  The analytics system can use this data to detect
                                                  the electrical or mechanical failures of the
                                                  motor.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Each
                                                  record contains an array of two samples captured
                                                  on the specified timestamp.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For more
                                                  information on API refer to the ADI OtoSense™ SMS
                                                  REST API.</fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block>
                                    </fo:block>
                                </fo:block>
