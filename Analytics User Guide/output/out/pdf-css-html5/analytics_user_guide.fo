                                                  same sample graph.</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="206px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image61.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="206px"/></fo:inline></fo:block></fo:block-container>
