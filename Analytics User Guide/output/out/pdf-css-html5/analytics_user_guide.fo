                                    <fo:block role="Sect" id="unique_58" xml:lang="en-us" chfox:nd-id="api_dataset_3">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title44"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6817"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6821"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6825"/><fo:inline>API Dataset</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                API dataset used for the vibration Z-axis time
                                                waveform graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the API dataset used for the
                                                  vibration Z-axis time waveform graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The REST
                                                  APIs have access to the following dataset:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_59" xml:lang="en-us" chfox:nd-id="_Ref182996638">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title45"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6887"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6891"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6895"/><fo:inline>vibz</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The Vibration Z (vibz) is
                                                  the vibration acceleration measured in the axial
                                                  direction of the</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Vibration Z (vibz) is the vibration acceleration
                                                  measured in the axial direction of the motor. This
                                                  recorded data shows the vibration Z waveform data,
                                                  in the unit of metre per second squared (m/s2).
                                                  With the vibrations X and Z measured from the
                                                  motor, the analytics system can detect the
                                                  mechanical failures of the motor.</fo:block></fo:block-container>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Each
                                                  record contains an array of 15,000 samples
                                                  captured on the specified timestamp.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">It is
                                                  necessary to generate the corresponding X-axis
                                                  data to plot this Vibration Z (vibx) waveform data
                                                  in a graphic: The X-axis data is a vector of
                                                  15,000 data points with a step of 0.00016s.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For
                                                  example:</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">[0,
                                                  0.00016, 0.00032, 0.00048, .... 2.39984]</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For more
                                                  information on API refer to the ADI OtoSense™ SMS
                                                  REST API.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block></fo:block-container>
                                        </fo:block>
                                    </fo:block>
                                </fo:block>
                                <fo:block role="Sect" id="unique_60" xml:lang="en-us" chfox:nd-id="vibration_z_axis_fft_db">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title46"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6982"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6986"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e6990"/><fo:inline>Vibration Z-axis FFT dB</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration Z-axis FFT. It is generated from
                                            data received by the</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the Vibration Z-axis FFT. It is generated from
                                            data received by the ADI OtoSense™ Server from the
                                            vibration Z-axis sensor on the SMS.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect" id="unique_61" xml:lang="en-us" chfox:nd-id="access_the_vibration_z_axis_fft_db">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title47"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7047"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7051"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7055"/><fo:inline>Access the Vibration Z-axis FFT
                                                dB</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                process of accessing the Vibration Z-axis FFT
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the process of accessing the
                                                  Vibration Z-axis FFT graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To
                                                  access the Vibration Z-axis FFT dB through the
                                                  application:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                            <fo:block role="Sect">
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_61_Connect_42_steps_10211524" chfox:nd-id="steps_10211524">
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Motors</fo:inline>.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Locations list is displayed.</fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select the location
                                                  associated with the motor.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>From the subsequent screens,
                                                  select the corresponding process, plant, and motor
                                                  name.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select <fo:inline font-weight="bold">History Plot</fo:inline> and <fo:inline font-weight="bold">Parameters</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Vibration</fo:inline> to select <fo:inline font-weight="bold">Vibration Z FFT</fo:inline>
                                                  <fo:inline font-weight="bold">dB</fo:inline>.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select
                                                  Date</fo:inline> and <fo:inline font-weight="bold">Select
                                                  Time</fo:inline> to select the date and time
                                                  corresponding to the moment of the
                                                  installation.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You
                                                  should see the corresponding waveform as shown in
                                                  <fo:inline>Figure
                                                  26<fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_62"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_62"><fo:page-number-citation ref-id="unique_62"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_62">)</fo:basic-link></fo:inline></fo:inline>.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e7153"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 39</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen showing the
                                                  Vibration Z FFT
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="303px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image46.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="303px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Click <fo:inline font-weight="bold">DATA
                                                  DOWNLOAD</fo:inline>to download the generated
                                                  data.</fo:inline>
                                                  </fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block>
                                        </fo:block></fo:block-container>
                                    </fo:block>
                                    <fo:block role="Sect" id="unique_63" xml:lang="en-us" chfox:nd-id="data_visualization_5">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title48"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7219"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7223"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7227"/><fo:inline>Data Visualization</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                Vibration Z-axis FFT graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                section describes the Vibration Z-axis FFT
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can
                                                hover on a section of the Vibration Z FFT dB graph
                                                to view the Vibration Z FFT dB value in decibels
                                                (dB), the frequency in Hertz (Hz), and the time
                                                frame as shown in <fo:inline>Figure
                                                  27<fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_64"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_64"><fo:page-number-citation ref-id="unique_64"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_64">)</fo:basic-link></fo:inline></fo:inline>.</fo:block></fo:block-container>
                                            <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e7251"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 40</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen highlighting
                                                  one data point of the Vibration Z FFT
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="300px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image47.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="300px"/></fo:inline></fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_65" xml:lang="en-us" chfox:nd-id="sample_data_5">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title49"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7306"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7310"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7314"/><fo:inline>Sample Data</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">2.4 seconds sample of the
                                                  Vibration Z FFT waveform placeholder</fo:block></fo:block-container>
                                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e7328"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 41</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>2.4 seconds sample of the
                                                  Vibration Z FFT
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="191px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image48.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="191px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Figure 28 shows the 2.4
                                                  second sample of the Fast Fourier Transform data
                                                  from the Z-axis sensor at 5 minutes 19 seconds
                                                  (<fo:block-container height="8px" space-after="1em" max-width="100%" width="38px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image49.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="38px" content-height="8px"/></fo:inline></fo:block></fo:block-container>).</fo:block></fo:block-container>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_65_Connect_42_ul_10211527" chfox:nd-id="ul_10211527">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The graph’s X-axis shows the frequency in
                                                  Hertz.</fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The graph’s Y-Axis shows the Fast Fourier
                                                  Transform data in decibels.</fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block></fo:block-container>
                                        </fo:block>
                                    </fo:block>
                                    <fo:block role="Sect" id="unique_66" xml:lang="en-us" chfox:nd-id="api_dataset_4">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title50"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7402"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7406"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7410"/><fo:inline>API Dataset</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section describes the
                                                API dataset used for the vibration Z-axis FFT
                                                graph.</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                  section describes the API dataset used for the
                                                  vibration Z-axis FFT graph.</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The REST
                                                  APIs have access to the following dataset:</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_67" xml:lang="en-us" chfox:nd-id="_Ref182996929">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title51"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7472"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7476"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e7480"/><fo:inline>vibzFFT</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The Vibration Z FFT
                                                  (vibzFFT) is the vibration amplitude measured in
                                                  the axial direction of</fo:block></fo:block-container>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Vibration Z FFT (vibzFFT) is the vibration
                                                  amplitude measured in the axial direction of the
                                                  motor. The recorded data is the result of the FFT
                                                  transformation of the vibration signal Z, in the
                                                  unit of decibels (dB).</fo:block></fo:block-container>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Each
                                                  record contains an FFT of the vibz samples
                                                  captured on the specified timestamp.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">It is
                                                  necessary to generate the corresponding X-axis
                                                  data to plot this vibzFFT data in a graphic. The
                                                  X-axis data is a vector of 7,500 data points with
                                                  a step of 0.41667 Hertz (Hz).</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
