                                <fo:block role="Sect" id="unique_27" xml:lang="en-us" chfox:nd-id="access_the_health_index_historical_data">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title19"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4039"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4043"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4047"/><fo:inline>Access the Health Index Historical
                                            Data</fo:inline></fo:block></fo:block-container>
                                    
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This section
                                            describes the process of accessing the health index
                                            historical data.</fo:block></fo:block-container>
                                        <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This
                                                section describes the process of accessing the
                                                health index historical data.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To access
                                                the Health Index Historical Data through the web and
                                                mobile application:</fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect">
                                            <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_27_Connect_42_steps_10211502" chfox:nd-id="steps_10211502">
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Motors</fo:inline>.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Locations list is displayed.</fo:block></fo:block-container>
                                                  </fo:block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select the location
                                                  associated with the motor.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>From the subsequent screens,
                                                  select the corresponding process, plant, and motor
                                                  name.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Select <fo:inline font-weight="bold">History plot</fo:inline>and<fo:inline font-weight="bold">Health</fo:inline>.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Tap <fo:inline font-weight="bold">Select</fo:inline>
                                                  <fo:inline font-weight="bold">…</fo:inline> to select <fo:inline font-weight="bold">Performance</fo:inline>.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Click <fo:inline font-weight="bold">DRAW
                                                  PLOT</fo:inline>.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">You should see the
                                                  corresponding scatter plot as shown in <fo:inline>Figure
                                                  10<fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_28"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_28"><fo:page-number-citation ref-id="unique_28"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " external-destination="unique_28">)</fo:basic-link></fo:inline></fo:inline>.<fo:block-container height="286px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image26.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="286px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  scatter plot has a legend at the bottom with
                                                  element and its corresponding motor attribute.</fo:block></fo:block-container>
                                                  </fo:block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Click <fo:inline font-weight="bold">DATA
                                                  DOWNLOAD</fo:inline>to download the generated
                                                  data.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block>
                                        </fo:block>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect" id="unique_29" xml:lang="en-us" chfox:nd-id="sample_health_index_historical_data">
                                        <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H4" id="ariaid-title20"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4205"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4209"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e4213"/><fo:inline>Sample Health Index Historical
                                                Data</fo:inline></fo:block></fo:block-container>
                                        
                                        <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Figure 10 shows the Health
                                                Index Historical Data as a scatter plot generated by
                                                analysing</fo:block></fo:block-container>
                                            <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Figure
                                                  10 shows the Health Index Historical Data as a
                                                  scatter plot generated by analysing the data
                                                  received from the SMS by the ADI OtoSense™
                                                  Server.</fo:block></fo:block-container>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_29_Connect_42_ul_10211505" chfox:nd-id="ul_10211505">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The scatter plot’s <fo:inline font-weight="bold">X-axis</fo:inline> shows the 1-10 scale of the
                                                  Health Index.</fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The scatter plot’s <fo:inline font-weight="bold">Y-axis</fo:inline> shows all dates between 01
                                                  September 2024 and 10 November 2024.</fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">The <fo:block-container height="19px" space-after="1em" max-width="100%" width="17px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image27.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="17px" content-height="19px"/></fo:inline></fo:block></fo:block-container>icon
                                                  is a data point for the Performance parameter of
                                                  the motor.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">You can hover on each data
                                                  point (<fo:block-container height="19px" space-after="1em" max-width="100%" width="17px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image27.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="17px" content-height="19px"/></fo:inline></fo:block></fo:block-container>)
                                                  to view the health index value, date, and
                                                  time.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e4273"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 22</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Image28</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="216px" space-after="1em" max-width="100%" width="675px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image28.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="675px" content-height="216px"/></fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can
                                                  analyse the clusters and outliers to better
                                                  understand the underlying issues.</fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For
                                                  example, data points that fall below 5 on the
                                                  health index should be further analysed and
                                                  appropriate action should be taken.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
