                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d549e5634"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 30</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Dashboard screen highlighting
                                                  one data point of the Vibration X FFT
                                                  waveform</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="299px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image36.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="299px"/></fo:inline></fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_45" xml:lang="en-us" chfox:nd-id="sample_data_2">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title33"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5689"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5693"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e5697"/><fo:inline>Sample Data</fo:inline></fo:block></fo:block-container>
                                            
