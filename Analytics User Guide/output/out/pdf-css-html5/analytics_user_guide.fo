                                                  one data point of the Motor temperature scatter
                                                  plot</fo:inline></fo:inline></fo:block>
                                                  <fo:block-container height="302px" space-after="1em" max-width="100%" width="602px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image72.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="602px" content-height="302px"/></fo:inline></fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect" id="unique_105" xml:lang="en-us" chfox:nd-id="sample_data_11">
                                            <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H5" id="ariaid-title83"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10847"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10851"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d549e10855"/><fo:inline>Sample Data</fo:inline></fo:block></fo:block-container>
                                            
                                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Sample of the Motor
                                                  Temperature scatter plot placeholder</fo:block></fo:block-container>
                                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
