                                                  <fo:block-container height="69px" space-after="1em" max-width="100%" width="156px"><fo:block end-indent="0" start-indent="0"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Analytics%20User%20Guide/output/media/image21.png" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="156px" content-height="69px"/></fo:inline></fo:block></fo:block-container>
