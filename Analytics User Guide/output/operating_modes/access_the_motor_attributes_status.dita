<task id="access_the_motor_attributes_status" xml:lang="en-us">
   <title>Access the Motor Attributes’ Status</title>
   <shortdesc>This section describes the process of accessing the motor attributes’ status.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Motor</keyword>
        <keyword>motor</keyword>
        <keyword>status</keyword>
        <keyword>attributes</keyword>
        <keyword>Access</keyword>
        <keyword>Attributes</keyword>
        <indexterm>Motor</indexterm>
        <indexterm>motor</indexterm>
        <indexterm>status</indexterm>
