      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>This section describes the process of accessing the motor attributes’ status.</p>
         <p>To access the status of the motor attributes through the web and mobile application:</p>
      </context>
      <steps id="steps_102115">
         <step>
            <cmd>Tap <b>Motors</b>.</cmd>
            <info>
               <p>The Locations list is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select the location associated with the motor.</cmd>
         </step>
         <step>
            <cmd>From the subsequent screens, select the corresponding process, plant, and motor name.</cmd>
         </step>
         <step>
            <cmd>Select <b>Motor</b>
               <b>s</b>
               <b>tatus</b>.</cmd>
         </step>
         <step>
            <cmd>The motor condition attributes are displayed in the <b>Motor status</b> table as seen below.</cmd>
         </step>
      </steps>
      <result>
         <p>
            <fig>
               <title>Dashboard screen showing the Motor status</title>
               <image height="513" href="../media/image22.jpg" placement="break" width="602">
                  <alt>placeholder</alt>
               </image>
            </fig>
         </p>
      </result>
   </taskbody>
