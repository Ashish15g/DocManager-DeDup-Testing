<task id="access_the_health_index_historical_data" xml:lang="en-us">
   <title>Access the Health Index Historical Data</title>
   <shortdesc>This section describes the process of accessing the health index historical data.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Health</keyword>
        <keyword>Index</keyword>
        <keyword>Historical</keyword>
        <keyword>Data</keyword>
        <keyword>Select</keyword>
        <keyword>motor</keyword>
        <indexterm>Health</indexterm>
        <indexterm>Index</indexterm>
        <indexterm>Historical</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>This section describes the process of accessing the health index historical data.</p>
         <p>To access the Health Index Historical Data through the web and mobile application:</p>
      </context>
      <steps id="steps_10211502">
         <step>
            <cmd>Tap <b>Motors</b>.</cmd>
            <info>
               <p>The Locations list is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select the location associated with the motor.</cmd>
         </step>
         <step>
            <cmd>From the subsequent screens, select the corresponding process, plant, and motor name.</cmd>
         </step>
         <step>
            <cmd>Select <b>History plot</b>and<b>Health</b>.</cmd>
         </step>
         <step>
            <cmd>Tap <b>Select</b>
               <b>…</b> to select <b>Performance</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>DRAW PLOT</b>.</cmd>
            <info>
               <p>You should see the corresponding scatter plot as shown in <xref href="#Figure10">Figure 10</xref>.<image height="286" href="../media/image26.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </p>
               <p>The scatter plot has a legend at the bottom with element and its corresponding motor attribute.</p>
            </info>
         </step>
         <step>
            <cmd>Click <b>DATA DOWNLOAD</b>to download the generated data.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
