<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="AboutXAuthorMigrationManagerKeyTerminology" xml:lang="en">
   <title>Key Terminology</title>
   <conbody>
      <p>It is important to understand how terms are used when working with Apttus X-Author Contracts.</p>
      <p>
         <table>
            <tgroup cols="2">
               <colspec colname="col1"/>
               <colspec colname="col2"/>
               <thead>
                  <row>
                     <entry>
                        <p>Term</p>
                     </entry>
                     <entry>
                        <p>Definition</p>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <p>Template</p>
                     </entry>
                     <entry>
                        <p>Blueprints to generate a variety of document types when merged with data from quote/ proposal, or agreement, or billing records.</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>FX2</p>
                     </entry>
                     <entry>
                        <p>FX2 is a type of template framework with advanced features.</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>Pre-FX2</p>
                     </entry>
                     <entry>
                        <p>Pre-FX2 refers to the framework used for creating templates before FX2 framework was implemented. In the pre-FX2 framework, templates only supported merge fields.</p>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </p>
   </conbody>
</concept>