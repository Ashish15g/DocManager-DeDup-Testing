<task id="to_create_a_display_action_103f4d" xml:lang="en-us">
   <title>To create a Display Action</title>
   <shortdesc>Rakesh Singh Click the lower section of the Actions button and select Display .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Display</keyword>
        <keyword>Action</keyword>
        <keyword>select</keyword>
        <keyword>Click</keyword>
        <keyword>display</keyword>
        <keyword>create</keyword>
        <indexterm>Display</indexterm>
        <indexterm>Action</indexterm>
        <indexterm>select</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the lower section of the Actions button and select <b>Display</b>.
</cmd>
         </step>
         <step>
            <cmd>In the Action Name field, enter a name for your Display Action. Use a name that describes the records to display.</cmd>
            <info>
               <fig>
                  <title>190354470</title>
                  <image href="../attachments/98667691/190354470.png" width="386" height="224" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click the drop-down next to Display Map to select the Display Map to use.</cmd>
         </step>
         <step>
            <cmd>To disable excel events while performing display actions, select the <b>Disable Excel Events during execution</b> checkbox.</cmd>
         </step>
         <step>
            <cmd>To <xref href="#displayactionqueryfilter">display query filters in the worksheet</xref>, select the <b>Show Query Filters</b> checkbox.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save.</b>
            </cmd>
         </step>
      </steps>
   </taskbody>
</task>