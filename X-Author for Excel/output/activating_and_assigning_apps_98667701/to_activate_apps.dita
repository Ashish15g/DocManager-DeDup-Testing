<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_activate_apps_b27017" xml:lang="en-us">
   <title>To activate apps</title>
   <shortdesc>The app has been activated. Now you can assign it to users.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Click</keyword>
        <keyword>activate</keyword>
        <keyword>click</keyword>
        <keyword>Rakesh</keyword>
        <keyword>Singh</keyword>
        <keyword>Salesforce</keyword>
        <indexterm>Click</indexterm>
        <indexterm>activate</indexterm>
        <indexterm>click</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Log in to Salesforce.</cmd>
         </step>
         <step>
            <cmd>In the <xref href="http://Force.com" scope="external" format="html">Force.com</xref> app menu, click <b>X-Author for Excel</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Apps</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Edit</b> next to the newly created app.</cmd>
         </step>
         <step>
            <cmd>Click the <b>Activate</b> check box and click <b>Save</b>.</cmd>
         </step>
      </steps>
      <result>
         <p>The app has been activated. Now you can assign it to users.</p>
      </result>
   </taskbody>
</task>