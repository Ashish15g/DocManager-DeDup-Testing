<concept id="salesforce_package_licenses_ac78b2" xml:lang="en-us">
   <title>Salesforce Package Licenses</title>
     <shortdesc>The following table describes the minimum Salesforce package licenses required for specific X-Author roles. For</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Author</keyword>
        <keyword>Excel</keyword>
        <keyword>Salesforce</keyword>
        <keyword>required</keyword>
        <keyword>Package</keyword>
        <keyword>licenses</keyword>
        <indexterm>Author</indexterm>
        <indexterm>Excel</indexterm>
        <indexterm>Salesforce</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody><p>The following table describes the minimum Salesforce package licenses required for specific X-Author roles. For detailed information on required X-Author licenses and permissions, refer to <xref href="../getting_started_with_x_author_98667661/getting_started_with_xauthor_for_excel.dita">Getting Started with X-Author for Excel</xref>.</p>
<table>
         <tgroup cols="2">
            <colspec colname="c1"/>
            <colspec colname="c2"/>
            <thead>
               <row>
                  <entry>
                     <p>Role</p>
                  </entry>
                  <entry>
                     <p>Salesforce Package License</p>
                  </entry>
               </row>
            </thead>
            <tbody>
               <row>
                  <entry>
                     <p>Runtime User</p>
                  </entry>
                  <entry>
                     <p>X-Author for Excel</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Designer</p>
                  </entry>
                  <entry>
                     <p>X-Author for Excel, X-Author Designer for Excel</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Power Admin</p>
                  </entry>
                  <entry>
                     <p>X-Author for Excel, X-Author Designer for Excel, X-Author for Excel (Power Admin)</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Presto User</p>
                  </entry>
                  <entry>
                     <p>X-Author for Excel, Document Generation, X-Author for Excel Document Generation</p>
                  </entry>
               </row>
            </tbody>
         </tgroup>
      </table></conbody>
</concept>