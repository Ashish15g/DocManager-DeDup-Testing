<reference id="adding_rows_and_columns_to_a_matrix_6bc0d0" xml:lang="en-us">
   <title>Adding Rows and Columns to a Matrix</title>
   <shortdesc>Using the Add Matrix Row and Add Matrix Column buttons, you can add more data</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <critdates>
         <revised modified="Jan 30, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>Field</keyword>
        <keyword>Value</keyword>
        <keyword>Static</keyword>
        <keyword>Column</keyword>
        <keyword>Data</keyword>
        <keyword>Dynamic</keyword>
        <indexterm>Field</indexterm>
