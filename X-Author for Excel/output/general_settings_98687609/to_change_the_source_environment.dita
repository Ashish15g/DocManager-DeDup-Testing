<task id="to_change_the_source_environment_d0475e" xml:lang="en-us">
   <title>To change the source environment</title>
   <shortdesc>placeholder</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>source</keyword>
        <keyword>environment</keyword>
        <keyword>Click</keyword>
        <keyword>change</keyword>
        <keyword>Settings</keyword>
        <keyword>placeholder</keyword>
        <indexterm>source</indexterm>
        <indexterm>environment</indexterm>
        <indexterm>Click</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <b>Settings</b> and click <b>Settings</b> again.</cmd>
            <info>
               <fig>
                     <title>98687605</title>
                     <image href="../attachments/98687609/98687605.png" placement="break" width="1920" height="962">
                        <alt>placeholder</alt>
                     </image>
                  </fig></info>
         </step>
         <step>
            <cmd>Under General, to keep you session active, select Remember Me.</cmd>
         </step>
         <step>
            <cmd>From <b>Select CRM</b>, select the environment that you want to work with.</cmd>
         </step>
         <step>
            <cmd>Click <b>OK</b>. The following message appears.</cmd>
            <info>
               <fig>
                  <title>98687606</title>
                  <image href="../attachments/98687609/98687606.png" width="352" height="133" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click <b>OK</b>. Close all instances of excel and restart excel for the source changes to take effect.</cmd>
         </step>
      </steps>
   </taskbody>
</task>