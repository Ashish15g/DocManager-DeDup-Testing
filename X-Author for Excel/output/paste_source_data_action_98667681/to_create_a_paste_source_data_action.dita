<task id="to_create_a_paste_source_data_action_e2cc38" xml:lang="en-us">
   <title>To create a Paste Source Data action</title>
   <shortdesc>Rakesh Singh Click on the arrow beneath the Actions button and select Paste Source Data</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Source</keyword>
        <keyword>Paste</keyword>
        <keyword>Data</keyword>
        <keyword>action</keyword>
        <keyword>create</keyword>
        <keyword>Click</keyword>
        <indexterm>Source</indexterm>
        <indexterm>Paste</indexterm>
        <indexterm>Data</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click on the arrow beneath the Actions button and select <b>Paste Source Data</b>. The Paste Source Data window opens. </cmd>
         </step>
         <step>
            <cmd>In the Name field, type a descriptive name for the action.</cmd>
         </step>
         <step>
            <cmd>To automatically paste the data from the source file when called from the Action Flow, select the <b>Input Source File at Runtime</b> check box.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save</b>.</cmd>
