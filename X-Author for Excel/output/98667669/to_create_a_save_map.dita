<task id="to_create_a_save_map_6a44e9" xml:lang="en-us">
   <title>To create a Save Map</title>
   <shortdesc>Rakesh Singh Example Click Save Maps and select Create .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
        <keyword>Save</keyword>
        <keyword>Click</keyword>
        <keyword>create</keyword>
        <keyword>select</keyword>
        <keyword>Rakesh</keyword>
        <keyword>Singh</keyword>
        <indexterm>Save</indexterm>
        <indexterm>Click</indexterm>
        <indexterm>create</indexterm>
      </keywords>
      <prodinfo>
            <prodname>Example</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <b>Save Maps</b> and select <b>Create</b>.</cmd>
         </step>
         <step>
            <cmd>In the Name field, enter <i>Main</i>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Add Display Map Fields</b> and select <i>Amount</i> and <i>Stage</i>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Apply</b> and then click <b>Close</b> for the Save Map.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>