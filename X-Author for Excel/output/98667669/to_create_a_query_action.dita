<task id="to_create_a_query_action_b8ee74" xml:lang="en-us">
   <title>To create a Query Action</title>
   <shortdesc>Salesforce Object and Field</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
