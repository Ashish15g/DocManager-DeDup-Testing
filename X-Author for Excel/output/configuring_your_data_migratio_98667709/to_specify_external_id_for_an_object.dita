<task id="to_specify_external_id_for_an_object_8e703a" xml:lang="en-us">
   <title>To specify External ID for an Object</title>
   <shortdesc>Rakesh Singh From the Data Migration screen, click Not Set under the "External ID" column</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>External</keyword>
        <keyword>Object</keyword>
        <keyword>specify</keyword>
        <keyword>Data</keyword>
        <keyword>Migration</keyword>
        <keyword>placeholder</keyword>
        <indexterm>External</indexterm>
        <indexterm>Object</indexterm>
        <indexterm>specify</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>From the Data Migration screen, click <u>
                  <b>Not Set</b>
               </u> under the "External ID" column corresponding to the Object you want to set.</cmd>
            <info>
               <fig>
                  <title>98667962</title>
                  <image href="../attachments/98667709/98667962.png" width="441" height="237" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Using your cursor, highlight the correct External ID field to use for your Object. </cmd>
         </step>
         <step>
            <cmd>Click <b>Apply</b>. The chosen External ID is updated in the Data Migration Object listing.</cmd>
            <info>
               <fig>
                  <title>98667963</title>
                  <image href="../attachments/98667709/98667963.png" width="438" height="233" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
      </steps>
   </taskbody>
</task>