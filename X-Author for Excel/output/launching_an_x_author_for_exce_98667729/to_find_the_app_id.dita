      <steps>
         <step>
            <cmd>Go to <b>Marketing &gt; Apps </b>to display the X-Author view in Dynamics that lists all the X-Author apps stored in your org.</cmd>
         </step>
         <step>
            <cmd>Click on the Application Name to view its details.</cmd>
            <info>
               <fig>
