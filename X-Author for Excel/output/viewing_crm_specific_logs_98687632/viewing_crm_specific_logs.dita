        <indexterm>Logs</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>  <context>
    <p>This section displays all the CRM specific logs in the event of an error.</p><fig>
         <title>190354379</title>
         <image href="../attachments/98687632/190354379.png" width="1138" height="641" placement="break">
            <alt>placeholder</alt>
         </image>
      </fig><ul>
         <li>To view the log in page mode, click the page mode <image href="../attachments/98687632/98687629.png" placement="inline" width="31" height="31">
                  <alt>placeholder</alt>
               </image>
             icon.</li>
         <li>To view the log in scroll mode, click the scroll mode <image href="../attachments/98687632/98687628.png" placement="inline" width="31" height="31">
                  <alt>placeholder</alt>
               </image>
             icon.</li>
         <li>To zoom in and out, move the slider <fig>
               <title>98687627</title>
               <image href="../attachments/98687632/98687627.png" placement="break" width="185" height="24">
                  <alt>placeholder</alt>
               </image>
            </fig>.</li>
         <li>To search for a specific keyword in the log, click the search <image href="../attachments/98687632/98687626.png" placement="inline" width="31" height="31">
                  <alt>placeholder</alt>
               </image>
             icon.</li>
         <li>To open and view the log file in Notepad, click <b>Open File</b>.</li>
         <li>To clear log files, click <b>Clear Logs</b>.</li>
      </ul>
  </context></taskbody>
