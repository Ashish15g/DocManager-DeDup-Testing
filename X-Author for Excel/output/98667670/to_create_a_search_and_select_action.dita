<task id="to_create_a_search_and_select_action_087e25" xml:lang="en-us">
   <title>To create a Search and Select Action</title>
   <shortdesc>Rakesh Singh Example In the main ribbon under Actions, click the arrow and select Search</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
        <keyword>Search</keyword>
        <keyword>Select</keyword>
        <keyword>Action</keyword>
        <keyword>click</keyword>
        <keyword>Name</keyword>
        <keyword>check</keyword>
        <indexterm>Search</indexterm>
        <indexterm>Select</indexterm>
        <indexterm>Action</indexterm>
      </keywords>
      <prodinfo>
            <prodname>Example</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>In the main ribbon under Actions, click the arrow and select <b>Search and Select</b>.</cmd>
         </step>
         <step>
            <cmd>In the Action Name field, type Select <b>Account</b>.</cmd>
         </step>
         <step>
            <cmd>From the Objects list, choose <b>Account</b>.</cmd>
         </step>
         <step>
            <cmd>In the Search window, click the check box next to Name.</cmd>
         </step>
         <step>
            <cmd>In the <b>Name in Fields to Display in Search Results</b>, click the check box next to it and the Sort check box to the right.</cmd>
         </step>
         <step>
            <cmd>From the Results area, choose <b>Single</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>