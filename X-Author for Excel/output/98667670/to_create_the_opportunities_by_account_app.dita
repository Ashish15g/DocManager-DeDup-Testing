<task id="to_create_the_opportunities_by_account_app_84a907" xml:lang="en-us">
   <title>To create the Opportunities by Account App</title>
   <shortdesc>Rakesh Singh Example In the ribbon menu, click Apps and select New Application .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
        <keyword>Opportunities</keyword>
        <keyword>Account</keyword>
        <keyword>create</keyword>
        <keyword>click</keyword>
        <keyword>select</keyword>
        <keyword>Rakesh</keyword>
        <indexterm>Opportunities</indexterm>
        <indexterm>Account</indexterm>
        <indexterm>create</indexterm>
      </keywords>
      <prodinfo>
            <prodname>Example</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>In the ribbon menu, click <b>Apps </b>and select <b>New Application</b>.</cmd>
         </step>
         <step>
            <cmd>In the App Name Field, type <i>Opportunities by Account</i>.</cmd>
         </step>
         <step>
            <cmd>In the Select Template section,click the <b>New </b>radio button.</cmd>
         </step>
         <step>
            <cmd>Click <b>Create</b>.</cmd>
         </step>
         <step>
            <cmd>For the app type, select the product edition. For example, <i>Enterprise</i>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>