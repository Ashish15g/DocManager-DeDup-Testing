<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_create_user_menus_17040f" xml:lang="en-us">
   <title>To create User Menus</title>
   <shortdesc>Rakesh Singh Example Click User Menus .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
        <keyword>field</keyword>
        <keyword>Click</keyword>
        <keyword>enter</keyword>
        <keyword>Opportunities</keyword>
        <keyword>Save</keyword>
        <keyword>User</keyword>
        <indexterm>field</indexterm>
        <indexterm>Click</indexterm>
        <indexterm>enter</indexterm>
      </keywords>
      <prodinfo>
            <prodname>Example</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click<b> User Menus</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Add Group</b>.</cmd>
         </step>
         <step>
            <cmd>In the Name field, enter <i>Opportunities </i>and <i>1</i> in the Order field.</cmd>
         </step>
         <step>
            <cmd>Click <b>Add Button</b> and in the Name field enter <i>Retrieve Opportunities</i>.</cmd>
         </step>
         <step>
            <cmd>In the Icon field enter "GetExternalDataFromOtherSources".</cmd>
         </step>
         <step>
            <cmd>Enter <i>1</i> in the Order field.</cmd>
         </step>
         <step>
            <cmd>From the Action Flow list, select <b>Retrieve Opportunities</b>.</cmd>
         </step>
         <step>
            <cmd>Click on <b>Opportunities</b> to highlight the group and then click <b>Add Button</b>.</cmd>
         </step>
         <step>
            <cmd>In the Name field, enter <i>Save Opportunities</i>.</cmd>
         </step>
         <step>
            <cmd>In the Icon field, enter <i>SaveObjectAs</i> .</cmd>
         </step>
         <step>
            <cmd>In the Order field, enter <i>2</i>.</cmd>
         </step>
         <step>
            <cmd>From the Action Flow list, select <b>Save Opportunities</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save</b>
            </cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>