<task id="to_create_a_save_map_0a13aa" xml:lang="en-us">
   <title>To create a Save Map</title>
   <shortdesc>Rakesh Singh Example Select Save Map and then click Create .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <metadata>
         <keywords>
        <keyword>Save</keyword>
        <keyword>Click</keyword>
        <keyword>create</keyword>
        <keyword>click</keyword>
        <keyword>Rakesh</keyword>
        <keyword>Singh</keyword>
        <indexterm>Save</indexterm>
        <indexterm>Click</indexterm>
        <indexterm>create</indexterm>
      </keywords>
      <prodinfo>
            <prodname>Example</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Select <b>Save Map</b> and then click <b>Create</b>.</cmd>
         </step>
         <step>
            <cmd>In the Name field, type <i>Main</i>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Add Display Map Fields</b> and select <i>Amount</i> and <i>Stage</i>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Apply</b> and then click <b>Save</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.
</cmd>
         </step>
      </steps>
   </taskbody>
</task>