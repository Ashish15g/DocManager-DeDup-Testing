<task id="to_display_a_matrix_filter_89d75d" xml:lang="en-us">
   <title>To display a matrix filter</title>
   <shortdesc>A matrix filter is displayed.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <critdates>
         <created date="Oct 29, 2018"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>matrix</keyword>
        <keyword>filter</keyword>
        <keyword>Click</keyword>
        <keyword>display</keyword>
        <keyword>Select</keyword>
        <keyword>Save</keyword>
        <indexterm>matrix</indexterm>
        <indexterm>filter</indexterm>
        <indexterm>Click</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the Fields tab.</cmd>
         </step>
         <step>
            <cmd>Select Individual as the Type.</cmd>
         </step>
         <step>
            <cmd>Select a field and drag it onto the worksheet outside the matrix.</cmd>
         </step>
         <step>
            <cmd>Click Save.</cmd>
         </step>
         <step>
            <cmd>Click Save Application.
</cmd>
         </step>
      </steps>
      <result>
         <p>A matrix filter is displayed.</p>
      </result>
   </taskbody>
</task>