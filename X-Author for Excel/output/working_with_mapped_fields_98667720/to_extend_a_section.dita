<task id="to_extend_a_section_00af65" xml:lang="en-us">
   <title>To extend a section</title>
   <shortdesc>Rakesh Singh Click the Sections tab.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
      <critdates>
         <created date="Oct 29, 2018"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>section</keyword>
        <keyword>extend</keyword>
        <keyword>cells</keyword>
        <keyword>Click</keyword>
        <keyword>Select</keyword>
        <keyword>highlighted</keyword>
        <indexterm>section</indexterm>
        <indexterm>extend</indexterm>
        <indexterm>cells</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the <b>Sections</b> tab.</cmd>
         </step>
         <step>
            <cmd>Select a section. The cells that comprise that section will be highlighted in the worksheet. Make sure your cursor is in the worksheet data cell you want to copy.</cmd>
         </step>
         <step>
            <cmd>Select the remainder of the range to extend to, including the data cell.</cmd>
         </step>
         <step>
            <cmd>Click <b>Extend Section</b> in the pane to the right. The highlighted cells will expand and their cells will be mapped on the Fields tab.</cmd>
         </step>
      </steps>
   </taskbody>
</task>