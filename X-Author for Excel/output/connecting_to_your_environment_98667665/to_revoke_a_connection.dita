<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_revoke_a_connection_b461da" xml:lang="en-us">
   <title>To revoke a connection</title>
   <shortdesc>The connection is no longer available in X-Author.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>connection</keyword>
        <keyword>revoke</keyword>
        <keyword>Author</keyword>
        <keyword>Manage</keyword>
        <keyword>Connections</keyword>
        <keyword>window</keyword>
        <indexterm>connection</indexterm>
        <indexterm>revoke</indexterm>
        <indexterm>Author</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Open Excel.</cmd>
         </step>
         <step>
            <cmd>In the X-Author Designer ribbon menu, click <b>Switch Connection</b> and select Manage Connections. The Manage Connections window opens. </cmd>
         </step>
         <step>
            <cmd>Click the <b>Revoke </b>button next to the connection you want to remove. The Revoke Access confirmation window opens.</cmd>
         </step>
         <step>
            <cmd>Click <b>Yes </b>to confirm the action.</cmd>
         </step>
      </steps>
      <result>
         <p>The connection is no longer available in X-Author.</p>
      </result>
   </taskbody>
</task>