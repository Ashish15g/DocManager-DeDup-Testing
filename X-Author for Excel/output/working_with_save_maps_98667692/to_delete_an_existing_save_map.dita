<task id="to_delete_an_existing_save_map_7259cd" xml:lang="en-us">
   <title>To delete an existing Save Map</title>
   <shortdesc>You cannot delete Save Maps that are used in a Save action.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Save</keyword>
        <keyword>delete</keyword>
        <keyword>existing</keyword>
        <keyword>Maps</keyword>
        <keyword>Rakesh</keyword>
        <keyword>Singh</keyword>
        <indexterm>Save</indexterm>
        <indexterm>delete</indexterm>
        <indexterm>existing</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>You cannot delete Save Maps that are used in a Save action.</p>
      </context>
      <steps>
         <step>
            <cmd>Click <b>Save Map</b>.</cmd>
         </step>
         <step>
            <cmd>From the list of existing Save Maps, select one and click <b>Delete</b>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>