<task id="to_delete_an_existing_display_map_d8c3be" xml:lang="en-us">
   <title>To delete an existing Display Map</title>
   <shortdesc>You cannot delete a Display Map that is being used by a Display Action .</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>Display</keyword>
        <keyword>delete</keyword>
        <keyword>existing</keyword>
        <keyword>click</keyword>
        <keyword>Rakesh</keyword>
        <keyword>Singh</keyword>
        <indexterm>Display</indexterm>
        <indexterm>delete</indexterm>
        <indexterm>existing</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>From the ribbon, click the <b>Display Map</b> button.</cmd>
         </step>
         <step>
            <cmd>From the list of Display Maps, select a Display Map and click <b>Delete</b>.</cmd>
         </step>
      </steps>
      <result>
         <p>You cannot delete a Display Map that is being used by a <xref href="../display_action_98667691/display_action.dita">Display Action</xref>.</p>
      </result>
   </taskbody>
</task>