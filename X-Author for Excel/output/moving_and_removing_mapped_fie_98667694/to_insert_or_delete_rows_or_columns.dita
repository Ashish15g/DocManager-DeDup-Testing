<task id="to_insert_or_delete_rows_or_columns_897d94" xml:lang="en-us">
   <title>To insert or delete rows or columns</title>
   <shortdesc>Rakesh Singh Close all open Display maps.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>insert</keyword>
        <keyword>delete</keyword>
        <keyword>columns</keyword>
        <keyword>Display</keyword>
        <keyword>column</keyword>
        <keyword>Save</keyword>
        <indexterm>insert</indexterm>
        <indexterm>delete</indexterm>
        <indexterm>columns</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Close all open Display maps.</cmd>
         </step>
         <step>
            <cmd>Place your cursor on the row or column heading where you want to perform an insert/delete.</cmd>
         </step>
         <step>
            <cmd>Right-click on the row or column and select <b>Insert</b> or <b>Delete</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.</cmd>
         </step>
         <step>
            <cmd>Open the Display Map or Save Map to confirm cells were properly remapped.</cmd>
         </step>
      </steps>
   </taskbody>
</task>