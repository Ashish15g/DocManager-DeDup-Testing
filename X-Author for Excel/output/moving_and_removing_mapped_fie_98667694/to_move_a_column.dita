<task id="to_move_a_column_db85f1" xml:lang="en-us">
   <title>To move a column</title>
   <shortdesc>Rakesh Singh Close all open Display Maps and Save Maps.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>column</keyword>
        <keyword>Save</keyword>
        <keyword>Display</keyword>
        <keyword>Maps</keyword>
        <keyword>Highlight</keyword>
        <keyword>Right</keyword>
        <indexterm>column</indexterm>
        <indexterm>Save</indexterm>
        <indexterm>Display</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Close all open Display Maps and Save Maps.</cmd>
         </step>
         <step>
            <cmd>Highlight the column. Right-click and select <b>Cut</b>.</cmd>
         </step>
         <step>
            <cmd>Highlight the target column. Right-click and select <b>Paste</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Save App</b>.</cmd>
         </step>
         <step>
            <cmd>Open the Display Map or Save Map and check the Mapped Details to confirm cells were properly remapped.</cmd>
         </step>
      </steps>
   </taskbody>
</task>