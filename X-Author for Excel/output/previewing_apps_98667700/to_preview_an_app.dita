<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_preview_an_app_f0541f" xml:lang="en-us">
   <title>To preview an app</title>
   <shortdesc>When you click Preview , a new worksheet opens and X-Author for Excel must reconnect</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>click</keyword>
        <keyword>Excel</keyword>
        <keyword>preview</keyword>
        <keyword>Preview</keyword>
        <keyword>button</keyword>
        <keyword>ribbon</keyword>
        <indexterm>click</indexterm>
        <indexterm>Excel</indexterm>
        <indexterm>preview</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>After creating an app, click the <b>Preview</b> button in the ribbon menu.</cmd>
            <info>
               <fig>
                  <title>98668012</title>
                  <image href="../attachments/98667700/98668012.png" width="1011" height="158" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>The app opens in the X-Author for Excel tab.</cmd>
            <info>
               <note type="note">
                  <p>When you click <b>Preview</b>, a new worksheet opens and X-Author for Excel must reconnect to your environment instance. This may take a few seconds.</p>
               </note>
            </info>
         </step>
         <step>
            <cmd>In the ribbon menu, click the <b>Retrieve</b> button to download data from your environment into Excel.</cmd>
            <info>
               <fig>
                  <title>98668011</title>
                  <image href="../attachments/98667700/98668011.jpg" width="523" height="123" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
      </steps>
      <result>
         <p>You can now test your app by retrieving data and adding, pasting, and deleting rows.</p>
      </result>
   </taskbody>
</task>