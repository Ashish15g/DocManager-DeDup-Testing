   <taskbody>  <context>
    <p>The information here details out performance numbers for X-Author for Excel. These numbers are based on uninterrupted create, update, upsert and delete operations. These apply to clients 4.7 and 5.x.</p><table>
         <tgroup cols="2">
            <colspec colname="c1"/>
            <colspec colname="c2"/>
            <thead>
               <row>
                  <entry>
                     <p>Operation</p>
                  </entry>
                  <entry>
                     <p>Average Time (in seconds)</p>
                  </entry>
               </row>
            </thead>
            <tbody>
               <row>
                  <entry>
                     <p>Retrieving 10000 records</p>
                  </entry>
                  <entry>
                     <p>10.13</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Retrieving 50000 records</p>
                  </entry>
                  <entry>
                     <p>51.64</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Retrieving 50000 records and modifying 10</p>
                  </entry>
                  <entry>
                     <p>10.65</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Inserting 5000 records</p>
                  </entry>
                  <entry>
                     <p>51.38</p>
                  </entry>
               </row>
               <row>
                  <entry>
                     <p>Deleting 5000 records</p>
                  </entry>
                  <entry>
                     <p>34.11</p>
                  </entry>
               </row>
            </tbody>
         </tgroup>
      </table>
