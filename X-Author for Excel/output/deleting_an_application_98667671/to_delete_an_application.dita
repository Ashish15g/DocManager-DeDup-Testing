<task id="to_delete_an_application_123a08" xml:lang="en-us">
   <title>To delete an Application</title>
   <shortdesc>Rakesh Singh Log in to your environment using a standard web browser.</shortdesc>
   <prolog>
      <author type="creator">Rakesh Singh</author>
       <metadata>
      <keywords>
        <keyword>delete</keyword>
        <keyword>Author</keyword>
        <keyword>Click</keyword>
        <keyword>Application</keyword>
        <keyword>Excel</keyword>
        <keyword>Apps</keyword>
        <indexterm>delete</indexterm>
        <indexterm>Author</indexterm>
        <indexterm>Click</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Log in to your environment using a standard web browser.</cmd>
         </step>
         <step>
            <cmd>From the menu, select <b>Conga X-Author for Excel</b>.</cmd>
         </step>
         <step>
            <cmd>Click on the <b>Apps</b> tab.</cmd>
         </step>
         <step>
            <cmd>Click <b>Go</b> next to the X-Author for Excel picklist. This action displays all of the X-Author Designer-created Apps.</cmd>
         </step>
         <step>
            <cmd>Click <b>Del</b> next to the App name to delete the App, and then click <b>OK</b>.
</cmd>
         </step>
      </steps>
   </taskbody>
</task>