<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="WorkingwithCongaCopilot_EnablingCongaCopilot" xml:lang="en">
   <title>Enabling Conga Copilot</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In Conga Platform, click <uicontrol>Explore All</uicontrol> in the left menu.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Admin Console.</uicontrol>
            </cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Org Management</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>CCI Admin Dashboard</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>App Configuration</uicontrol> &gt; <uicontrol>General</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Toggle the <i>Use Generation AI</i> option to <uicontrol>On </uicontrol>and select the generative AI option from the dropdown menu (for example, gpt-4). You must also specify your organization details in the mandatory field.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>