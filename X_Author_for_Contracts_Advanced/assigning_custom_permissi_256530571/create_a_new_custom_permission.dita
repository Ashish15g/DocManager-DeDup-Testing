<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_AssigningCustomPermissionsatthePermissionSetLevelv20240711_CreateaNewCustomPermission" xml:lang="en">
   <title>Create a New Custom Permission</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In Salesforce, click <uicontrol>Setup</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>In Quick Search, enter Custom Permissions and click <uicontrol>Custom Permissions</uicontrol> under App Setup.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>New.</uicontrol>
            </cmd>
         </step>
         <step>
            <cmd>Enter the Label and Name of your Custom Permission and click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>