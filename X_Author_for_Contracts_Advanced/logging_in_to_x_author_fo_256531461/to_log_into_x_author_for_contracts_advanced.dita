<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_LoggingintoXAuthorforContractAdvancedv20240711_TologintoAdvanced" xml:lang="en">
   <title>To log into X-Author for Contracts Advanced</title>
   <taskbody>
      <steps platform="salesforce">
         <step>
            <cmd>Open a new document or an existing document in Microsoft Word.</cmd>
         </step>
         <step>
            <cmd>In the Home tab, click the <uicontrol>X-Author Contracts Advanced</uicontrol> ribbon. The login panel opens.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Login</uicontrol>. or Click the Home button (<image placement="inline" width="16" href="../attachments/256531461/256531456.png" class="- topic/image "/>) and click <uicontrol>L</uicontrol>
               <uicontrol>ogin</uicontrol>. The Salesforce production login page opens.</cmd>
         </step>
         <step>
            <cmd>Enter your production credentials (user name and password) and click <uicontrol>Login</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>If you are a first-time user, you may be prompted to allow access to X-Author for Contracts Advanced. Click <uicontrol>Allow</uicontrol> to proceed.</cmd>
         </step>
      </steps>
      <postreq>
         <p platform="salesforce">You are logged into the X-Author for Contracts add-in.</p>
         <note type="note">
            <p>If you encounter an OAuth error while logging into X-Author for Contracts on Microsoft Windows, refresh the page or re-enter your login credentials to log in.</p>
         </note>
         <p platform="salesforce">The following options are displayed when you click the Home button.</p>
         <p platform="salesforce">
            <fig>
               <image height="250" placement="break" width="216" href="../attachments/256531461/256531459.png" class="- topic/image "/>
            </fig>
         </p>
         <p platform="salesforce">
            <table platform="salesforce">
               <tgroup cols="2">
                  <colspec colname="col1"/>
                  <colspec colname="col2"/>
                  <thead>
                     <row>
                        <entry>
                           <p>Option</p>
                        </entry>
                        <entry>
                           <p>Description</p>
                        </entry>
                     </row>
                  </thead>
                  <tbody>
                     <row>
                        <entry>
                           <p>User Name &amp; User ID</p>
                        </entry>
                        <entry>
                           <p>Displays the user name and ID</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>Contracts</p>
                        </entry>
                        <entry>
                           <p>Opens the contracts menu.</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>Templates</p>
                        </entry>
                        <entry>
                           <p>Opens the templates menu.</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>Documentation</p>
                        </entry>
                        <entry>
                           <p>Navigates the X-Author for Contracts Advanced documentation</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>Technical Support</p>
                        </entry>
                        <entry>
                           <p>Connects with the technical support team.</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>App Details (earlier System information)</p>
                        </entry>
                        <entry>
                           <p>Displays the system information that you are currently logged in to.</p>
                        </entry>
                     </row>
                     <row>
                        <entry>
                           <p>Log Out</p>
                        </entry>
                        <entry>
                           <p>To logout from the X-Author for Contracts</p>
                        </entry>
                     </row>
                  </tbody>
               </tgroup>
            </table>
         </p>
         <note type="note">
            <p platform="salesforce">Note that, on the login page, when you click <uicontrol>Log In To Sandbox,</uicontrol> you are taken to the Salesforce sandbox login page, where you must enter Sandbox credentials to log in.</p>
         </note>
      </postreq>
   </taskbody>
</task>