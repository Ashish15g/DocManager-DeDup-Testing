<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_EnablingtheAutoInsertHeaderFooterDataOptionv20240711_ToenabletheAutoInsertHeaderFooterDataoption" xml:lang="en">
   <title>To enable the Auto Insert Header Footer Data option</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In Salesforce, navigate to the Comply System Properties custom setting.</cmd>
         </step>
         <step>
            <cmd>Under Action, click <uicontrol>Edit.</uicontrol>
            </cmd>
         </step>
         <step>
            <cmd>Click the Auto Insert Header Footer Data checkbox.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>