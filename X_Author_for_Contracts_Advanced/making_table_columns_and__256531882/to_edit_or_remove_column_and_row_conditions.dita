<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_MakingTableColumnsandRowsConditionalv20240711_Toeditorremovecolumnandrowconditions" xml:lang="en">
   <title>To edit or remove column and row conditions</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In the Templates pane, go to Work and click Fields.</cmd>
         </step>
         <step>
            <cmd>Click the<uicontrol/>Settings icon (<image placement="inline" width="20" href="../../global_images/images/256529252.png" class="- topic/image "/>) next to the Repeat Table name.</cmd>
         </step>
         <step>
            <cmd>Click Delete icon (<image placement="inline" width="20" href="../attachments/256531882/256531874.png" class="- topic/image "/>) to remove the condition and click Remove.</cmd>
         </step>
         <step>
            <cmd>Click the Edit icon (<image placement="inline" width="20" href="../attachments/256531882/256531873.png" class="- topic/image "/>) and update the conditions.</cmd>
         </step>
         <step>
            <cmd>Click Save.</cmd>
         </step>
      </steps>
   </taskbody>
</task>