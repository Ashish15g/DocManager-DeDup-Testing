<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_MakingColumnsandRowsConditionalinaRepeatTableandRepeatSectionv20240620_Toeditcolumnandrowconditions" xml:lang="en">
   <title>To edit column and row conditions</title>
   <taskbody>
      <steps platform="conga">
         <step>
            <cmd>In the Templates pane, go to the Work tab, click the dropdown button (<image height="13" placement="inline" href="../attachments/256528175/256528162.png" class="- topic/image "/>) and select <uicontrol>Fields</uicontrol>. The Fields pane displays the repeat table and the fields.</cmd>
         </step>
         <step>
            <cmd>Click the Settings button(<image placement="inline" width="20" href="../../global_images/images/256529252.png" class="- topic/image "/>) next to the repeat table name.</cmd>
         </step>
         <step>
            <cmd>In the Repeat Table Settings pane, click Edit button(<image placement="inline" width="20" href="../attachments/256528175/256528163.png" class="- topic/image "/>).</cmd>
         </step>
         <step>
            <cmd>Update conditions and click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>