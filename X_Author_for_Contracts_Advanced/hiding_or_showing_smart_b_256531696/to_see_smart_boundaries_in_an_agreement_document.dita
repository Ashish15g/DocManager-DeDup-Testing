<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_HidingorShowingSmartBoundariesv20240711_Toseesmartboundariesinanagreementdocument" xml:lang="en">
   <title>To see smart boundaries in an agreement document</title>
   <taskbody>
      <steps platform="salesforce">
         <step>
            <cmd>Open Microsoft Word and launch the add-in.</cmd>
         </step>
         <step>
            <cmd>Log in to X-Author for Contracts Advanced.</cmd>
         </step>
         <step>
            <cmd>In the Contracts pane, go to Work tab and click the More icon (<image placement="inline" width="18" href="../attachments/256531696/256531695.png" class="- topic/image "/>).</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Show Smart Boundary</uicontrol>.</cmd>
            <info>
               <p>This shows all the smart boundaries.</p>
            </info>
         </step>
      </steps>
   </taskbody>
</task>