<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_XAuthorAdministratorSettingsinCongaCLMv20240620_ToaccessX_AuthorConfigurationSettingsinCLM" xml:lang="en">
   <title>To access X-Author Configuration Settings in CLM</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In Conga CLM, select <uicontrol>Admin Home</uicontrol> from the upper left navigation menu.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>CLM Settings</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>X-Author Configuration Settings</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Make your selections and click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>