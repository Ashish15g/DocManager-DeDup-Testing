<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="id_InsertingFieldsinTemplatesasaSectionv20240711_Toeditorremoveconditionsfromrepeatsection" xml:lang="en">
   <title>To edit or remove conditions from repeat section</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Open a template in X-Author for Contracts Advanced for Conga CLM (Contracts for Salesforce).</cmd>
         </step>
         <step>
            <cmd>In the <uicontrol>Templates </uicontrol>pane, go to <uicontrol>Work</uicontrol> tab and click <uicontrol>Fields</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click the <uicontrol>Settings icon</uicontrol> (<image placement="inline" width="16" href="../../global_images/images/256531898.png" class="- topic/image "/>) next to the repeat section name.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Delete icon </uicontrol>(<image placement="inline" width="16" href="../attachments/256531906/256531897.png" class="- topic/image "/>) to remove the condition and click <uicontrol>Remove</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Edit icon </uicontrol>(<image height="14" placement="inline" href="../attachments/256531906/256531896.png" class="- topic/image "/>) to edit the condition.</cmd>
         </step>
      </steps>
   </taskbody>
</task>