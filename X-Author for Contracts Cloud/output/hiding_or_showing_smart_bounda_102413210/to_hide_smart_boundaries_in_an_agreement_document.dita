<task id="to_hide_smart_boundaries_in_an_agreement_document_c352e1" xml:lang="en-us">
   <title>To hide smart boundaries in an agreement document</title>
   <shortdesc>Regardless of the Hide/Show Boundary option selected before checking in, the boundaries are displayed after</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Aug 13, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>boundaries</keyword>
        <keyword>smart</keyword>
        <keyword>document</keyword>
        <keyword>agreement</keyword>
        <keyword>Hide</keyword>
        <keyword>Boundary</keyword>
        <indexterm>boundaries</indexterm>
