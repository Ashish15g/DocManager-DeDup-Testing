   <taskbody>
      <steps>
         <step>
            <cmd>In the X-Author Contracts pane, go to <b>Work</b> tab and click the more icon ().</cmd>
            <info>
               <image href="../attachments/102413210/102413306.png" width="6" height="19" placement="inline">
                     <alt>placeholder</alt>
                  </image>
               
            </info>
         </step>
         <step>
            <cmd>Click <b>Hide Smart Boundary</b>.
This hides all the smart boundaries.</cmd>
            <info>
               <note type="note">
                  <p>Regardless of the <b>Hide/Show Boundary</b> option selected before checking in, the boundaries are displayed after checking out the document.</p>
               </note>
            </info>
         </step>
      </steps>
   </taskbody>
