<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_open_an_agreement_in_contract_management_f052a0" xml:lang="en-us">
   <title>To open an agreement in Contract Management</title>
   <shortdesc>A separate browser window is opened and the agreement is loaded in Contract Management (You</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <created date="Apr 16, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>agreement</keyword>
        <keyword>Contract</keyword>
        <keyword>Management</keyword>
        <keyword>Author</keyword>
        <keyword>Contracts</keyword>
        <keyword>click</keyword>
        <indexterm>agreement</indexterm>
        <indexterm>Contract</indexterm>
        <indexterm>Management</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Connect to X-Author Contracts.</cmd>
         </step>
         <step>
            <cmd>Open the agreement document for the agreement you want to view.</cmd>
         </step>
         <step>
            <cmd>From the X-Author menu, hover over the menu icon  and click <b>X-Author Contracts.</b>
            </cmd>
            <info>
               <image href="../attachments/102413216/102413255.png" width="35" height="31" placement="inline">
                     <alt>placeholder</alt>
                  </image>
               
            </info>
         </step>
         <step>
            <cmd>Under the X-Author Contracts pane, click the <b>Work</b> tab.</cmd>
         </step>
         <step>
            <cmd>In the Work tab, click more icon  and select <b>Open in CLM</b>.</cmd>
            <info>
               <image href="../attachments/102413216/102413252.png" width="6" height="19" placement="inline">
                     <alt>placeholder</alt>
                  </image>
               
            </info>
            <info>
               <fig>
                  <title>102413253</title>
                  <image href="../attachments/102413216/102413253.png" width="688" height="700" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
      </steps>
      <result>
         <p>A separate browser window is opened and the agreement is loaded in Contract Management (You may be prompted to log in again to your Contract Management account in the browser).</p>
      </result>
   </taskbody>
</task>