<task id="to_launch_the_xauthor_contracts_addin_42bd2e" xml:lang="en-us">
   <title>To launch the X-Author Contracts add-in</title>
   <shortdesc>Don't confuse the Microsoft Word Insert option with the Mac menu bar Insert option. Going</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Jul 22, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>Author</keyword>
        <keyword>Contracts</keyword>
        <keyword>Insert</keyword>
        <keyword>launch</keyword>
        <keyword>Microsoft</keyword>
        <keyword>Word</keyword>
        <indexterm>Author</indexterm>
        <indexterm>Contracts</indexterm>
        <indexterm>Insert</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Open Microsoft Word.</cmd>
         </step>
         <step>
            <cmd>Go to <b>Insert &gt; My Add-ins.</b>
            </cmd>
            <info>
               <note type="tip">
                  <p>Don't confuse the Microsoft Word <b>Insert</b> option with the Mac menu bar <b>Insert</b> option. Going to Mac <b>Menu bar &gt; Add-ins &gt; My Add-ins</b> does not list the Apttus X-Author add-in.</p>
               </note>
            </info>
         </step>
         <step>
            <cmd>Choose <b>X-Author Contracts</b> from the list of add-ins displayed in the drop-down. Apttus X-Author loads in a new pane to the right of the document window.</cmd>
            <info>
               <fig>
                  <title>102413248</title>
                  <image href="../attachments/102413199/102413248.png" width="1500" height="585" placement="break">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
      </steps>
   </taskbody>
</task>