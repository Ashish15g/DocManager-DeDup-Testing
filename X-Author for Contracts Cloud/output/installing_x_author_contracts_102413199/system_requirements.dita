<concept id="system_requirements_561c72" xml:lang="en-us">
   <title>System Requirements</title>
     <shortdesc>Your computer must meet the minimum requirements listed below to use X-Author Contracts for Cloud.</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Jul 22, 2019"/>
      </critdates>
       <metadata>
      <keywords>
