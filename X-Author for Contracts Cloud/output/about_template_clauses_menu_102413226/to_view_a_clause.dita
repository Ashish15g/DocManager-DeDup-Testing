<concept id="to_view_a_clause_e72756" xml:lang="en-us">
   <title>To view a clause</title>
   <shortdesc>Newly marked clause are also displayed in the Template Clauses list.</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <created date="Apr 16, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>clause</keyword>
        <keyword>Template</keyword>
        <keyword>Clauses</keyword>
        <keyword>Maanasa</keyword>
        <keyword>Suthrave</keyword>
        <keyword>Work</keyword>
        <indexterm>clause</indexterm>
        <indexterm>Template</indexterm>
        <indexterm>Clauses</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody>    <ol>
    <li>Go to <b>Work &gt; Template Clauses</b> tab.</li>
    <li>Click on a clause name in the list. The document scrolls to highlight the selected clause in the template.</li>
    </ol>
    <section>
      <title>Result</title>
      <p>Newly marked clause are also displayed in the Template Clauses list.</p>
    </section></conbody>
</concept>