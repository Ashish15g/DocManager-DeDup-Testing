<task id="to_delete_a_conditional_segment_in_a_template_fe6d7b" xml:lang="en-us">
   <title>To delete a conditional segment in a template</title>
   <shortdesc>Your segment is successfully deleted and the content control boundary of your segment is removed.</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <created date="Apr 16, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>segment</keyword>
        <keyword>template</keyword>
        <keyword>Click</keyword>
        <keyword>delete</keyword>
        <keyword>conditional</keyword>
        <keyword>Segment</keyword>
        <indexterm>segment</indexterm>
        <indexterm>template</indexterm>
        <indexterm>Click</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to<b> </b>the<b>
                  <b>Work tab </b>
               </b>&gt;<b>
                  <b> </b>Set Segment </b>tab in X-Author Templates.</cmd>
         </step>
         <step>
            <cmd>Select the segment from the segment list. The selected segment is highlighted in the template.</cmd>
         </step>
         <step>
            <cmd>Click the gear icon () next to the segment name to open the <b>Segment Conditional </b>page.</cmd>
            <info>
               <image href="../attachments/102413240/102413261.png" width="20" height="20" placement="inline">
                     <alt>placeholder</alt>
                  </image>
               
            </info>
         </step>
         <step>
            <cmd>Click <b>Delete</b>. You will see a confirmation message. Click <b>Delete</b> again.</cmd>
         </step>
      </steps>
      <result>
         <p>Your segment is successfully deleted and the content control boundary of your segment is removed.</p>
      </result>
   </taskbody>
</task>