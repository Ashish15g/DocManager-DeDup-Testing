<task id="to_remove_library_cache_41df9b" xml:lang="en-us">
   <title>To remove Library cache</title>
   <shortdesc>Maanasa Suthrave Go to Menu bar &gt; Go &gt; Home From the left navigation pane,</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Jul 25, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>Library</keyword>
        <keyword>remove</keyword>
        <keyword>cache</keyword>
        <keyword>select</keyword>
        <keyword>Caches</keyword>
        <keyword>Maanasa</keyword>
        <indexterm>Library</indexterm>
        <indexterm>remove</indexterm>
        <indexterm>cache</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to <b>Menu bar &gt; Go &gt; Home</b>
            </cmd>
         </step>
         <step>
            <cmd>From the left navigation pane, select the logged in user.</cmd>
         </step>
         <step>
            <cmd>Go to <b>Library &gt; Caches</b>
            </cmd>
         </step>
         <step>
            <cmd>Right-click on <b>Caches</b> and select <b>Move to Trash</b>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>