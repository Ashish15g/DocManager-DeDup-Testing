<task id="to_reject_changes_c16862" xml:lang="en-us">
   <title>To reject changes</title>
   <shortdesc>The field value is reverted to its previous value prior to the change. The Doc</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Aug 13, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>changes</keyword>
        <keyword>Fields</keyword>
        <keyword>reject</keyword>
        <keyword>fields</keyword>
        <keyword>value</keyword>
        <keyword>change</keyword>
        <indexterm>changes</indexterm>
        <indexterm>Fields</indexterm>
        <indexterm>reject</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to <b>Doc Fields &gt;</b> list of doc fields.</cmd>
         </step>
         <step>
            <cmd>Click on more options on the changed fields in the Doc Fields pane and select <b>Reject changes</b>.</cmd>
         </step>
      </steps>
      <result>
         <p>The field value is reverted to its previous value prior to the change. The <b>Doc Fields</b> pane reloads to show the change.</p>
      </result>
   </taskbody>
</task>