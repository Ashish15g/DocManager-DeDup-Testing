<task id="to_unmark_fields_for_deletion_c9fc86" xml:lang="en-us">
   <title>To unmark fields for deletion</title>
   <shortdesc>If you decide in the same session that you want to keep a field in</shortdesc>
   <prolog>
      <author type="creator">Maanasa Suthrave</author>
      <critdates>
         <revised modified="Aug 13, 2019"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>deletion</keyword>
        <keyword>unmark</keyword>
        <keyword>fields</keyword>
        <keyword>field</keyword>
        <keyword>marked</keyword>
        <keyword>Document</keyword>
        <indexterm>deletion</indexterm>
        <indexterm>unmark</indexterm>
        <indexterm>fields</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>If you decide in the same session that you want to keep a field in the document that you have already marked for deletion, follow these steps.</p>
      </context>
      <steps>
         <step>
            <cmd>Go to <b>Document &gt; Fields</b>.</cmd>
         </step>
         <step>
            <cmd>Right-click on the field in the Document pane that you marked for deletion and select <b>Undo Delete</b>.</cmd>
         </step>
         <step>
            <cmd>Click <b>Yes </b>on the confirmation dialog that appears.</cmd>
         </step>
      </steps>
   </taskbody>
</task>