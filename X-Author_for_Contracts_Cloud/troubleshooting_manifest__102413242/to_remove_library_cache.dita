<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="TroubleshootingManifestFileChangeErrors_ToremoveLibrarycache" xml:lang="en">
   <title>To remove Library cache</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to <uicontrol>Menu bar &gt; Go&gt; Home</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>From the left navigation pane, select the logged in user.</cmd>
         </step>
         <step>
            <cmd>Go to <uicontrol>Library&gt; Caches.</uicontrol>
            </cmd>
         </step>
         <step>
            <cmd>Right-click on <uicontrol>Cache</uicontrol> and select <uicontrol>Move to Trash</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>