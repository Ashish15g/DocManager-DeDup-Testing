<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="HidingorShowingSmartBoundaries_Toseesmartboundariesinanagreementdocument" xml:lang="en">
   <title>To see smart boundaries in an agreement document</title>
   <taskbody>
      <steps>
         <step>
            <cmd>In the X-Author Contracts pane, go to <uicontrol>Work </uicontrol>tab and click the more icon (<image placement="inline" href="../attachments/102413210/102413306.png"/>).</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Show Smart Boundary</uicontrol>.</cmd>
            <info>
               <p>This shows all the smart boundaries.</p>
            </info>
         </step>
      </steps>
   </taskbody>
</task>