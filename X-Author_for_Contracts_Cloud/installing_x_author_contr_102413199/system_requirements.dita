<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="InstallingXAuthorContractsSystemRequirements" xml:lang="en">
   <title>System Requirements</title>
   <conbody>
      <p>Your computer must meet the minimum requirements listed below to use X-Author Contracts for Cloud.</p>
      <note type="note">
         <p>Microsoft Office 365 Online or Cloud applications do not support plugins.</p>
      </note>
      <p>
         <table>
            <tgroup cols="2">
               <colspec colname="col1"/>
               <colspec colname="col2"/>
               <thead>
                  <row>
                     <entry>
                        <p>Supported Component</p>
                     </entry>
                     <entry>
                        <p>Minimum Supported Version</p>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <p>Mac OS</p>
                     </entry>
                     <entry>
                        <p>El Capitan version 10.11.3 or later</p>
                        <p>Mac OS High Sierra version 10.13.3 or later</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>Microsoft Office</p>
                     </entry>
                     <entry>
                        <p>Microsoft Word 2016 for Mac, version 15.41 or later</p>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </p>
   </conbody>
</concept>