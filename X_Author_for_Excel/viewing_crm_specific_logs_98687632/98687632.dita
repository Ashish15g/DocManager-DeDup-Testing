<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="d314aA" xml:lang="en">
   <title>Viewing CRM Specific Logs</title>
   <prolog>
      <author>Rakesh Singh</author>
      <critdates>
         <created date="Jul 28, 2022"/>
      </critdates>
      <metadata>
         <prodinfo>
            <prodname>X-Author for Excel</prodname>
         </prodinfo>
      </metadata>
   </prolog>
   <conbody>
      <p>This section displays all the CRM specific logs in the event of an error.</p>
      <p>
         <fig>
            <image height="250"
                   placement="break"
                   width="444"
                   href="../attachments/98687632/190354379.png"/>
         </fig>
      </p>
      <ul>
         <li>To view the log in page mode, click the page mode <fig>
               <image placement="break"
                      width="16"
                      href="../attachments/98687632/98687629.png"/>
            </fig> icon.</li>
         <li>To view the log in scroll mode, click the scroll mode <fig>
               <image placement="break"
                      width="16"
                      href="../attachments/98687632/98687628.png"/>
            </fig> icon.</li>
         <li>To zoom in and out, move the slider <fig>
               <image placement="break"
                      width="100"
                      href="../attachments/98687632/98687627.png"/>
            </fig>.</li>
         <li>To search for a specific keyword in the log, click the search <fig>
               <image placement="break"
                      width="16"
                      href="../attachments/98687632/98687626.png"/>
            </fig> icon.</li>
         <li>To open and view the log file in Notepad, click <b>Open File</b>.</li>
         <li>To clear log files, click <b>Clear Logs</b>.</li>
      </ul>
   </conbody>
</concept>
