<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="GeneralSettings_Tochangethesourceenvironment" xml:lang="en">
   <title>To change the source environment</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <uicontrol>Settings</uicontrol> and click <uicontrol>Settings</uicontrol> again.</cmd>
            <info>
               <p>
                  <fig>
                     <image height="250"
                            placement="break"
                            width="499"
                            href="../attachments/98687609/98687605.png"/>
                  </fig>
               </p>
            </info>
         </step>
         <step>
            <cmd>Under General, to keep you session active, select Remember Me.</cmd>
         </step>
         <step>
            <cmd>From <uicontrol>Select CRM</uicontrol>, select the environment that you want to work with.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>OK</uicontrol>. The following message appears.</cmd>
            <info>
               <fig>
                  <image height="133"
                         placement="break"
                         href="../attachments/98687609/98687606.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>OK</uicontrol>. Close all instances of excel and restart excel for the source changes to take effect.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
