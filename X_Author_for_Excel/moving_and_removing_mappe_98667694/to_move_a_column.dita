<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="MovingandRemovingMappedFields_Tomoveacolumn" xml:lang="en">
   <title>To move a column</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Close all open Display Maps and Save Maps.</cmd>
         </step>
         <step>
            <cmd>Highlight the column. Right-click and select <uicontrol>Cut</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Highlight the target column. Right-click and select <uicontrol>Paste</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Open the Display Map or Save Map and check the Mapped Details to confirm cells were properly remapped.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
