<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="InstallingXAuthorforExcelSalesforcePackageLicenses" xml:lang="en">
   <title>Salesforce Package Licenses</title>
   <conbody>
      <p>The following table describes the minimum Salesforce package licenses required for specific X-Author roles. For detailed information on required X-Author licenses and permissions, refer to <xref href="../getting_started_with_x_au_98667661/98667661.dita"
               format="dita">Getting Started with X-Author for Excel</xref>.</p>
      <p>
         <table>
            <tgroup cols="2">
               <colspec colname="col1"/>
               <colspec colname="col2"/>
               <thead>
                  <row>
                     <entry>
                        <p>Role</p>
                     </entry>
                     <entry>
                        <p>Salesforce Package License</p>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <p>Runtime User</p>
                     </entry>
                     <entry>
                        <p>X-Author for Excel</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>Designer</p>
                     </entry>
                     <entry>
                        <p>X-Author for Excel, X-Author Designer for Excel</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>Power Admin</p>
                     </entry>
                     <entry>
                        <p>X-Author for Excel, X-Author Designer for Excel, X-Author for Excel (Power Admin)</p>
                     </entry>
                  </row>
                  <row>
                     <entry>
                        <p>Presto User</p>
                     </entry>
                     <entry>
                        <p>X-Author for Excel, Document Generation, X-Author for Excel Document Generation</p>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </p>
   </conbody>
</concept>
