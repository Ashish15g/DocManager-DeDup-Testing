                     </entry>
                     <entry>
                        <p>Type</p>
                     </entry>
                     <entry>
                        <p>Notes</p>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <p>XAuthorForExcelSolution_0_1</p>
                     </entry>
                     <entry>
                        <p>Microsoft Managed Solution</p>
                     </entry>
                     <entry>
                        <p>
                           <b>This solution must be installed first.</b>
                        </p>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </p>
      <note type="note">
         <p>User must have System Administrator Role.</p>
      </note>
