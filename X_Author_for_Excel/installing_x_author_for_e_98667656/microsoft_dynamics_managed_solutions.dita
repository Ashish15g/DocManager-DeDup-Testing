<concept id="InstallingXAuthorforExcelMicrosoftDynamicsManagedSolutions"
         xml:lang="en">
   <title>Microsoft Dynamics Managed Solutions</title>
   <conbody>
      <p>The following Microsoft Dynamics managed solution must be installed: </p>
      <p>
         <table>
            <tgroup cols="3">
               <colspec colname="col1"/>
               <colspec colname="col2"/>
               <colspec colname="col3"/>
               <thead>
                  <row>
