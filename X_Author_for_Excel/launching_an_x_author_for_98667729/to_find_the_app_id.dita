<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="LaunchinganXAuthorforExcelAppfromMicrosoftDynamicsTofindtheAppId"
      xml:lang="en">
   <title>To find the App Id</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to <uicontrol>Marketing &gt; Apps </uicontrol>to display the X-Author view in Dynamics that lists all the X-Author apps stored in your org.</cmd>
         </step>
         <step>
            <cmd>Click on the Application Name to view its details.</cmd>
            <info>
               <fig>
                  <image height="250"
                         placement="break"
                         width="531"
                         href="../attachments/98667729/98668024.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Make a note of the Unique Id displayed in the App information screen. You will use this App Id in the next task.</cmd>
            <info>
               <fig>
                  <image height="250"
                         placement="break"
                         width="349"
                         href="../attachments/98667729/98668025.png"/>
               </fig>
            </info>
         </step>
      </steps>
   </taskbody>
</task>
