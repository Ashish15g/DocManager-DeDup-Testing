<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="WorkingwithSaveMaps_TocreateaDisplayMapforOtherFields"
      xml:lang="en">
   <title>To create a Display Map for Other Fields</title>
   <taskbody>
      <steps>
         <step>
            <cmd>From the X-Author ribbon, click <uicontrol>Save Map</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Create </uicontrol>(or select an existing Save Map and click <uicontrol>Edit</uicontrol>).</cmd>
         </step>
         <step>
            <cmd>In the Name field, enter a name for your Save Map. Pick a name that makes it easy to distinguish from your other Save Maps.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Add Other Fields</uicontrol>.</cmd>
            <info>
               <fig>
                  <image height="400"
                         placement="break"
                         width="482"
                         href="../attachments/98667692/98668087.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Select <uicontrol>Individual</uicontrol> or <uicontrol>List</uicontrol> from the Type drop-down.</cmd>
         </step>
         <step>
            <cmd>Select the <uicontrol>Vertical</uicontrol> layout. </cmd>
         </step>
         <step>
            <cmd>Use the Search dialog or navigate the object hierarchy to locate fields. Add fields to the Save Map by dragging them from the panel and dropping them onto the Excel worksheet. You can search for specific fields using the Search box. </cmd>
            <info>
               <fig>
                  <image height="400"
                         placement="break"
                         href="../attachments/98667692/98668086.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>After adding one or more fields, click <uicontrol>Add to Save Map</uicontrol>. The Save Map now displays the added fields in the Save Map panel and "Save Only" as the Field Type.</cmd>
            <info>
               <fig>
                  <image height="400"
                         placement="break"
                         href="../attachments/98667692/98668085.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol> and <uicontrol>Close</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.
            </cmd>
         </step>
      </steps>
      <postreq>
         <note type="note">
            <p>For information on adding Matrix Map sections to Save Maps, refer to <xref href="../creating_a_matrix_9866771_98667719/98667719.dita"
                     format="dita">Creating a Matrix</xref> under Advanced App Design.</p>
         </note>
      </postreq>
   </taskbody>
</task>
