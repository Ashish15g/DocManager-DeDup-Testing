<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="WorkingwithSaveMaps_TodeleteanexistingSaveMap" xml:lang="en">
   <title>To delete an existing Save Map</title>
   <taskbody>
      <context>
         <note type="note">
            <p>You cannot delete Save Maps that are used in a Save action.</p>
         </note>
      </context>
      <steps>
         <step>
            <cmd>Click <uicontrol>Save Map</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>From the list of existing Save Maps, select one and click <uicontrol>Delete</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
