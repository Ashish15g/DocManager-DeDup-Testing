<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="ExecutingActionsWhentheAppisopenedfromExcel" xml:lang="en">
   <title>When the App is opened from Excel</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <uicontrol>Action Flow</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Select the <uicontrol>Auto Execute (Regular)</uicontrol> check box for the action flow that should execute automatically.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Cancel</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
