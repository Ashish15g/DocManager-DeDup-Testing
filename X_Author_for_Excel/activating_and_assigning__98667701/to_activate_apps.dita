<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="ActivatingandAssigningAppsToactivateapps" xml:lang="en">
   <title>To activate apps</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Log in to Salesforce.</cmd>
         </step>
         <step>
            <cmd>In the <xref href="http://Force.com" format="html" scope="external">
                  <u>Force.com</u>
               </xref> app menu, click <uicontrol>X-Author for Excel</uicontrol>.
            </cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Apps</uicontrol>.
            </cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Edit</uicontrol>
               <uicontrol>next to the newly created app.</uicontrol>
            </cmd>
         </step>
         <step>
            <cmd>Click the <uicontrol>Activate</uicontrol> check box and click <uicontrol>Save</uicontrol>.</cmd>
         </step>
      </steps>
      <postreq>
         <p>The app has been activated. Now you can assign it to users.</p>
      </postreq>
   </taskbody>
</task>
