                            href="../attachments/98667728/98667997.png"/>
                  </fig>
               </p>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol> and <uicontrol>Save App</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
