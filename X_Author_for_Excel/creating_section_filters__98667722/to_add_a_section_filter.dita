<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="CreatingSectionFilters_Toaddasectionfilter" xml:lang="en">
   <title>To add a section filter</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <uicontrol>Matrix Map</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Select the desired Matrix Map and click <uicontrol>Edit</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click the <uicontrol>Sections</uicontrol> tab.</cmd>
         </step>
         <step>
            <cmd>Click the lookup icon<image placement="inline" href="../attachments/98667722/98667796.png"/> next to a Section to open the filters window.</cmd>
         </step>
         <step>
            <cmd>Add additional rows as needed. Refer to the Query Action section for information on adding rows.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol> and click <uicontrol>Close</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
