<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="Example_OpportunityForecastApplicationTocreateaSaveMap"
      xml:lang="en">
   <title>To create a Save Map</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click <uicontrol>Save Maps</uicontrol> and select <uicontrol>Create</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>In the <uicontrol>Name</uicontrol> field, enter <i>Main</i>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Add Display Map Fields</uicontrol> and select <i>
                  <uicontrol>Amount</uicontrol>
               </i> and <i>
                  <uicontrol>Stage</uicontrol>
               </i>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Apply</uicontrol> and then click <uicontrol>Close</uicontrol> for the Save Map.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
