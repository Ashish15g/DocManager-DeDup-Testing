<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="Example_OpportunityForecastApplicationTocreateaSaveAction"
      xml:lang="en">
   <title>To create a Save Action</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the arrow under <uicontrol>Actions</uicontrol> and select <uicontrol>Save</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Enter <i>Save Opportunities</i> into the <uicontrol>Action Name</uicontrol> field.</cmd>
         </step>
         <step>
            <cmd>Select <uicontrol>Main</uicontrol> from the <uicontrol>Save Map</uicontrol> list.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.</cmd>
         </step>
      </steps>
      <postreq>
         <p>Now that you have created your actions, you need to create Action Flows to retrieve and display data and to save data.</p>
      </postreq>
   </taskbody>
</task>
