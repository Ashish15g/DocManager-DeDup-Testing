<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="Example_OpportunitiesbyAccountAppTocreateaSaveMap" xml:lang="en">
   <title>To create a Save Map</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Select <uicontrol>Save Map</uicontrol> and then click <uicontrol>Create</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>In the Name field, type <i>Main</i>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Add Display Map Fields</uicontrol> and select <i>
                  <uicontrol>Amount</uicontrol>
               </i> and <i>
                  <uicontrol>Stage</uicontrol>
               </i>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Apply</uicontrol> and then click <uicontrol>Save</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save App</uicontrol>.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
