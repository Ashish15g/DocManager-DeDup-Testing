<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="UsingtheDataMigrationWizard_TostartbuildinganewDataMigrationappusingtheWizard"
      xml:lang="en">
   <title>To start building a new Data Migration app using the Wizard</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Go to the X-Author for Excel Designer tab and Connect to your instance.</cmd>
         </step>
         <step>
            <cmd>From the X-Author for Excel Designer ribbon, click on the arrow next to <uicontrol>Data Migration</uicontrol>.</cmd>
            <info>
               <fig>
                  <image height="154"
                         placement="break"
                         width="312"
                         href="../attachments/98667704/98667811.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click <uicontrol>New </uicontrol>to open the Data Migration Dashboard.</cmd>
         </step>
         <step>
            <cmd>Enter an <uicontrol>App Name</uicontrol> for your Data Migration app.</cmd>
         </step>
      </steps>
      <postreq>
         <p>
            <uicontrol>Next step:</uicontrol>
            <xref href="../adding_objects_and_fields_98667711/98667711.dita"
                  format="dita">Add some objects and fields</xref>.</p>
      </postreq>
   </taskbody>
</task>
