<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="CheckOutActionTocreateaCheckOutaction" xml:lang="en">
   <title>To create a Check-Out action</title>
   <taskbody>
      <steps>
         <step>
            <cmd> Click on the arrow beneath the <uicontrol>Actions</uicontrol> button and select <uicontrol>Check-Out</uicontrol>. </cmd>
         </step>
         <step>
            <cmd>In the <uicontrol>Action Name</uicontrol> field, type a descriptive name for the action.</cmd>
         </step>
         <step>
            <cmd>From <uicontrol>Object</uicontrol>, select an object and click <uicontrol>Save</uicontrol>. The list of objects will include any object marked as Individual in Objects.
               </cmd>
            <info>
               <p>
                  <image placement="inline" href="../attachments/98667683/98667937.png"/>
               </p>
            </info>
         </step>
      </steps>
   </taskbody>
</task>
