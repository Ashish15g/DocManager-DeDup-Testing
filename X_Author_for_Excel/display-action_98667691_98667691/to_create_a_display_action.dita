<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="DisplayActionTocreateaDisplayAction" xml:lang="en">
   <title>To create a Display Action</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the lower section of the <uicontrol>Actions</uicontrol> button and select <uicontrol>Display</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>In the <uicontrol>Action Name field</uicontrol>, enter a name for your Display Action. Use a name that describes the records to display.</cmd>
            <info>
               <fig>
                  <image height="224"
                         placement="break"
                         width="386"
                         href="../attachments/98667691/190354470.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click the drop-down next to Display Map to select the Display Map to use.</cmd>
         </step>
         <step>
            <cmd>To disable excel events while performing display actions, select the <uicontrol>Disable Excel Events during execution</uicontrol> checkbox.</cmd>
         </step>
         <step>
            <cmd>To <xref href="to_show_query_filters_in_the_worksheet.dita#DisplayActionQueryFilter">display query filters in the worksheet</xref>, select the <uicontrol>Show Query Filters</uicontrol> checkbox.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save.</uicontrol>
            </cmd>
         </step>
      </steps>
   </taskbody>
</task>
