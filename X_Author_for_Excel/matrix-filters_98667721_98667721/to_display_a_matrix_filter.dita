<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="MatrixFilters_Todisplayamatrixfilter" xml:lang="en">
   <title>To display a matrix filter</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Click the <uicontrol>Fields</uicontrol> tab.</cmd>
         </step>
         <step>
            <cmd>Select <uicontrol>Individual</uicontrol> as the Type.</cmd>
         </step>
         <step>
            <cmd>Select a field and drag it onto the worksheet outside the matrix.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save</uicontrol>.</cmd>
         </step>
         <step>
            <cmd>Click <uicontrol>Save Application</uicontrol>.</cmd>
         </step>
      </steps>
      <postreq>
         <p>A matrix filter is displayed.</p>
      </postreq>
   </taskbody>
</task>
