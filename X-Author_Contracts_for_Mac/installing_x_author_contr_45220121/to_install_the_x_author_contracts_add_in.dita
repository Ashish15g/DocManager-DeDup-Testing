<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="InstallingXAuthorContractsToinstalltheXAuthorContractsaddin" xml:lang="en">
   <title>To install the X-Author Contracts add-in</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Download the X-Author Contracts for Mac <uicontrol>pkg </uicontrol>file using the link provided by your Apttus representative.</cmd>
         </step>
         <step>
            <cmd>Double-click the <uicontrol>pkg</uicontrol> file (right-click and Open if file is untrusted). </cmd>
            <info>
               <fig>
                  <image height="400" placement="break" href="../attachments/45220121/51576955.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Follow the installation instructions to complete installation.</cmd>
            <info>
               <fig>
                  <image height="400" placement="break" href="../attachments/45220121/51576957.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Quit any open instances of Microsoft Word.</cmd>
         </step>
      </steps>
   </taskbody>
</task>