<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="InstallingXAuthorContractsTolaunchtheXAuthorContractsaddin" xml:lang="en">
   <title>To launch the X-Author Contracts add-in</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Open Microsoft Word.</cmd>
         </step>
         <step>
            <cmd>Go to <menucascade>
                  <uicontrol>Insert</uicontrol>
                  <uicontrol>My Add-ins</uicontrol>
               </menucascade>.</cmd>
         </step>
         <step>
            <cmd>Choose <uicontrol>Apttus X-Author</uicontrol> from the list of add-ins displayed in
               the drop-down. </cmd>
            <stepresult>
               <p>Apttus X-Author loads in a new pane to the right of the document window.</p>
               <fig id="fig_ecw_2cq_12c">
                  <image height="250" placement="break" width="641"
                     href="../attachments/45220121/51576921.png" id="image_fcw_2cq_12c"/>
               </fig>
            </stepresult>
         </step>
      </steps>
   </taskbody>
</task>