<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="WorkingwithClauses_viewclause" xml:lang="en">
   <title>To view a clause</title>
   <taskbody>
      <steps>
         <step>
            <cmd>Hover over the <image placement="inline" width="20" href="../attachments/45220112/49086827.png" id="image_ik2_y54_12c"/><uicontrol>Document </uicontrol>tab and select <uicontrol>Clauses</uicontrol> to
               open the Documents Panel.</cmd>
            <info>
               <fig>
                  <image height="250" placement="break" width="272" href="../attachments/45220112/49086814.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>To view only changed clauses, select "Show Only Changed Clauses" at the top of the panel.</cmd>
            <info>
               <fig>
                  <image height="250" placement="break" width="268" href="../../global_images/images/102413353.png"/>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click on a clause name in the list. </cmd>
         </step>
      </steps>
      <result id="result_y5t_hv4_12c">
         <p>The document scrolls to highlight the selected clause.</p>
         <fig id="fig_e2q_bv4_12c">
            <image height="400" placement="break" href="../attachments/45220112/49086820.png" id="image_f2q_bv4_12c"/>
         </fig>
         <note type="note" id="note_wgt_2v4_12c">
            <p>Sections and supporting documents do not display in the list of clauses if they
               contain a smart field.</p>
         </note>
      </result>
   </taskbody>
</task>