<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="OpeningAgreementsinSalesforceToopenanagreementinSalesforce" xml:lang="en">
   <title>To open an agreement in Salesforce</title>
   <taskbody>
      <steps>
         <step>
            <cmd>
               <xref href="../logging_in_to_x_author_co_45711457/45711457.dita" format="dita">Connect to X-Author Contracts</xref>.</cmd>
         </step>
         <step>
            <cmd>
               <xref href="../checking_out_an_agreement_45220108/45220108.dita" format="dita">Check-out</xref> the agreement document for the agreement you want to view.</cmd>
         </step>
         <step>
            <cmd>From the X-Author menu, hover over the <image placement="inline" width="16"
                  href="../attachments/45711369/50036966.png" id="image_l1q_pyp_12c"/>  icon and
               click <uicontrol>Open in Salesforce.</uicontrol>
            </cmd>
            <info>
               <fig>
                  <image height="250" placement="break" width="315"
                     href="../attachments/45711369/50036967.png"/>
               </fig>
            </info>
            <stepresult>
               <p>A separate browser window is opened and the agreement is loaded in Salesforce (you
                  may have to log in again). </p>
               <fig id="fig_okh_syp_12c">
                  <image height="400" placement="break" width="760"
                     href="../attachments/45711369/50036968.png" id="image_pkh_syp_12c"/>
               </fig>
            </stepresult>
         </step>
      </steps>
   </taskbody>
</task>