<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="scenario_4_bold_used_for_menu_navigation_sequence" xml:lang="en-us">
   <title>Scenario 4 — Bold used for Menu navigation sequence</title>
   <shortdesc>Consider a procedure step that reads: "Go to File &gt; Save As ."</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Bold</keyword>
        <keyword>navigation</keyword>
        <keyword>sequence</keyword>
        <keyword>File</keyword>
        <keyword>Save</keyword>
        <keyword>Scenario</keyword>
        <indexterm>Bold</indexterm>
        <indexterm>navigation</indexterm>
        <indexterm>sequence</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
         <p>Consider a procedure step that reads: "Go to <b>File</b>
            <b>&gt;</b>
            <b>Save As</b>."</p>
<table frame="all" colsep="1" rowsep="1">
            <title>Bold used for menu sequence</title>
   <tgroup cols="2">
      <colspec colname="c1"/>
      <colspec colname="c2"/>
      <thead>
         <row>
            <entry>
               <b>.docx Style / Input</b>
            </entry>
            <entry>
               <b>DITA Output</b>
            </entry>
         </row>
      </thead>
      <tbody>
                  <row>
                     <entry>Go to <b>File</b>
                        <b>&gt;</b>
                        <b>Save As</b>   (Entire menu path bolded or two menu options are bold)</entry>
                     <entry>
                        <codeblock id="codeblock_z4v_wlw_jkc">
&lt;taskbody>
  &lt;steps>
    &lt;step>
      &lt;cmd>
        Go to
        &lt;menucascade>
          &lt;uicontrol>File&lt;/uicontrol>
          &lt;uicontrol>Save As&lt;/uicontrol>
        &lt;/menucascade>.
      &lt;/cmd>
    &lt;/step>
  &lt;/steps>
&lt;/taskbody></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
<p><b>Result:</b>The converter detects menu navigation patterns and maps them into a <codeph>&lt;menucascade&gt;</codeph> structure containing nested <codeph>&lt;uicontrol&gt;</codeph> elements.</p>
      </section>
   </refbody>
</reference>
