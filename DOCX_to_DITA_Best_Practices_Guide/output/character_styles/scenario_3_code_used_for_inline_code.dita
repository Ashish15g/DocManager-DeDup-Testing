<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="scenario_3_code_used_for_inline_code" xml:lang="en-us">
   <title>Scenario 3 — Code used for inline code</title>
   <shortdesc>Consider a paragraph that contains a shell script name.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Code</keyword>
        <keyword>inline</keyword>
        <keyword>deploy</keyword>
        <keyword>Scenario</keyword>
        <keyword>using</keyword>
        <keyword>elevated</keyword>
        <indexterm>Code</indexterm>
        <indexterm>inline</indexterm>
        <indexterm>deploy</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>  <section>
    <p>Consider a paragraph that contains a shell script name.</p>
       <table frame="all" colsep="1" rowsep="1">
            <title>Code used for inline code</title>
         <tgroup cols="2">
          <colspec colname="c1" colwidth="1*"/>
          <colspec colname="c2" colwidth="1.37*"/>
          <thead>
            <row>
              <entry>
                <b>.docx Style / Input</b>
              </entry>
              <entry>
                <b>DITA Output</b>
              </entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>Run <b>deploy.sh</b> using elevated privileges. (deploy.sh = Courier
                New)</entry>
              <entry>
                <codeblock id="codeblock_l4f_n3w_jkc">
&lt;taskbody>
  &lt;steps>
    &lt;step>
      &lt;cmd>
        Run &lt;codeph>deploy.sh&lt;/codeph> using elevated privileges.
      &lt;/cmd>
    &lt;/step>
  &lt;/steps>
&lt;/taskbody></codeblock>
              </entry>
            </row>
          </tbody>
        </tgroup>
         </table><p>
            <b>Result:</b>Monospace text representing code or scripts is mapped to <codeph>&lt;codeph&gt;</codeph>.</p>
  </section></refbody>
</reference>
