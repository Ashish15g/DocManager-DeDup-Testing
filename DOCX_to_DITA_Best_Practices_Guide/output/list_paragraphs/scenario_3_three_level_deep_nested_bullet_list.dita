<reference id="scenario_3_three_level_deep_nested_bullet_list" xml:lang="en-us">
   <title>Scenario 3 — Three-level deep nested bullet list</title>
   <shortdesc>Consider a list nested three levels deep — grandchild items indented beneath child items.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>level</keyword>
        <keyword>nested</keyword>
        <keyword>List</keyword>
        <keyword>Bullet</keyword>
        <keyword>Three</keyword>
        <keyword>bullet</keyword>
        <indexterm>level</indexterm>
        <indexterm>nested</indexterm>
        <indexterm>List</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
      <p>Consider a list nested three levels deep — grandchild items indented beneath child items.</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Three-level nested bullet list</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>
                        <b>.docx Style / Input</b>
                     </entry>
                     <entry>
                        <b>DITA Output</b>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <b>[Heading 2]:</b> Infrastructure Types   <b>[List Bullet, level 0]:</b> Hardware    <b>[List Bullet, level 1]:</b> Servers      <b>[List Bullet, level 2]:</b> Rack-mounted      <b>[List Bullet, level 2]:</b> Tower</entry>
                     <entry>
                        <codeblock id="codeblock_cnq_bvz_kkc">
&lt;concept id="infrastructure_types">
  &lt;title>Infrastructure Types&lt;/title>
  &lt;conbody>
    &lt;ul>
      &lt;li>
        Hardware
        &lt;ul>
          &lt;li>
            Servers
            &lt;ul>
              &lt;li>Rack-mounted&lt;/li>
              &lt;li>Tower&lt;/li>
            &lt;/ul>
          &lt;/li>
        &lt;/ul>
      &lt;/li>
    &lt;/ul>
  &lt;/conbody>
&lt;/concept></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
<note type="note">Avoid nesting beyond three levels; restructure the content using separate topics or a table instead.</note>
      </section>
   </refbody>
</reference>