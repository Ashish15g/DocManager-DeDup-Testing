<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA 2.x Reference//EN" "reference.dtd">
<reference id="scenario_5_image_with_caption" xml:lang="en-us">
   <title>Scenario 5 — Image with caption</title>
   <shortdesc>Consider an image of the printer's ink tank area with a Caption-styled paragraph below it</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Image</keyword>
        <keyword>caption</keyword>
        <keyword>image</keyword>
        <keyword>Caption</keyword>
        <keyword>locations</keyword>
        <keyword>Scenario</keyword>
        <indexterm>Image</indexterm>
        <indexterm>caption</indexterm>
        <indexterm>image</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody>
      <section>
      <p>Consider an image of the printer's ink tank area with a Caption-styled paragraph below it reading "Figure 1: Ink tank and cap locations".</p>
         <table frame="all" colsep="1" rowsep="1">
            <title>Image with a caption</title>
            <tgroup cols="2">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <thead>
                  <row>
                     <entry>
                        <b>.docx Style / Input</b>
                     </entry>
                     <entry>
                        <b>DITA Output</b>
                     </entry>
                  </row>
               </thead>
               <tbody>
                  <row>
                     <entry>[Inline image: ink_tank_area.png] [Caption style]: Figure 1: Ink tank and cap locations</entry>
                     <entry>
                        <codeblock id="codeblock_k12_lqy_kkc">
&lt;fig>
  &lt;title>Ink tank and cap locations&lt;/title>
  &lt;image href="media/ink_tank_area.png"/>
&lt;/fig></codeblock>
                     </entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
<p><b>Result:</b>The Caption-styled paragraph text becomes the <codeph>&lt;title&gt;</codeph> element inside <codeph>&lt;fig&gt;</codeph>.</p>
         </section>
   </refbody>
</reference>
