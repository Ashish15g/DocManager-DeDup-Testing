                                                <fo:inline>Login via <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="http://login.salesforce.com" fox:alt-text="http://login.salesforce.com">http://login.salesforce.com</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="http://login.salesforce.com" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
