                                                <fo:inline>Click the <fo:inline font-weight="bold">X-Author Chatter</fo:inline> tab or click to display
                                                  all tabs and then select it.</fo:inline>
                                                <fo:block>
                                                  <fo:inline chfox:inch="true" height="14px" max-width="100%" width="16px"><fo:inline><fo:external-graphic src="file:/C:/Users/adity/Downloads/Power_Documentation/X-Author%20for%20Chatter%20Integration%20Guide/output/x_author_for_chatter_integration_guide/attachments/98670296/98671089.jpg" fox:alt-text="placeholder" max-width="100%" scaling="non-uniform" content-width="16px" content-height="14px"/></fo:inline></fo:inline>
