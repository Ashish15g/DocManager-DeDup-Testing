                                            <fo:inline font-weight="bold">Results</fo:inline>
                                        </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">X-Author is
                                            now ready for use with the Microsoft product, enabling
                                            you to use chatter to collaborate on your work.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">
                                            <fo:inline font-weight="bold">Next
