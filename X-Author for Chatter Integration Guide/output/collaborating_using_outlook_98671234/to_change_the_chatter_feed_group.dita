<task id="to_change_the_chatter_feed_group_08847c" xml:lang="en-us">
   <title>To change the chatter feed group</title>
   <shortdesc>Prerequisites</shortdesc>
   <prolog>
      <author type="creator">user-0266f</author>
      <critdates>
         <revised modified="Nov 05, 2018"/>
      </critdates>
