<task id="to_upload_a_version_8436b6" xml:lang="en-us">
   <title>To upload a version</title>
   <shortdesc>Prerequisites</shortdesc>
   <prolog>
      <author type="creator">user-0266f</author>
      <critdates>
         <revised modified="Nov 05, 2018"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>upload</keyword>
        <keyword>version</keyword>
        <keyword>document</keyword>
        <keyword>Chatter</keyword>
        <keyword>Click</keyword>
        <keyword>click</keyword>
        <indexterm>upload</indexterm>
        <indexterm>version</indexterm>
        <indexterm>document</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>
            <b>Prerequisites</b>
         </p>
         <ul>
            <li>The file must be saved on your computer and have not previously been uploaded to Salesforce.</li>
            <li>There must be an existing file in Chatter &gt; Files that you want to overwrite with this new file.</li>
         </ul>
         <p>
            <b>Steps</b>
         </p>
      </context>
      <steps>
         <step>
            <cmd>Click <b>Upload Version</b>, select the Scope the file has in Chatter, enter a name, and click .</cmd>
            <info>
               <image href="../attachments/98670312/98671122.jpg" width="21" height="16" placement="inline">
                     <alt>placeholder</alt>
                  </image>
               
            </info>
         </step>
         <step>
            <cmd>Click <b>Select</b> for the document that matches the document you want to upload.</cmd>
         </step>
         <step>
            <cmd>Enter details about this version of the document, to ensure there is a useful audit trail entry and click <b>OK.</b>
            </cmd>
         </step>
      </steps>
      <result>
         <p>
            <b>Results</b>
A confirmation dialog box indicates the upload was successful and displays the new version of the file.</p>
      </result>
   </taskbody>
</task>