        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody><section><p>Consistent file naming is essential for maintainability, searchability, and automation. To maintain consistent file names, follow these guidelines:</p>
<table frame="all" colsep="1" rowsep="1">
            <title>topic naming rules</title>
            <tgroup cols="3">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <colspec colname="c3"/>
               <thead>
                  <row>
                     <entry>Rule</entry>
                     <entry>Example</entry>
                     <entry>Rationale</entry>
                  </row>                  
               </thead>
               <tbody>
                  <row>
                     <entry>Use topic type prefix</entry>
                     <entry>c_, t_, r_, ts_, g_</entry>
                     <entry>Identifies the content type instantly</entry>
                  </row>
                  <row>
                     <entry>Make names unique</entry>
                     <entry>t_install_application.dita, t_install_application_1.dita</entry>
                     <entry>Avoids reference errors</entry>
                  </row>
                  <row>
                     <entry>Use lowercase only</entry>
                     <entry>t_install_application.dita</entry>
                     <entry>Avoids case-sensitivity issues</entry>
                  </row>
                  <row>
                     <entry>Use underscores as separators</entry>
                     <entry>c_system_overview.dita</entry>
                     <entry>Avoids parsing consistency issues</entry>
                  </row>
                  <row>
                     <entry>Keep names under 50 characters</entry>
                     <entry>t_configure_db.dita</entry>
                     <entry>Avoids OS path length issues</entry>
                  </row>
               </tbody>
            </tgroup>
         </table></section></refbody>
</reference>
