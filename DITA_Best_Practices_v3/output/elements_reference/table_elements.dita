   <refbody>
      <section id="sec_d467e7">
         <table frame="all" colsep="1" rowsep="1">
            <title>common table elements</title>
            <tgroup cols="3">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <colspec colname="c3"/>
               <thead>
                  <row>
                     <entry>Element</entry>
                     <entry>Parent Topic Type</entry>
                     <entry>Purpose</entry>
                  </row>                  
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>&lt;table&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Container for structured tabular data</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;tgroup&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Defines table structure and column count</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;colspec&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Defines column width and properties</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;thead&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Contains header row(s)</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;tbody&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Contains data row(s)</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;row&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Single table row</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;entry&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Single table cell</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;simpletable&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Lightweight table for simple, structured lists (for example, two‑column name‑value lists) without full <codeph>&lt;tgroup&gt;</codeph>/<codeph>&lt;colspec&gt;</codeph> structure.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;sthead&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Optional header row for a simple table; contains <codeph>&lt;stentry&gt;</codeph> elements.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;strow&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>A row in a simple table; contains <codeph>&lt;stentry&gt;</codeph> elements.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;stentry&gt;</codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>A cell in a simple table row; equivalent to <codeph>&lt;entry&gt;</codeph> but in a <codeph>&lt;simpletable&gt;</codeph>.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;parml&gt;</codeblock>
                     </entry>
                     <entry>Reference and Concept</entry>
                     <entry>Container for a parameter list; used to document function or API parameters</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;plentry&gt;</codeblock>
                     </entry>
                     <entry>Reference and Concept</entry>
                     <entry>One parameter entry; contains a<codeph>&lt;pt&gt;</codeph> (parameter term) and one or more <codeph>&lt;pd&gt;</codeph>(parameter descriptions)</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;pt&gt;</codeblock>
                     </entry>
                     <entry>Reference and Concept</entry>
                     <entry>The name or label of a parameter in a parameter list.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>&lt;pd&gt;</codeblock>
                     </entry>
                     <entry>Reference and Concept</entry>
                     <entry>The description or explanation of a parameter in a parameter list.</entry>
                  </row>
               </tbody>
            </tgroup>
         </table>
      </section>
   </refbody>
</reference>
