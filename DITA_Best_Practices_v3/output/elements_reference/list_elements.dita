<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="list_elements" xml:lang="en-us">
   <title>List elements</title>
   <shortdesc>in DITA provide structured ways to present itemized content, such as bulleted and numbered lists,</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>elements</keyword>
        <keyword>definition</keyword>
        <keyword>List</keyword>
        <keyword>order</keyword>
        <keyword>lists</keyword>
        <keyword>Bulleted</keyword>
        <indexterm>elements</indexterm>
        <indexterm>definition</indexterm>
        <indexterm>List</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <refbody><section><p>List elements in DITA provide structured ways to present itemized content, such as bulleted and numbered lists, definition lists, and stepbystep procedures.</p>
<table frame="all" colsep="1" rowsep="1">
            <title>common list elements</title>
            <tgroup cols="3">
               <colspec colname="c1"/>
               <colspec colname="c2"/>
               <colspec colname="c3"/>
               <thead>
                  <row>
                     <entry>Elements</entry>
                     <entry>Parent Topic Type</entry>
                     <entry>Purpose</entry>
                  </row>                  
               </thead>
               <tbody>
                  <row>
                     <entry>
                        <codeblock>
                           
                           &lt;ul&gt;&lt;li&gt;…&lt;/li&gt;&lt;/ul&gt;
                           
                        </codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Bulleted list, no order required. Sequence is irrelevant.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>
                           
                           &lt;ol&gt;&lt;li&gt;…&lt;/li&gt;&lt;/ol&gt;
                           
                        </codeblock>
                     </entry>
                     <entry>All</entry>
                     <entry>Numbered list, order is categorical. They are ordered but non-procedural.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>
                           
                              
                              &lt;steps&gt;&lt;step&gt;&lt;cmd&gt;…&lt;/cmd&gt;&lt;/step&gt;&lt;/steps&gt;
                              
                           
                        </codeblock>
                     </entry>
                     <entry>Task</entry>
                     <entry>Numbered list, order matters for execution. They are procedural. They include steps, sub-steps, information, and step results.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>
                           &lt;choices&gt;…&lt;/choices&gt;
                        </codeblock>
                     </entry>
                     <entry>Task and Troubleshooting</entry>
                     <entry>Bulleted list of mutuallyexclusive options.</entry>
                  </row>
                  <row>
                     <entry>
                        <codeblock>
                           
                              
                              &lt;dl&gt;&lt;dlentry&gt;&lt;dt&gt;…&lt;/dt&gt;&lt;dd&gt;…&lt;/dd&gt;&lt;/dlentry&gt;&lt;/dl&gt;
                              
                           
                        </codeblock>
                     </entry>
                     <entry>Concept, Reference, and Glossary</entry>
                     <entry>Definition list with definition list entry, definition term, and definition description.</entry>
                  </row>
               </tbody>
            </tgroup>
         </table></section></refbody>
</reference>
