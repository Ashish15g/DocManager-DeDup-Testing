<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE concept
  PUBLIC "-//OASIS//DTD DITA 2.x Concept//EN" "concept.dtd">
<concept id="topicmeta_in_maps" xml:lang="en-us">
   <title>Topicmeta in maps</title>
   <prolog>
    <metadata>
      <keywords>
        <keyword>topic</keyword>
        <keyword>Topicmeta</keyword>
        <keyword>within</keyword>
        <keyword>topicmeta</keyword>
        <keyword>element</keyword>
        <keyword>define</keyword>
        <indexterm>topic</indexterm>
        <indexterm>Topicmeta</indexterm>
        <indexterm>within</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody>
      <p>The <codeph>&lt;topicmeta&gt;</codeph> element is used within maps to define metadata about a topic in a specific context, rather than within the topic itself. This allows the same topic to appear differently in multiple outputs.</p>
   </conbody>
</concept>
