               <tbody>
                  <row>
                     <entry>Missing <codeph>&lt;shortdesc&gt;</codeph>
                     </entry>
                     <entry>Topic goes directly to body</entry>
                     <entry>Add summary ≤50 words</entry>
                  </row>
                  <row>
                     <entry>Mixed topic type</entry>
                     <entry>
                        <codeph>&lt;conbody&gt;</codeph> contains <codeph>&lt;steps&gt;</codeph>
                     </entry>
                     <entry>Split into separate topics</entry>
                  </row>
                  <row>
                     <entry>Passive <codeph>&lt;cmd&gt;</codeph>
                     </entry>
                     <entry>"is clicked," "should be"</entry>
                     <entry>Rewrite with imperative verb</entry>
                  </row>
                  <row>
                     <entry>Bold used for semantics</entry>
                     <entry>
                        <codeblock>
                           &lt;b&gt;Note:&lt;/b&gt;
                        </codeblock>
                     </entry>
                     <entry>Replace with <codeph>&lt;note&gt;</codeph> element</entry>
                  </row>
                  <row>
                     <entry>Missing <codeph>@id</codeph>
                     </entry>
                     <entry>Root element lacks id</entry>
                     <entry>Add id matching filename</entry>
                  </row>
                  <row>
                     <entry>Missing <codeph>&lt;alt&gt;</codeph>
                     </entry>
                     <entry>
                        <codeph>&lt;image&gt;</codeph> without alt text</entry>
                     <entry>Add descriptive alt text</entry>
                  </row>
                  <row>
                     <entry>Duplicate filenames</entry>
                     <entry>Two files with same name</entry>
                     <entry>Add suffix; update references</entry>
                  </row>
