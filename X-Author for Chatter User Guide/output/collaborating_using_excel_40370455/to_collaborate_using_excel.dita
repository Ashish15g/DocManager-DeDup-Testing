<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_collaborate_using_excel_daf02c" xml:lang="en-us">
   <title>To Collaborate Using Excel</title>
   <shortdesc>/Chatter icon/</shortdesc>
   <prolog>
      <author type="creator">Chris Castro</author>
      <critdates>
         <revised modified="Jun 22, 2016"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>Chatter</keyword>
        <keyword>workbook</keyword>
        <keyword>content</keyword>
        <keyword>attached</keyword>
        <keyword>Excel</keyword>
        <keyword>Your</keyword>
        <indexterm>Chatter</indexterm>
        <indexterm>workbook</indexterm>
        <indexterm>content</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Create a new workbook or open an existing workbook in Word.</cmd>
         </step>
         <step>
            <cmd>Connect to X-Author Chatter as described in <xref href="../connecting_to_x_author_chatter_40370449/connecting_to_xauthor_chatter_online.dita">Connecting to X-Author Chatter Online</xref>.</cmd>
         </step>
         <step>
            <cmd>Select who you want to collaborate with in your Chatter feed by clicking one of the icons:</cmd>
            <info>
               <table>
                  <tgroup cols="2">
                     <colspec colname="c1"/>
                     <colspec colname="c2"/>
                     <tbody>
                        <row>
                           <entry>
                              <p>/Chatter icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be everyone in your organization with a Chatter account.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>/Group icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be all the members of the group you select.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>/Individual icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be the single individual you select.</p>
                           </entry>
                        </row>
                     </tbody>
                  </tgroup>
               </table>
            </info>
         </step>
         <step>
            <cmd> Make changes to the workbook using Excel and then choose what content to share.

/screenshot of chatter window and drop-down/</cmd>
            <info>
               <table>
                  <tgroup cols="2">
                     <colspec colname="c1"/>
                     <colspec colname="c2"/>
                     <tbody>
                        <row>
                           <entry>
                              <p>Post</p>
                           </entry>
                           <entry>
                              <p>Comments you provide in Chatter are included, but no part of the workbook is included.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Selected Content</p>
                           </entry>
                           <entry>
                              <p>The selected content is exported and attached to the Chatter feed as a new xls file. All selected content must be in adjoining cells. The minimum content that can be selected is a whole cell. Selected text within a cell cannot be shared.(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire workbook is attached to the Chatter feed.</b>)</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Active Worksheet</p>
                           </entry>
                           <entry>
                              <p>The entire worksheet is copied and attached to the feed as a new xls file.(<b>Not currently supported. Choosing this option shares your Comments to the feed and the entire workbook is attached to the Chatter feed.</b>)</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Entire Workbook</p>
                           </entry>
                           <entry>
                              <p>The whole workbook is attached to the feed.</p>
                           </entry>
                        </row>
                     </tbody>
                  </tgroup>
               </table>
            </info>
         </step>
         <step>
            <cmd>Click <b>Share</b> to share your content to the Chatter feed.</cmd>
         </step>
      </steps>
   </taskbody>
</task>