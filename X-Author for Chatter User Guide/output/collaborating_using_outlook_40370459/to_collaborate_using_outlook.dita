<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="to_collaborate_using_outlook_d79d23" xml:lang="en-us">
   <title>To Collaborate Using Outlook</title>
   <shortdesc>/Chatter icon/</shortdesc>
   <prolog>
      <author type="creator">Chris Castro</author>
      <critdates>
         <revised modified="Jun 22, 2016"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>email</keyword>
        <keyword>Chatter</keyword>
        <keyword>Author</keyword>
        <keyword>Online</keyword>
        <keyword>Outlook</keyword>
        <keyword>message</keyword>
        <indexterm>email</indexterm>
        <indexterm>Chatter</indexterm>
        <indexterm>Author</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Create a new email or open an existing email.</cmd>
         </step>
         <step>
            <cmd>Load the X-Author Chatter Online add-in by doing one of the following:If you are creating a new email message, click the <b>Add-ins</b> icon at the top of the message window and choose <b>Ink Outlook Online</b> from the task pane to the right. X-Author opens inside the task pane.
/screenshot/If you are opening an existing email, click the <b>Ink Outlook Online</b> app link just below the recipient line of the email message. X-Author opens in a separate pane below the link.
/screenshot/</cmd>
            <substeps>
               <substep>
                  <cmd>If you are creating a new email message, click the <b>Add-ins</b> icon at the top of the message window and choose <b>Ink Outlook Online</b> from the task pane to the right. X-Author opens inside the task pane.
/screenshot/</cmd>
               </substep>
               <substep>
                  <cmd>If you are opening an existing email, click the <b>Ink Outlook Online</b> app link just below the recipient line of the email message. X-Author opens in a separate pane below the link.
/screenshot/</cmd>
               </substep>
            </substeps>
         </step>
         <step>
            <cmd>Connect to X-Author Chatter Online as described in <xref href="../connecting_to_x_author_chatter_40370449/connecting_to_xauthor_chatter_online.dita">Connecting to X-Author Chatter Online</xref>.</cmd>
         </step>
         <step>
            <cmd>Select who you want to collaborate with in your Chatter feed by clicking one of the icons:</cmd>
            <info>
               <table>
                  <tgroup cols="2">
                     <colspec colname="c1"/>
                     <colspec colname="c2"/>
                     <tbody>
                        <row>
                           <entry>
                              <p>/Chatter icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be everyone in your organization with a Chatter account.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>/Group icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be all the members of the group you select.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>/Individual icon/</p>
                           </entry>
                           <entry>
                              <p>Your audience will be the single individual you select.</p>
                           </entry>
                        </row>
                     </tbody>
                  </tgroup>
               </table>
            </info>
         </step>
         <step>
            <cmd>Choose how you want to share content to Chatter.

/screenshot of chatter window and drop-down/</cmd>
            <info>
               <table>
                  <tgroup cols="2">
                     <colspec colname="c1"/>
                     <colspec colname="c2"/>
                     <tbody>
                        <row>
                           <entry>
                              <p>Post</p>
                           </entry>
                           <entry>
                              <p>Enter a comment to solicit feedback, while not copying any content from the body of the email or email attachments.</p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Selected Content</p>
                           </entry>
                           <entry>
                              <p>
                                 <b>Not supported.</b>
                              </p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Selected Slides</p>
                           </entry>
                           <entry>
                              <p>
                                 <b>Not supported.</b>
                              </p>
                           </entry>
                        </row>
                        <row>
                           <entry>
                              <p>Entire Presentation</p>
                           </entry>
                           <entry>
                              <p>
                                 <b>Not supported.</b>
                              </p>
                           </entry>
                        </row>
                     </tbody>
                  </tgroup>
               </table>
            </info>
         </step>
         <step>
            <cmd>Click <b>Share</b> to add your comments to the Chatter feed.</cmd>
         </step>
      </steps>
   </taskbody>
</task>