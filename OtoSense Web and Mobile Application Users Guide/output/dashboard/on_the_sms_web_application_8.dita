<!DOCTYPE task
  PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="on_the_sms_web_application_8" xml:lang="en-us">
   <title>On the SMS web application</title>
   <shortdesc>To view health data:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>Health</keyword>
        <keyword>placeholder</keyword>
        <keyword>health</keyword>
        <keyword>Select</keyword>
        <keyword>motor</keyword>
        <keyword>application</keyword>
        <indexterm>Health</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>health</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To view health data:</p>
      </context>
      <steps id="steps_10314168">
         <step>
            <cmd>Log in to the SMS web application.</cmd>
         </step>
         <step>
            <cmd>Select a motor on the <xref href="../dashboard/search_for_a_motor.dita" format="dita">left navigation pane</xref> or on the <xref href="../dashboard/monitor_motor_condition_list_view.dita" format="dita">List view</xref> to display the motor’s information page.</cmd>
         </step>
         <step>
            <cmd>Select the History plot tab.</cmd>
         </step>
         <step>
            <cmd>Select the Health sub-tab.</cmd>
         </step>
         <step>
            <cmd>Select one or more components from the Motor conditions drop-down list.</cmd>
            <info>
               <fig>
                  <title>Health sub-tab - Options</title>
                  <image height="219" href="../media/image57.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click DRAW PLOT.</cmd>
            <info>
               <p>The health index plot of the selected components is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>To switch from one motor condition to another, click the names of the motor condition below the horizontal axis.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="293" href="../media/image58.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Health data plot</p>
            </info>
         </step>
         <step>
            <cmd>To zoom in on a specific time period, click and drag your mouse over the required dots. To zoom out, click Reset zoom on the bottom right of the page.</cmd>
            <info>
               <note type="note">Hover over a specific dot to view exact readings.</note>
               <fig>
                  <title>Health data - zoomed in</title>
                  <image height="299" href="../media/image59.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>For more information on health data, see section <b>Motor Condition Monitoring</b> in the Analytics User Guide.</p>
               <p>To download health data:</p>
            </info>
         </step>
         <step>
            <cmd>Click DATA DOWNLOAD on the top right of the Health sub-tab.</cmd>
            <info>
               <p>The <b>Health</b>
                  <b>Data Downloading</b> window is displayed.</p>
               <fig>
                  <title>Health Data Downloading window</title>
                  <image height="195" href="../media/image60.png" placement="break" width="362">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Confirm the date range, and the selected component(s) or modify these details, as required.</cmd>
         </step>
         <step>
            <cmd>Specify a file name.</cmd>
         </step>
         <step>
            <cmd>Click GO.</cmd>
         </step>
      </steps>
      <result>
         <p>The data is downloaded to the specified file on your computer.</p>
      </result>
   </taskbody>
</task>
