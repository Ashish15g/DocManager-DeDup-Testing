<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 2.x Concept//EN" "concept.dtd">
<concept id="on_the_sms_web_application" xml:lang="en-us">
   <title>On the SMS web application</title>
   <shortdesc>To access the graph view:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>application</keyword>
        <keyword>chart</keyword>
        <keyword>location</keyword>
        <keyword>plant</keyword>
        <keyword>access</keyword>
        <keyword>graph</keyword>
        <indexterm>application</indexterm>
        <indexterm>chart</indexterm>
        <indexterm>location</indexterm>
        <indexterm>result</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody><p>To access the graph view:</p>
    <ol>
    <li>Log in to the SMS web application.</li>
    </ol>
    <section>
      <title>Result</title>
      <p>The Dashboard page with the <b>Graph</b> view is displayed by default.</p>
         <note type="note">Note: The chart changes based on the selection on the left navigation pane. If a particular location or plant is selected, the chart displays the health condition of motors of only that location or plant.</note>
    </section></conbody>
</concept>
