<!DOCTYPE task
  PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="motor_operating_hours" xml:lang="en-us">
   <title>On the SMS web application</title>
   <shortdesc>To view the operating hours and the number of starts:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>Select</keyword>
        <keyword>motor</keyword>
        <keyword>calendar</keyword>
        <keyword>range</keyword>
        <keyword>application</keyword>
        <indexterm>placeholder</indexterm>
        <indexterm>Select</indexterm>
        <indexterm>motor</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To view the operating hours and the number of starts:</p>
      </context>
      <steps id="steps_10314135">
         <step>
            <cmd>Log in to the web application.</cmd>
         </step>
         <step>
            <cmd>Select a motor on the <xref href="../dashboard/search_for_a_motor.dita" format="dita">left navigation pane</xref> or on the <xref href="../dashboard/monitor_motor_condition_list_view.dita" format="dita">List view</xref> to display the <xref href="../dashboard/view_motor_details.dita" format="dita">motor’s information page</xref>.</cmd>
         </step>
         <step>
            <cmd>Select the Parameters tab.</cmd>
         </step>
         <step>
            <cmd>Click the calendar <image height="26" href="../media/image36.png" placement="break" width="22">
                  <alt>placeholder</alt>
               </image> icon next to Operation Hours to choose the time range.</cmd>
            <info>
               <p>A calendar view is displayed.</p>
               <fig>
                  <title>Operation Hours - Calendar View</title>
                  <image height="251" href="../media/image37.png" placement="break" width="537">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Select the required months and dates.</cmd>
         </step>
         <step>
            <cmd>Click Applyto view the number of hours the motor has been operating in the specified time range.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="258" href="../media/image38.png" placement="break" width="421">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Operation Hours - Result</p>
            </info>
         </step>
         <step>
            <cmd>Similarly, click the calendar <image height="26" href="../media/image36.png" placement="break" width="22">
                  <alt>placeholder</alt>
               </image> icon next to Number of Starts to choose the time range.</cmd>
            <info>
               <p>A calendar view is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="315" href="../media/image39.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Number of Starts - Calendar View</p>
            </info>
         </step>
         <step>
            <cmd>Select the required months and dates.</cmd>
         </step>
         <step>
            <cmd>Click Apply to view how many times the motor has started in the specified time range.</cmd>
         </step>
      </steps>
      <result>
         <p>
            <fig>
               <title>placeholder</title>
               <image height="147" href="../media/image40.png" placement="break" width="602">
                  <alt>placeholder</alt>
               </image>
            </fig>
         </p>
         <p>Figure  Number of Starts - Results</p>
      </result>
   </taskbody>
</task>
