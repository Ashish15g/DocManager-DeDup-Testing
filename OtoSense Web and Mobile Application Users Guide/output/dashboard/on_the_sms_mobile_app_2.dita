<concept id="_On_the_SMS" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To access the list view:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>mobile</keyword>
        <keyword>displayed</keyword>
        <keyword>List</keyword>
        <keyword>motor</keyword>
        <keyword>placeholder</keyword>
        <keyword>access</keyword>
        <indexterm>mobile</indexterm>
        <indexterm>displayed</indexterm>
        <indexterm>List</indexterm>
        <indexterm>result</indexterm>
      </keywords>
      <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody><p>To access the list view:</p>
    <ol>
    <li><p>Log in to the SMS mobile application.</p>
      <p>The <b>Dashboard</b> page is displayed.</p></li>
    <li><p>Tap List.</p>
      <p>The list of motors added to your account is displayed in alphabetical order.</p></li>
    <li>Tap a specific motor to navigate to the <xref href="../dashboard/view_motor_details.dita" format="dita">motor’s information page</xref>.</li>
    </ol>
    <section>
      <title>Result</title>
