<task id="on_the_sms_mobile_app_6" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To view parameter data:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>mobile</keyword>
        <keyword>placeholder</keyword>
        <keyword>parameter</keyword>
        <keyword>displayed</keyword>
        <keyword>corresponding</keyword>
        <keyword>motor</keyword>
        <indexterm>mobile</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>parameter</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To view parameter data:</p>
      </context>
      <steps id="steps_10314153">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Motors on the bottom menu.</cmd>
            <info>
               <p>The <b>Locations</b> list is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select the corresponding location associated with the motor.</cmd>
         </step>
         <step>
            <cmd>From the subsequent screens, select the corresponding plant, process, and motor name.</cmd>
            <info>
               <p>The motor’s information page is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Tap History Plot and then tap Parameters below it.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image49.png" placement="break" width="254">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Parameters sub-tab on the SMS mobile app</p>
            </info>
         </step>
         <step>
            <cmd>Tap SELECT VIBRATION to select a parameter and tap DONE.</cmd>
         </step>
         <step>
            <cmd>Tap SELECT DATE and SELECT TIME to select the date and time range of the parameter data that you require.</cmd>
            <info>
               <p>The corresponding waveform is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="559" href="../media/image50.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Parameters sub-tab - Waveform</p>
            </info>
         </step>
         <step>
            <cmd>Stretch an area of the plot (using two fingers) to zoom in on a specific date or time period. To zoom out, tap Reset zoom.</cmd>
         </step>
         <step>
            <cmd>Tap a specific dot on the plot to view exact readings.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
