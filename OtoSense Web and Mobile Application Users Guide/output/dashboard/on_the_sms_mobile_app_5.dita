<task id="on_the_sms_mobile_app_5" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To view the operating hours and the number of starts:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>displayed</keyword>
        <keyword>placeholder</keyword>
        <keyword>Select</keyword>
        <keyword>motor</keyword>
        <keyword>mobile</keyword>
        <keyword>range</keyword>
        <indexterm>displayed</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>Select</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To view the operating hours and the number of starts:</p>
      </context>
      <steps id="steps_10314139">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Motors on the bottom menu.</cmd>
            <info>
               <p>The <b>Locations</b> list is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select the corresponding location associated with the motor.</cmd>
         </step>
         <step>
            <cmd>From the subsequent screens, select the corresponding plant, process, and motor name.</cmd>
            <info>
               <p>The motor’s information page is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Tap Parameters.</cmd>
         </step>
         <step>
            <cmd>Click the Edit <image height="22" href="../media/image41.jpg" placement="break" width="20">
                  <alt>placeholder</alt>
               </image> icon next to OP. HOURS to choose the time range.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image42.png" placement="break" width="253">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Parameters tab on the SMS mobile app</p>
               <p>A calendar is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select a start date and tap NEXT.</cmd>
         </step>
         <step>
            <cmd>Select an end date and tap APPLY.</cmd>
            <info>
               <p>The number of hours the motor has been operating in the specified time range is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Similarly, click the Edit <image height="22" href="../media/image41.jpg" placement="break" width="20">
                  <alt>placeholder</alt>
               </image>  icon next to Number of Starts to choose the time range.</cmd>
            <info>
               <p>A calendar is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select a start date and tap NEXT.</cmd>
         </step>
         <step>
            <cmd>Select an end date and tap APPLY.</cmd>
         </step>
      </steps>
      <result>
         <p>
            <fig>
               <title>placeholder</title>
               <image height="576" href="../media/image43.png" placement="break" width="602">
                  <alt>placeholder</alt>
               </image>
            </fig>
         </p>
         <p>Figure  Operation Hours and Number of Starts - Calendar</p>
         <p>The number of times the motor has started in the specified time range is displayed.</p>
      </result>
   </taskbody>
</task>
