   <taskbody>
      <context>
         <p>To view status of motor components / faults:</p>
      </context>
      <steps id="steps_10314129">
         <step>
            <cmd>Log in to the SMS web application.</cmd>
         </step>
         <step>
            <cmd>Select a motor on the <xref href="../dashboard/search_for_a_motor.dita" format="dita">left navigation pane</xref> or on the <xref href="../dashboard/monitor_motor_condition_list_view.dita" format="dita">List view</xref> to display the motor’s information page.</cmd>
            <info>
               <note type="note">Note: The <b>Motor</b>
                  <b>s</b>
                  <b>tatus</b> tab is displayed by default.</note>
               <note type="note">
                  <fig>
                     <title>placeholder</title>
                     <image height="513" href="../media/image33.png" placement="break" width="602">
                        <alt>placeholder</alt>
                     </image>
                  </fig>
               </note>
               <p>Figure  Motor Status tab with status indicators and health index information</p>
            </info>
         </step>
         <step>
            <cmd>Scroll down to view all the items and monitor their status.</cmd>
         </step>
      </steps>
   </taskbody>
