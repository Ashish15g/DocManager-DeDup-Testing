<task id="on_the_sms_mobile_app_7" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To view motor performance data:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>mobile</keyword>
        <keyword>motor</keyword>
        <keyword>Performance</keyword>
        <keyword>displayed</keyword>
        <keyword>select</keyword>
        <indexterm>placeholder</indexterm>
        <indexterm>mobile</indexterm>
        <indexterm>motor</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To view motor performance data:</p>
      </context>
      <steps id="steps_10314163">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Motors on the bottom menu.</cmd>
            <info>
               <p>The <b>Locations</b> list is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Select the corresponding location associated with the motor.</cmd>
         </step>
         <step>
            <cmd>From the subsequent screens, select the corresponding plant, process, and motor name.</cmd>
            <info>
               <p>The motor’s information page is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Tap History Plot and then tap Performance below it.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image54.jpg" placement="break" width="255">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Performance sub-tab on the SMS mobile app</p>
            </info>
         </step>
         <step>
            <cmd>Tap SELECT to select one or two functions from the list and tap DONE.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image55.png" placement="break" width="253">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Performance sub-tab - Filters</p>
               <note type="note">Note: You can select a maximum of two functions to be visualized at any given time.</note>
               <p>The plot of the selected functions with the data for the last 15 days is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="564" href="../media/image56.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Performance data plot and performance data - zoomed in</p>
            </info>
         </step>
         <step>
            <cmd>Stretch an area of the plot (using two fingers) to zoom in on a specific date or time period. To zoom out, tap Reset zoom.</cmd>
         </step>
         <step>
            <cmd>Tap a specific dot on the plot to view exact readings.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
