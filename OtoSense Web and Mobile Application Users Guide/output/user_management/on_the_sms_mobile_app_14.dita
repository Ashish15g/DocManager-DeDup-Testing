<concept id="on_the_sms_mobile_app_14" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>The Settings page is displayed.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>mobile</keyword>
        <keyword>placeholder</keyword>
        <keyword>Notifications</keyword>
        <keyword>Settings</keyword>
        <keyword>displayed</keyword>
        <keyword>application</keyword>
        <indexterm>mobile</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>Notifications</indexterm>
        <indexterm>result</indexterm>
      </keywords>
      <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <conbody>    <ol>
    <li>Log in to the SMS mobile application.</li>
    <li><p>Tap Settings on the bottom menu.</p>
      <p>The <b>Settings</b> page is displayed.</p>
               <fig>
                  <title>Image115</title>
                  <image height="501" href="../media/image115.png" placement="break" width="257">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Settings - Notifications option</p></li>
    <li><p>Tap Notifications.</p>
      <p>The <b>Notifications</b> page is displayed.</p>
               <fig>
                  <title>Image116</title>
                  <image height="587" href="../media/image116.png" placement="break" width="252">
                     <alt>placeholder</alt>
                  </image>
               </fig></li>
    <li>Tap the slider <image height="30" href="../media/image113.png" placement="break" width="41">
                  <alt>placeholder</alt>
               </image> icon next to the respective settings to enable notifications.</li>
    </ol>
    <section>
      <title>Result</title>
      <p>The icon changes to blue.</p>
    </section></conbody>
</concept>