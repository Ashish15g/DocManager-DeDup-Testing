<task id="on_the_sms_web_application_15" xml:lang="en-us">
   <title>On the SMS web application</title>
   <shortdesc>To enable email and mobile notifications:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>application</keyword>
        <keyword>Notifications</keyword>
        <keyword>enable</keyword>
        <keyword>notifications</keyword>
        <keyword>click</keyword>
        <indexterm>placeholder</indexterm>
        <indexterm>application</indexterm>
        <indexterm>Notifications</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To enable email and mobile notifications:</p>
      </context>
      <steps id="steps_103141159">
         <step>
            <cmd>Log in to the SMS web application.</cmd>
         </step>
         <step>
            <cmd>On the top right of the user interface, click the <image height="14" href="../media/image20.png" placement="break" width="18">
                  <alt>placeholder</alt>
               </image> arrow next to your name and click Notifications.</cmd>
            <info>
               <p>The <b>Notifications</b> page is displayed.</p>
               <fig>
                  <title>Notifications option</title>
                  <image height="188" href="../media/image112.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click the slider <image height="30" href="../media/image113.png" placement="break" width="42">
                  <alt>placeholder</alt>
               </image> icon next to the respective setting to enable notifications.</cmd>
            <info>
               <p>It changes to blue.</p>
               <fig>
                  <title>Notification settings window</title>
                  <image height="521" href="../media/image114.png" placement="break" width="455">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>Click SAVE CHANGES.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
