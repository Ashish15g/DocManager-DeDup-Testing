<task id="on_the_sms_mobile_app_13" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To change the preferred unit of measurement:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>placeholder</keyword>
        <keyword>mobile</keyword>
        <keyword>Select</keyword>
        <keyword>application</keyword>
        <keyword>change</keyword>
        <keyword>Settings</keyword>
        <indexterm>placeholder</indexterm>
        <indexterm>mobile</indexterm>
        <indexterm>Select</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <note type="note">Note: Your name and password can only be changed on the SMS web application. For instructions, see <xref href="#change_user_settings">To change user settings</xref>.</note>
         <p>To change the preferred unit of measurement:</p>
      </context>
      <steps id="steps_103141156">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Settings on the bottom menu.</cmd>
         </step>
         <step>
            <cmd>Tap User Preference.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image110.jpg" placement="break" width="253">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Settings - User preference option</p>
            </info>
         </step>
         <step>
            <cmd>Tap Select unit.</cmd>
            <info>
               <p>A pop-up window is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image111.jpg" placement="break" width="255">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Select unit option</p>
            </info>
         </step>
         <step>
            <cmd>Select the required unit and tap UPDATE PREFERENCE.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
