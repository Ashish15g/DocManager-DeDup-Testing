      <context>
         <p>To change the interface language:</p>
      </context>
      <steps id="steps_103141166">
         <step>
            <cmd>Log in to the SMS web application.</cmd>
         </step>
         <step>
            <cmd>On the top right of the user interface, click the <image height="14" href="../media/image20.png" placement="break" width="18">
                  <alt>placeholder</alt>
               </image> arrow next to the option EN.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="167" href="../media/image117.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Language options</p>
            </info>
         </step>
         <step>
            <cmd>Select the required option to change the language.</cmd>
         </step>
      </steps>
