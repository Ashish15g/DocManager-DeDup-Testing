<task id="_To_change_user" xml:lang="en-us">
   <title>On the SMS web application</title>
   <shortdesc>To change user settings:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>click</keyword>
        <keyword>profile</keyword>
        <keyword>application</keyword>
        <keyword>change</keyword>
        <keyword>placeholder</keyword>
        <keyword>UPDATE</keyword>
        <indexterm>click</indexterm>
        <indexterm>profile</indexterm>
        <indexterm>application</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To change user settings:</p>
      </context>
      <steps id="steps_103141153">
         <step>
            <cmd>Log in to the SMS web application.</cmd>
         </step>
         <step>
            <cmd>On the top right of the user interface, click the <image height="14" href="../media/image20.png" placement="break" width="18">
                  <alt>placeholder</alt>
               </image> arrow next to your name and click My profile.</cmd>
            <info>
               <fig>
                  <title>My profile option</title>
                  <image height="187" href="../media/image108.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>The <b>My profile</b> page is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>To update your first name or last name, type your name in the First name or Last name field and click UPDATE DETAILS.</cmd>
            <info>
               <fig>
                  <title>My profile page</title>
                  <image height="415" href="../media/image109.png" placement="break" width="602">
                     <alt>placeholder</alt>
                  </image>
               </fig>
            </info>
         </step>
         <step>
            <cmd>To change your password, type the current password and a new password in their respective fields. Click UPDATE PASSWORD.</cmd>
         </step>
         <step>
            <cmd>To change the preferred unit of measurement, click the Select unit drop-down list and select the preferred unit of measurement. Click UPDATE PREFERENCE.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
