<task id="on_the_sms_mobile_app_11" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>To edit a report:</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>report</keyword>
        <keyword>placeholder</keyword>
        <keyword>mobile</keyword>
        <keyword>Reports</keyword>
        <keyword>displayed</keyword>
        <keyword>Edit</keyword>
        <indexterm>report</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>mobile</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <context>
         <p>To edit a report:</p>
      </context>
      <steps id="steps_103141114">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Reports on the bottom menu.</cmd>
            <info>
               <p>The <b>Reports</b> page with a list of previously generated reports is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Tap the report that you want to edit.</cmd>
         </step>
         <step>
            <cmd>Tap EDIT REPORT on the top right of the page.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image81.png" placement="break" width="257">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Edit Report button</p>
               <p>The <b>Edit report</b> page is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="539" href="../media/image82.png" placement="break" width="235">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Edit report page</p>
            </info>
         </step>
         <step>
            <cmd>Change the following details, as required:</cmd>
            <info>
               <ul id="ul_103141113">
                  <li>Report name</li>
                  <li>Schedule</li>
                  <li>Location</li>
                  <li>Plant</li>
                  <li>Process</li>
                  <li>Motor</li>
               </ul>
            </info>
         </step>
         <step>
            <cmd>Click SAVE REPORT.</cmd>
            <info>
               <p>A modified report is generated on the scheduled day.</p>
               <p>To delete a report:</p>
            </info>
         </step>
         <step>
            <cmd>Find the report from the list and swipe left.</cmd>
            <info>
               <p>A confirmation message is displayed.</p>
            </info>
         </step>
         <step>
            <cmd>Click DELETE.</cmd>
         </step>
      </steps>
      <result>
         <p>The report is deleted from the Reports page.</p>
      </result>
   </taskbody>
</task>
