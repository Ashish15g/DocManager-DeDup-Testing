<!DOCTYPE task
  PUBLIC "-//OASIS//DTD DITA 2.x Task//EN" "task.dtd">
<task id="on_the_sms_mobile_app_9" xml:lang="en-us">
   <title>On the SMS mobile app</title>
   <shortdesc>Figure Create Report button</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <keyword>report</keyword>
        <keyword>placeholder</keyword>
        <keyword>mobile</keyword>
        <keyword>Create</keyword>
        <keyword>Report</keyword>
        <keyword>Select</keyword>
        <indexterm>report</indexterm>
        <indexterm>placeholder</indexterm>
        <indexterm>mobile</indexterm>
      </keywords>
      <prodinfo>
        <prodname></prodname>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps id="steps_10314197">
         <step>
            <cmd>Log in to the SMS mobile application.</cmd>
         </step>
         <step>
            <cmd>Tap Reports on the bottom menu.</cmd>
         </step>
         <step>
            <cmd>Tap CREATE REPORT on the top right of the page.</cmd>
            <info>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image70.jpg" placement="break" width="256">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Create Report button</p>
               <p>The <b>Create report</b> page is displayed.</p>
               <fig>
                  <title>placeholder</title>
                  <image height="501" href="../media/image71.png" placement="break" width="219">
                     <alt>placeholder</alt>
                  </image>
               </fig>
               <p>Figure  Create Report page</p>
            </info>
         </step>
         <step>
            <cmd>Enter the following details to create a new report.</cmd>
            <info>
               <table colsep="1" frame="all" rowsep="1">
                  <tgroup cols="2">
                     <colspec colname="c1"/>
                     <colspec colname="c2"/>
                     <tbody>
                        <row>
                           <entry>
                              <b>Field</b>
                           </entry>
                           <entry>
                              <b>Description</b>
                           </entry>
                        </row>
                        <row>
                           <entry>Report name</entry>
                           <entry>Enter a name for the report.</entry>
                        </row>
                        <row>
                           <entry>Schedule</entry>
                           <entry>Select one or more days of the week when you want to receive the report. Note: The report will be sent at 8 AM GMT on the selected day(s) every week.</entry>
                        </row>
                        <row>
                           <entry>Location, Plant, Process</entry>
                           <entry>Select the motor’s location, plant, and process from the respective fields.</entry>
                        </row>
                        <row>
                           <entry>Motor</entry>
                           <entry>Select a specific motor or select All from the Motor drop-down list if you want to generate a report about all the motors belonging to a process.</entry>
                        </row>
                     </tbody>
                  </tgroup>
               </table>
               <p>Table  Details to be added to create a report</p>
            </info>
         </step>
         <step>
            <cmd>Tap CREATE REPORT.</cmd>
         </step>
      </steps>
      <result>
         <p>The new report will be added to the list on the Reports page with a ‘Pending’ status.</p>
         <note type="note">Note: You will not be able to view the report until the scheduled day of the report.</note>
      </result>
   </taskbody>
</task>
