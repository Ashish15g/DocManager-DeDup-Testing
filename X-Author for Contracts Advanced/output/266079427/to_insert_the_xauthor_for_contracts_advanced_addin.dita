<task id="to_insert_the_xauthor_for_contracts_advanced_addin_b292e3" xml:lang="en-us">
   <title>To insert the X-Author for Contracts Advanced add-in</title>
   <shortdesc>In the Home tab of Microsoft Word, you can see the X-Author Contracts ribbon.</shortdesc>
   <prolog>
      <author type="creator">Jessica Halbhuber</author>
      <critdates>
         <created date="Sep 26, 2024"/>
      </critdates>
       <metadata>
      <keywords>
        <keyword>Author</keyword>
        <keyword>Contracts</keyword>
        <keyword>Advanced</keyword>
        <keyword>insert</keyword>
        <keyword>Microsoft</keyword>
        <keyword>Word</keyword>
        <indexterm>Author</indexterm>
        <indexterm>Contracts</indexterm>
        <indexterm>Advanced</indexterm>
      </keywords>
          <prodinfo>
        <prodname/>
      </prodinfo>
    </metadata>
  </prolog>
   <taskbody>
      <steps>
         <step>
            <cmd>Open and sign in to Microsoft Word.</cmd>
         </step>
         <step>
            <cmd>Select the Insert tab and click <b>My Add-ins</b>.</cmd>
         </step>
         <step>
            <cmd>Select the Admin Managed tab.</cmd>
         </step>
         <step>
            <cmd>In the Admin Managed tab, select the X-Author Contracts Advanced add-in. If you can't see the add-in, click <b>Refresh</b>. </cmd>
         </step>
         <step>
            <cmd>Click <b>Add</b>.</cmd>
         </step>
      </steps>
      <result>
         <p>In the Home tab of Microsoft Word, you can see the X-Author Contracts ribbon.</p>
      </result>
   </taskbody>
</task>