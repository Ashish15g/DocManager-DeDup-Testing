<reference id="using_the_document_panel_2475b7" xml:lang="en-us">
   <title>Using the Document Panel</title>
     <shortdesc>The Document panel allows you to view all clauses and fields in your agreement document</shortdesc>
   <prolog>
      <author type="creator">Chris Castro</author>
      <critdates>
         <revised modified="Oct 07, 2016"/>
      </critdates>
       <metadata>
