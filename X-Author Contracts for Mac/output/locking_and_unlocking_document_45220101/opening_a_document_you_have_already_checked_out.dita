<task id="opening_a_document_you_have_already_checked_out_8f08a9" xml:lang="en-us">
   <title>Opening a Document You Have Already Checked Out</title>
     <shortdesc>In some situations, you may close an open document in X-Author which you have checked</shortdesc>
   <prolog>
      <author type="creator">Chris Castro</author>
      <critdates>
