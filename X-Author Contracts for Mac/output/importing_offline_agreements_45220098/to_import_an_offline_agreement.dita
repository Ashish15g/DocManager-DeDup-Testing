<task id="to_import_an_offline_agreement_21d93a" xml:lang="en-us">
   <title>To import an offline agreement</title>
   <shortdesc>Open the document in Microsoft Word.</shortdesc>
   <prolog>
      <author type="creator">Chris Castro</author>
      <critdates>
         <revised modified="Sep 27, 2016"/>
      </critdates>
